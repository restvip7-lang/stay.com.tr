<Base system="new" title={meta.title} description={meta.description} canonical={self} robots={robots} alternates={alternates} image={ogImage} overlayHeader jsonLd={ld}>
  <section class="panel-b pb-8 lg:pb-10">
    <div class="relative isolate overflow-hidden rounded-b-[24px] bg-ink text-white lg:rounded-b-[var(--radius-panel)]">
      <Img src={hero} alt={`${c.title} — ${place}`} class="absolute inset-0 -z-10 size-full" priority sizes="100vw" width={1920} height={1080} />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/50 via-ink/10 to-ink/75"></div>
      <div class="container-n relative flex min-h-[520px] flex-col justify-end pb-8 pt-32 lg:min-h-[520px] lg:pb-10">
        {/* Справа — карточка акции (как у образца); нет акции — карточки нет. */}
        {promos[0] && (
          <div class="absolute right-5 top-32 hidden w-[300px] overflow-hidden rounded-[20px] bg-white text-ink-n shadow-[0_8px_30px_rgba(9,7,20,.18)] lg:right-10 lg:block">
            <div class="relative h-[120px]"><Img src={promoImg(0)} alt="" class="size-full" width={600} height={240} /><span class="absolute left-3 top-3 inline-flex rounded-[6px] bg-accent px-2 py-0.5 text-[11px] font-medium uppercase tracking-[1px] text-white">{N.promoBadge}{promos[0].demo && ` · ${N.example}`}</span></div>
            <div class="p-4">
              <p class="text-[16px] leading-[21px]">{promos[0].title}</p>
              {promos[0].until && <p class="mt-1 text-[13px] text-soft">{promos[0].until}</p>}
              <a href="#promo" class="mt-3 inline-flex items-center gap-1.5 text-[14px] font-medium text-accent">{N.learnMore}<Icon name="arrowRight" class="size-4" /></a>
            </div>
          </div>
        )}
        {/* На экране крупно — название ЖК (как у образца); SEO-заголовок H1 остаётся строкой над ним (решение Anuar 28.11.2026). */}
        <h1 class="max-w-4xl text-[13px] font-medium uppercase leading-[18px] tracking-[1px] text-white/80">{meta.h1}</h1>
        <p class="display mt-2 max-w-4xl text-[44px] leading-[48px] text-white sm:text-[60px] sm:leading-[64px] lg:text-[76px] lg:leading-[80px]">{c.title}</p>
        {subtitle && <p class="mt-3 max-w-2xl text-[17px] leading-[24px] text-white/90 lg:text-[20px] lg:leading-[28px]">{subtitle}</p>}
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[14px] leading-[20px] text-white/90">
          {seaText && <span class="inline-flex items-center gap-1.5"><Icon name="wave" class="size-4" />{seaText} {N.toSea}</span>}
          {seaText && <span aria-hidden="true">·</span>}
          <span class="inline-flex items-center gap-1.5">{!seaText && <Icon name="pin" class="size-4" />}{place}</span>
        </p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {picker || ours ? <a href="#genplan" class="btn-n btn-n-accent max-sm:w-full">{tb.choose}</a> : <a href="#lead" class="btn-n btn-n-accent max-sm:w-full">{tc.getPrice}</a>}
          {picker && <a href="#lead" class="btn-n btn-n-glass max-sm:w-full">{tc.getPrice}</a>}
          {!picker && ours && <a href="#viewing" class="btn-n btn-n-glass gap-2 max-sm:w-full"><Icon name="phone" class="size-4" />{tb.orderCall}</a>}
        </div>
      </div>
    </div>

    <div class="container-n">
      <div class="pt-5"><Breadcrumbs items={crumbs} /></div>
      {/* Строка фактов как у образца — четыре ячейки: цена от и за м², площади, срок сдачи, адрес с картой. Пустая ячейка не показывается. */}
      {(low || areaMin || buildEnd || place) && (
        <dl class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {low && <div class="fact"><span class="fact-i"><Icon name="tag" class="size-5" /></span><div><dt>{tc.priceRange}</dt><dd>{d.from(moneyL(lang, low))}{perM2 && <span class="fact-sub">{`${moneyL(lang, perM2)}/${N.perM2}`}</span>}</dd></div></div>}
          {areaMin && <div class="fact"><span class="fact-i"><Icon name="layout" class="size-5" /></span><div><dt>{N.area}</dt><dd>{areaMax && areaMax > areaMin ? `${numL(lang, areaMin)}–${numL(lang, areaMax)} ${d.m2}` : `${numL(lang, areaMin)} ${d.m2}`}</dd></div></div>}
          {buildEnd && <div class="fact"><span class="fact-i"><Icon name="calendar" class="size-5" /></span><div><dt>{tc.deadline}</dt><dd>{buildEnd}</dd></div></div>}
          <div class="fact"><a href="#viewing" class="fact-i fact-dark" aria-label={N.onMap}><Icon name="pin" class="size-5" /></a><div><dt>{N.address}</dt><dd>{place}{district && <a href={catUrl(lang, geoCat, { complexes: true })} class="fact-chip">{district.name[lang]}</a>}</dd></div></div>
        </dl>
      )}

      {flatGroups.length > 0 ? (
        <div id="choose" class="relative mt-8 scroll-mt-28 lg:mt-10" data-car>
          <h2 class="sr-only">{tb.flats}</h2>
          <ul class="scroll-x -mx-5 flex snap-x scroll-px-5 gap-4 px-5 lg:mx-0 lg:scroll-px-0 lg:px-0" data-car-track>
            {flatGroups.map((g) => {
              const inner = (
                <>
                  <span class="text-[16px] leading-[22px] tracking-[.2px] text-ink-n">{g.title}</span>
                  {g.area && <span class="text-[14px] leading-[19px] text-ink-n">{d.from(`${numL(lang, g.area)} ${d.m2}`)}</span>}
                  <span class="text-[14px] leading-[19px] text-soft">{g.price ? d.from(moneyL(lang, g.price)) : d.priceOnRequest}</span>
                  <span class="relative mt-3 grid aspect-[4/3] place-items-center overflow-hidden rounded-[12px] bg-white">{g.image ? <Img src={g.image} alt="" class="size-full object-contain" width={480} height={360} /> : <Icon name="building" class="size-8 text-soft" />}<span class="absolute bottom-2 left-2 rounded-full bg-white px-2.5 py-1 text-[11px] font-medium uppercase leading-[14px] tracking-[.6px] text-ink-n shadow-[0_1px_4px_rgba(9,7,20,.08)]">{g.count}</span><span class="absolute bottom-2 right-2 grid size-12 place-items-center rounded-[14px] bg-white text-ink-n shadow-[0_2px_10px_rgba(9,7,20,.10)] transition-opacity lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-visible:opacity-100" aria-hidden="true"><Icon name="chevronRight" class="size-4" /></span></span>
                </>
              );
              return (
                <li class="w-[248px] shrink-0 snap-start lg:w-[calc((100%-48px)/4)]">
                  {g.href
                    ? <a href={g.href} class="tile-n group flex h-full flex-col gap-1 p-4 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-card)]">{inner}</a>
                    : <button type="button" class="tile-n group flex h-full w-full flex-col gap-1 p-4 text-left transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-card)]" data-grp={g.id} aria-haspopup="dialog">{inner}</button>}
                </li>
              );
            })}
          </ul>
          {flatGroups.length > 4 && <button type="button" class="car-btn absolute -right-5 top-1/2 hidden -translate-y-1/2 lg:grid" data-car-next aria-label={tb.next}><Icon name="chevronRight" class="size-4" /></button>}
          {flatGroups.filter((g) => !g.href).map((g) => (
            <dialog id={g.id} class="grp-dlg m-auto w-[min(640px,calc(100%-32px))] rounded-[24px] bg-white p-0 text-ink-n backdrop:bg-black/50" aria-label={g.title}>
              <div class="flex items-start justify-between gap-4 border-b border-line px-5 py-4 lg:px-6">
                <div>
                  <p class="display text-[22px] leading-[28px]">{g.title}</p>
                  <p class="mt-1 text-[14px] text-soft">{c.title} · {g.count}</p>
                </div>
                <button type="button" class="grid size-9 shrink-0 place-items-center rounded-full bg-page" data-grp-close aria-label={d.close}><Icon name="close" class="size-4" /></button>
              </div>
              <ul class="max-h-[65vh] overflow-y-auto px-2 py-2 lg:px-3">
                {g.items.map((x) => (
                  <li>
                    <a href={itemUrl(lang, x)} class="flex items-center gap-4 rounded-[14px] px-3 py-3 transition-colors hover:bg-page">
                      <span class="grid size-16 shrink-0 place-items-center overflow-hidden rounded-[10px] bg-page">{x.image ? <Img src={x.image} alt="" class="size-full object-contain" width={128} height={128} /> : <Icon name="building" class="size-5 text-soft" />}</span>
                      <span class="min-w-0 flex-1">
                        <span class="block text-[15px] leading-[20px]">{TYPE_WORDS[lang][x.type].one} {x.rooms}{x.area ? `, ${numL(lang, x.area)} ${d.m2}` : ''}</span>
