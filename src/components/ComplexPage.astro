            <path d="M10 46h210M10 62h140M10 46l16 16M42 46l16 16M74 46l16 16M106 46l16 16M26 62l16-16M58 62l16-16M90 62l16-16M122 62l16-16M160 10v36M160 10 30 46M160 10l60 36"/>
            <rect x="136" y="62" width="28" height="30" rx="3" fill="#fff"/>
            <path d="M60 62v80M50 142h20v8H50zM60 150v14" /><path d="M54 170a6 6 0 1 0 12 0" />
          </svg>
          <a href={liveHref} target={liveUrl ? '_blank' : undefined} rel="noopener" class="tile-btn" aria-label={tb.tiles.live}><Icon name="arrowUpRight" class="size-4" /></a>
        </li>}
        {presHref && <li class="tile-sq bg-white">
          <p class="text-[20px] leading-[26px] text-ink-n">{tb.tiles.pres}</p>
          <p class="mt-1.5 max-w-[260px] text-[15px] leading-[21px] text-soft">{tb.tiles.presText}</p>
          <a href={presHref} target={pres ? '_blank' : undefined} rel="noopener" download={pres ? '' : undefined} class="tile-btn" aria-label={tb.tiles.pres}><Icon name="download" class="size-4" /></a>
        </li>}
        {docs.length > 0 && <li class="tile-sq bg-accent text-white">
          <p class="text-[20px] leading-[26px]">{tb.tiles.mats}</p>
          <p class="mt-1.5 max-w-[260px] text-[15px] leading-[21px] text-white/85">{tb.tiles.matsText}</p>
          <a href="#docs" class="tile-btn" aria-label={tb.tiles.mats}><Icon name="arrowUpRight" class="size-4" /></a>
        </li>}
      </ul>
      </>)}
    </div>
  </section>

  {photoList.length > 2 && (
    <section class="mt-20 lg:mt-28" data-gal2 aria-labelledby="gal2-h">
      {/* Галерея как у образца (ЖК МИРА, Anuar 28.11.2026): одна карусель, фото идут по категориям; вкладка переносит к первому
          фото категории и подсвечивается сама при листании. На каждом фото — «01 / 06» внутри категории и кнопка «на весь экран». */}
      <div class="container-n mb-6 flex flex-wrap items-center justify-between gap-4 lg:mb-8">
        <h2 id="gal2-h" class="display h-section-n">{GAL.title[lang]}</h2>
        {galGroups.length > 1 && (
          <div class="seg max-w-full scroll-x" role="tablist">
            {galGroups.map((gr, gi) => <button type="button" role="tab" aria-selected={gi === 0 ? 'true' : 'false'} data-gal2-tab={gi}>{gr.label}</button>)}
          </div>
        )}
      </div>
      <div class="relative">
        <div class="gal2-track scroll-x flex snap-x snap-mandatory gap-3 lg:gap-6" data-gal2-track>
          {galGroups.flatMap((gr, gi) => gr.items.map((src, k) => (
