interface Props { c: Complex }
// Тексты блоков, добавленных по плану страницы ЖК (28.11.2026).
const NTen = {
  km: 'km', toSea: 'to the sea', perM2: 'm²', area: 'Area', address: 'Address', onMap: 'On the map', tour: '3D tour', example: 'Example', learnMore: 'Learn more', promoBadge: 'Offer',
  until: (d: string) => `until ${d}`, readMore: 'Read more', liveBtn: 'Live camera', liveOpen: 'Watch the live camera', video: 'Video', photos: 'Photos', live: 'Live', liveTab: 'Live stream', liveSoon: 'The staff member adds the camera link in the admin panel.',
  installment: (dn: number | null, m: number | null) => [dn != null ? `Down payment from ${dn}%` : '', m ? `up to ${m} months` : ''].filter(Boolean).join(', '),
  mortgage: (dn: number, y: number) => `We will help you get a mortgage from a Turkish bank: down payment from ${dn}%, term up to ${y} years. For completed properties; the manager will calculate the exact terms.`,
  docTabs: { pres: 'Presentation', plans: 'Floor plans', docs: 'Documents' },
  demoPromo: '5% off with 100% payment', demoPromoText: 'Example offer: the staff member adds real offers in the admin panel.', demoProgress: 'Example caption: frame of the 5th floor completed.', demoNews: 'Example news: the text and photos are added by the staff member in the admin panel.',
  office: 'Stay Property office in Alanya', hours: 'Opening hours', hoursText: 'Daily, 9:00–19:00', write: 'Write to WhatsApp',
};
const NT: Record<string, typeof NTen> = {
  ru: {
    km: 'км', toSea: 'до моря', perM2: 'м²', area: 'Площадь', address: 'Адрес', onMap: 'На карте', tour: '3D-тур', example: 'Пример', learnMore: 'Узнать больше', promoBadge: 'Акция',
    until: (d) => `до ${d}`, readMore: 'Читать полностью', liveBtn: 'Live-камера', liveOpen: 'Смотреть Live-камеру', video: 'Видео', photos: 'Фото', liveTab: 'Онлайн-трансляция', liveSoon: 'Ссылку на камеру сотрудник добавит в админке.', live: 'Live',
    installment: (dn, m) => [dn != null ? `Первый взнос от ${dn}%` : '', m ? `рассрочка до ${m} мес.` : ''].filter(Boolean).join(', '),
    mortgage: (dn, y) => `Поможем оформить ипотеку в турецком банке: первый взнос от ${dn}%, срок до ${y} лет. Для сданных объектов; точные условия рассчитает менеджер.`,
    docTabs: { pres: 'Презентация', plans: 'Планировки', docs: 'Документы' },
    demoPromo: 'Скидка 5% при 100% оплате', demoPromoText: 'Пример акции: настоящие акции сотрудник добавит в админке.', demoProgress: 'Пример подписи: завершён каркас 5-го этажа.', demoNews: 'Пример новости: текст и фото сотрудник добавит в админке.',
    office: 'Офис Stay Property в Аланье', hours: 'Часы работы', hoursText: 'Ежедневно, 9:00–19:00', write: 'Написать в WhatsApp',
  },
  en: NTen,
  tr: { ...NTen, liveTab: 'Canlı yayın', toSea: 'denize', area: 'Alan', address: 'Adres', onMap: 'Haritada', tour: '3D tur', example: 'Örnek', learnMore: 'Detaylar', promoBadge: 'Kampanya', until: (d) => `${d} tarihine kadar`, readMore: 'Devamını oku', liveBtn: 'Canlı kamera', liveOpen: 'Canlı kamerayı izle', video: 'Video', photos: 'Fotoğraflar', office: 'Stay Property Alanya ofisi', hours: 'Çalışma saatleri', hoursText: 'Her gün, 9:00–19:00', write: 'WhatsApp’tan yazın', docTabs: { pres: 'Sunum', plans: 'Planlar', docs: 'Belgeler' } },
  de: { ...NTen, liveTab: 'Livestream', toSea: 'zum Meer', area: 'Fläche', address: 'Adresse', onMap: 'Auf der Karte', tour: '3D-Tour', example: 'Beispiel', learnMore: 'Mehr erfahren', promoBadge: 'Angebot', until: (d) => `bis ${d}`, readMore: 'Weiterlesen', liveBtn: 'Live-Kamera', liveOpen: 'Live-Kamera ansehen', video: 'Video', photos: 'Fotos', office: 'Stay Property Büro in Alanya', hours: 'Öffnungszeiten', hoursText: 'Täglich, 9:00–19:00', write: 'Per WhatsApp schreiben', docTabs: { pres: 'Präsentation', plans: 'Grundrisse', docs: 'Dokumente' } },
  sr: { ...NTen, liveTab: 'Prenos uživo', toSea: 'do mora', area: 'Površina', address: 'Adresa', onMap: 'Na mapi', tour: '3D tura', example: 'Primer', learnMore: 'Saznajte više', promoBadge: 'Akcija', until: (d) => `do ${d}`, readMore: 'Pročitajte više', liveBtn: 'Live kamera', liveOpen: 'Pogledajte live kameru', video: 'Video', photos: 'Fotografije', office: 'Kancelarija Stay Property u Alanji', hours: 'Radno vreme', hoursText: 'Svakog dana, 9:00–19:00', write: 'Pišite na WhatsApp', docTabs: { pres: 'Prezentacija', plans: 'Planovi', docs: 'Dokumenta' } },
};
const { c } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const tc = d.complex;
const p = await getComplex(c.project.slug);
const g = geoOf(c);
const city = cityBySlug(c.city)!;
const district = c.district ? districtBySlug(c.city, c.district) : null;
const place = [district?.name[lang], city.name[lang]].filter(Boolean).join(', ');
const self = complexUrl(lang, c);

const units = [...(p?.units ?? c.project.units)].sort((a, b) => (a.priceFrom ?? 0) - (b.priceFrom ?? 0));
// Объекты комплекса из каталога: квартиры проектов Stay и объекты Portfolio с этим кодом.
const objects = [...(await getUnits()), ...(await getItems())].filter((x) => x.complex === c.code);
const prices = [...units.map((u) => u.priceFrom), ...objects.map((x) => x.price)].filter((v): v is number => !!v);
const low = prices.length ? Math.min(...prices) : c.priceFrom;
const high = prices.length > 1 ? Math.max(...prices) : c.priceTo;
const buildEnd = p?.facts.find((f) => f.label === 'build-end')?.value ?? null;
const meta = complexMeta(lang, c.title, g, low, high, c.rooms, buildEnd);
const hero = p?.heroImages[0] ?? c.image;
const galleryApi = (p?.gallery.length ? p.gallery : p?.heroImages ?? []).filter(Boolean);
const intro = p?.introHtml ? sanitize(p.introHtml) : '';
const description = strip(p?.introHtml || meta.description, 300);
const ytApi = p?.video?.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? null;

// Русский — единственный язык с описанием комплекса из API; остальные версии — без индексации и без hreflang.
const robots: Robots = lang === 'ru' ? 'index,follow' : 'noindex,follow';
const alternates = { ru: complexUrl('ru', c) };

// «Другие ЖК рядом»: PRIVE-ЖК только в разделе PRIVE (Anuar 26.11.2026) — у обычного ЖК их не показываем.
const cPrive = !isPublicComplex(c);
const okOther = (x: Complex) => x.slug !== c.slug && (cPrive || isPublicComplex(x));
const nearby = (await getComplexes()).filter((x) => okOther(x) && matchComplex(x, { country: c.country, city: c.city, district: c.district ?? undefined }));
const others = (nearby.length >= 3 ? nearby : [...nearby, ...(await getComplexes()).filter((x) => okOther(x) && x.city === c.city && !nearby.includes(x))]).slice(0, 3);
const geoCat = { country: c.country, city: c.city, district: c.district ?? undefined };
const guide = guideFor(lang, geoCat);
const links = [
  { href: catUrl(lang, { ...geoCat, deal: 'sale', type: 'apartments' }), text: `${TYPE_WORDS[lang].apartments.pl}: ${place}` },
  { href: catUrl(lang, geoCat, { complexes: true }), text: `${d.nav.complexes}: ${district?.name[lang] ?? city.name[lang]}` },
  ...(c.district ? [{ href: catUrl(lang, { country: c.country, city: c.city }, { complexes: true }), text: `${d.nav.complexes}: ${city.name[lang]}` }] : []),
  ...(guide ? [{ href: guide.href, text: guide.title }] : []),
  { href: `/${lang}/services/due-diligence/`, text: SERVICE_TITLES[lang]['due-diligence'] },
];
// Наши проекты (решение Anuar 25.11): короткие крошки «Главная · STAY PROJECTS · Проект», как у образца.
// PRIVE-ЖК (не наши) — «Главная · PRIVE · ЖК»: в «Новостройках» их нет (Anuar 26.11.2026).
const crumbs = isOurComplex(c) ? [{ label: t(lang).home, href: `/${lang}/` }, { label: 'STAY PROJECTS', href: `/${lang}/stay-projects/` }, { label: c.title }]
  : !isPublicComplex(c) ? [{ label: t(lang).home, href: `/${lang}/` }, { label: 'PRIVE', href: `/${lang}/prive/` }, { label: c.title }]
  : catCrumbs(lang, { ...geoCat, complexes: true }, c.title);
const vld = p?.video ? videoLd(p.video, c.title, description, new Date().toISOString()) : null;
const ld = [
  complexLd({ url: self, name: c.title, description, images: [hero, ...galleryApi].filter(Boolean) as string[], city: city.name.en, region: district?.name.en ?? city.name.en, country: c.country === 'turkey' ? 'TR' : c.country === 'uae' ? 'AE' : 'CY', lat: p?.lat ?? c.lat, lng: p?.lng ?? c.lng, units: objects.length || null, amenities: p?.amenities ?? [], low, high, offers: objects.length || units.length }),
  ...(vld ? [vld] : []),
];
const ogImage = `/og/complex/${c.slug}.jpg?lang=${lang}`;
// Блоки по образцу mr-group (31.10.2026): генплан с нашим подборщиком и новые разделы (часть — заглушки).
const tb = COMPLEX_BLOCKS[lang];
const picker = pickerFor(c.slug);
const pickerUrl = `${self}/picker/`;
// Полная страница проекта (генплан, статус, акции, материалы, ход строительства, новости) — только у наших
// STAY PROJECTS и у ЖК с подборщиком (Anuar 25.11.2026). У остальных ЖК — короткая: без генплана и пустых блоков «скоро».
const ours = isOurComplex(c);
const full = ours || !!picker;
const plans = ours ? await plansOf(c.code) : null;
const real = picker ? await pickerReals(c.code, picker, lang).catch(() => []) : [];
// Карточки над описанием — по планировкам (тип + комнатность), как у образца: «Студии / от 28 м² / от … / 11 квартир».
// Клик: у наших проектов — каталог с фильтром «Проект + комнатность», у остальных — список квартир планировки (одна — сразу её страница).
const STUDIO: Record<string, string> = { ru: 'Студии', en: 'Studios', tr: 'Stüdyolar', de: 'Studios', sr: 'Garsonjere' };
const TYPE_ORDER = ['apartments', 'duplexes', 'penthouses', 'townhouses', 'villas', 'commercial', 'land'];
const roomsKey = (r: string | null) => { if (!r) return null; if (r === '1+0') return 'studio'; const n = Number(r.split('+')[0]); return Number.isFinite(n) ? (n >= 4 ? '4+' : `${n}+1`) : null; };
const roomsN = (r: string | null) => (r === '1+0' ? 0 : r ? Number(r.split('+')[0]) || 99 : 99);
const byPrice = (a: (typeof objects)[number], b: (typeof objects)[number]) => (a.price ?? Infinity) - (b.price ?? Infinity) || (a.area ?? 0) - (b.area ?? 0);
const grouped = new Map<string, typeof objects>();
for (const x of objects) { const k = `${x.type}|${x.rooms ?? ''}`; grouped.set(k, [...(grouped.get(k) ?? []), x]); }
const flatGroups = [...grouped.entries()].map(([key, list], i) => {
  const items = [...list].sort(byPrice);
  const x0 = items[0];
  const areas = items.map((x) => x.area).filter((v): v is number => !!v);
  const pr = items.map((x) => x.price).filter((v): v is number => !!v);
  const tw = TYPE_WORDS[lang][x0.type];
  const studio = x0.rooms === '1+0' && x0.type === 'apartments';
  return {
    key, id: `grp-${i}`, items, type: x0.type, rooms: x0.rooms,
    title: studio ? STUDIO[lang] : `${tw.pl}${x0.rooms ? ` ${x0.rooms}` : ''}`,
    area: areas.length ? Math.min(...areas) : null,
    areaMax: areas.length ? Math.max(...areas) : null,
    price: pr.length ? Math.min(...pr) : null,
    image: items.find((x) => x.image)?.image ?? null,
    count: `${items.length} ${pluralL(lang, items.length, tw.n)}`,
    // Наши проекты: карточка открывает каталог с галочкой «Объекты Stay», проектом и комнатностью (как у образца).
    href: ours ? ownUrl(lang, x0.type, { projectSlugs: [c.slug], rooms: roomsKey(x0.rooms) ? [roomsKey(x0.rooms)!] : [] }) : items.length === 1 ? itemUrl(lang, x0) : null,
  };
}).sort((a, b) => roomsN(a.rooms) - roomsN(b.rooms) || TYPE_ORDER.indexOf(a.type) - TYPE_ORDER.indexOf(b.type));
const infra = p?.infrastructure ?? [];
// Карточка-характеристики вида «Планировка:» / «1+1, 2+1» / «Площадь:» / «от 61 до 147 кв.м.» → пары «название — значение».
const pairsOf = (html: string) => {
  const ps = [...html.matchAll(/<p[^>]*>([\s\S]*?)<\/p>/g)].map((m) => m[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim()).filter(Boolean);
  if (ps.length < 2 || ps.length % 2) return null;
  const out: [string, string][] = [];
  for (let i = 0; i < ps.length; i += 2) {
    if (!ps[i].endsWith(':') || ps[i + 1].endsWith(':')) return null;
    out.push([ps[i].slice(0, -1), ps[i + 1].replace(/кв\.?\s?м\.?/g, 'м²')]);
  }
  return out;
};
const textLen = (html: string) => html.replace(/<[^>]+>/g, '').trim().length;
// «О проекте»: текст и фото — из карточки «Расположение». Без неё — характеристики плитками (а не столбиком
// «Планировка: / 1+1»), а если их нет — первая карточка с обычным текстом (не списком).
const factsCard = infra.find((x) => pairsOf(x.html));
const aboutCard = infra.find((x) => /располож|location|konum/i.test(x.title)) ?? (factsCard ? undefined : infra.find((x) => !/<li/i.test(x.html) && textLen(x.html) > 150));
// Без карточки «Расположение» берём из описания ЖК предложения про расположение: море, центр, аэропорт, расстояния.
const locFromIntro = (() => {
  const txt = (p?.introHtml || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ');
  const sents = txt.match(/[^.!?]+[.!?]/g) ?? [];
  const picked = sents.map((x) => x.trim()).filter((x) => /мор|центр|аэропорт|пляж|\d\s*(км|м\b|метр)/i.test(x) && !/площадь апартаментов|планировк|stay property/i.test(x)).slice(0, 3);
  return picked.length ? `<p>${picked.join(' ')}</p>` : '';
})();
const about = aboutCard
  ? { html: sanitize(aboutCard.html), images: aboutCard.images, pairs: null }
  : factsCard || locFromIntro
    ? { html: locFromIntro ? sanitize(locFromIntro) : '', images: factsCard?.images ?? [], pairs: factsCard ? pairsOf(factsCard.html) : null }
    : null;
// «Страница проекта» из админки (план страницы ЖК по МИРА, Anuar 28.11.2026). Пустое поле — блока на сайте нет.
// На превью Vercel пустые блоки показываем с примером (плашка «Пример»), чтобы оценить вид; на боевом сайте — скрываем.
const ppDb = await getProjectPages();
const demo = full && (process.env.VERCEL_ENV ?? '') === 'preview';
// Демо-проект на превью: один ЖК заполнен тестовыми данными целиком (Anuar 28.11.2026), см. lib/projectDemo.ts.
const demoProject = demo && c.code === DEMO_CODE && !ppDb.projects[c.code];
const pp: ProjectPage = ppDb.projects[c.code]
  ?? (demoProject ? demoPage([...new Set(objects.map((x) => x.image).filter((x): x is string => !!x))], objects.filter((x) => x.unit).map((x) => x.id), hero) : {});
// Фото для слайдера и блоков: из базы ЖК, а если там пусто — загруженные в админке.
const gallery = galleryApi.length ? galleryApi : (pp.photos ?? []).map((x) => x.src);
const ytId = ytApi ?? (demoProject ? DEMO_VIDEO : null);
// «О проекте»: короткое описание под заголовком, как у образца (Anuar 28.11.2026): из админки, иначе 2–3 первых
// предложения из текста «Расположение» или описания ЖК (не длиннее ~320 знаков, по границе предложения).
const firstSentences = (html: string, max = 320) => {
  const txt = html.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&[a-z]+;/g, ' ').replace(/\s+/g, ' ').trim();
  let out = '';
  for (const s of txt.match(/[^.!?]+[.!?]+/g) ?? [txt]) { if (out && (out + s).length > max) break; out += s; }
  return out.trim().slice(0, max + 80);
};
const aboutText = tx(pp.about, lang) || firstSentences(about?.html || p?.introHtml || '') || '';
const aboutLang = lang !== 'ru' && pp.about?.en ? 'en' : 'ru';
const N = NT[lang];
const today = new Date();
const isoIn = (days: number) => new Date(today.getTime() + days * 86_400_000).toISOString().slice(0, 10);
const subtitle = tx(pp.subtitle, lang);
// «До моря» — самое близкое из квартир ЖК (поле квартир Portfolio/adminer), отдельного поля у ЖК нет.
const seas = objects.map((x) => x.sea).filter((v): v is number => !!v && v > 0);
const sea = seas.length ? Math.min(...seas) : null;
const seaText = sea ? (sea >= 1000 ? `${numL(lang, Math.round(sea / 100) / 10)} ${N.km}` : `${numL(lang, sea)} ${d.m}`) : null;
// Цена за м² — минимальная по квартирам с ценой и площадью; площади — от и до.
const perM2s = objects.filter((x) => x.price && x.area).map((x) => x.price! / x.area!);
const perM2 = perM2s.length ? Math.round(Math.min(...perM2s)) : null;
const areasAll = [...objects.map((x) => x.area), ...units.map((u) => u.areaFrom)].filter((v): v is number => !!v);
const areaMin = areasAll.length ? Math.min(...areasAll) : null;
const areaMax = areasAll.length ? Math.max(...areasAll) : null;
// Акции: из админки (до 2, после даты «до» скрываются сами); без них — строка-акция из базы ЖК.
const promosLive = livePromos(pp, today).map((x) => ({ title: tx(x.title, lang), text: tx(x.text, lang), until: x.until ? N.until(dateL(lang, x.until)) : '', image: x.image || null, demo: false }));
const promos = promosLive.length ? promosLive
  : p?.promo && lang === 'ru' ? [{ title: p.promo, text: '', until: '', image: null, demo: false }]
  : demo ? [{ title: N.demoPromo, text: N.demoPromoText, until: N.until(dateL(lang, isoIn(45))), image: null, demo: true }] : [];
const promoImg = (i: number) => promos[i]?.image ?? gallery[i ? 1 : 3] ?? hero;
// Рассрочка: своя из админки, иначе из базы ЖК; ипотека — общие цифры на все ЖК.
const insA = pp.installment;
const insB = p?.installment;
const insDown = insA?.down ?? insB?.initialPay ?? null;
const insMonths = insA?.months ?? insB?.months ?? null;
const insText = tx(insA?.text, lang) || (lang === 'ru' ? insB?.conditions ?? '' : '');
const buyWays = tb.buyWays.map((x, i) => i === 1 && (insDown || insMonths || insText)
  ? { ...x, text: [insDown != null || insMonths ? N.installment(insDown, insMonths) : '', insText].filter(Boolean).join('. ') }
  : i === 2 ? { ...x, text: N.mortgage(ppDb.mortgage.down, ppDb.mortgage.years) } : x);
// Фото по категориям: фото из базы ЖК + свои из админки; без категории — только во «Все».
const photoList = [...galleryApi.map((src) => ({ src, cat: (pp.photoCats?.[src] ?? '') as PhotoCat | '' })), ...(pp.photos ?? [])];
const catsUsed = PHOTO_CATS.filter((k) => photoList.some((x) => x.cat === k));
// Галерея: фото по категориям подряд (порядок категорий как в админке), без категории — в конце «Другое».
const GAL = {
  title: { ru: 'Галерея', en: 'Gallery', tr: 'Galeri', de: 'Galerie', sr: 'Galerija' } as Record<string, string>,
  other: { ru: 'Другое', en: 'Other', tr: 'Diğer', de: 'Weitere', sr: 'Ostalo' } as Record<string, string>,
  open: { ru: 'Открыть фото на весь экран', en: 'Open photo full screen', tr: 'Fotoğrafı tam ekran aç', de: 'Foto im Vollbild öffnen', sr: 'Otvori fotografiju preko celog ekrana' } as Record<string, string>,
  close: { ru: 'Закрыть', en: 'Close', tr: 'Kapat', de: 'Schließen', sr: 'Zatvori' } as Record<string, string>,
};
const galGroups = [
  ...catsUsed.map((k) => ({ label: PHOTO_CAT_LABEL[k][lang], items: photoList.filter((x) => x.cat === k).map((x) => x.src) })),
  { label: catsUsed.length ? GAL.other[lang] : GAL.title[lang], items: photoList.filter((x) => !x.cat).map((x) => x.src) },
].filter((gr) => gr.items.length);
// Материалы (PDF) по вкладкам; плитка «Презентация» ведёт на первую презентацию.
const docsReal = (pp.docs ?? []).map((x) => ({ tab: x.tab, title: tx(x.title, lang), file: x.file, cover: x.cover || null, demo: false }));
const docs = docsReal.length ? docsReal : demo ? tb.docsList.slice(0, 3).map((title, i) => ({ tab: (['pres', 'plans', 'docs'] as const)[i], title, file: '', cover: null, demo: true })) : [];
const docTabs = (['pres', 'plans', 'docs'] as const).filter((k) => docs.some((x) => x.tab === k));
const pres = docsReal.find((x) => x.tab === 'pres') ?? null;
// Ход строительства: месяцы из админки (новые первыми); на превью без данных — пример из фото ЖК.
const progressReal = (pp.progress ?? []).map((x) => ({ month: x.month, photos: x.photos, text: tx(x.text, lang) }));
// Пример на превью: несколько месяцев за последние два года, фото — из галереи ЖК, иначе главное фото, иначе серые заглушки.
const demoPool = gallery.length ? gallery : [hero, c.image].filter((x): x is string => !!x);
const progress: { month: string; photos: (string | null)[]; text: string }[] = progressReal.length ? progressReal
  : demo ? [0, 1, 3, 5, 12, 24].map((k, j) => { const dt = new Date(today.getFullYear(), today.getMonth() - k, 1); return { month: `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}`, photos: [0, 1, 2].map((n) => (demoPool.length ? demoPool[(j * 3 + n) % demoPool.length] : null)), text: k ? '' : N.demoProgress }; }) : [];
// Шкала как у образца: годы слева, месяцы выбранного года по линии; месяц без фото — бледный и не нажимается.
const progMonths = new Set(progress.map((m) => m.month));
const progYears = [...new Set(progress.map((m) => m.month.slice(0, 4)))].sort();
const progRows = progYears.map((y) => {
  const last = Math.max(...progress.filter((m) => m.month.startsWith(y)).map((m) => Number(m.month.slice(5))));
  const upto = y === progYears[progYears.length - 1] ? last : 12;
  return { y, months: Array.from({ length: upto }, (_, i) => `${y}-${String(i + 1).padStart(2, '0')}`) };
});
const monthLabel = (m: string) => { const [y, mm] = m.split('-').map(Number); return `${tb.months[mm - 1]} ${y}`; };
const liveUrl = pp.liveUrl ?? null;
// Плитки под слайдами: на превью без данных показываем все три как пример.
const liveHref = liveUrl ?? (demo ? '#lead' : null);
const presHref = pres?.file ?? (demo ? '#docs' : null);
const tileCount = [liveHref, presHref, docs.length].filter(Boolean).length;
// Новости проекта: три последние; на превью без данных — пример.
const newsReal = (pp.news ?? []).slice(0, 3).map((x) => ({ date: dateL(lang, x.date), title: tx(x.title, lang), text: tx(x.text, lang), image: x.image || null }));
const news = newsReal.length ? newsReal : demo ? tb.newsList.map((title, i) => ({ date: dateL(lang, isoIn(-7 * (i + 1))), title, text: N.demoNews, image: gallery[i + 2] ?? null })) : [];
// Контакты: офис продаж — Аланийский для всех ЖК (Anuar 28.11.2026).
const office = OFFICES.find((o) => o.id === 'alanya')!;
const officeTel = 'tel:+' + office.phone.split('').filter((ch) => ch >= '0' && ch <= '9').join('');
const officePhone = office.phone.replace(/-/g, ' ');
const tourUrl = pp.tourUrl ?? null;
// Фото в форме — только если сотрудник загрузил его в админке; иначе нейтральная картинка, как у образца (Anuar 28.11.2026: фото ЖК на странице и так много).
const formImage = pp.formImage ?? null;
// «Смотрите также»: плашка «Акция», если у того ЖК есть действующая акция.
const promoOf = (o: Complex) => livePromos(ppDb.projects[o.code] ?? {}, today).length > 0;
