---
/**
 * Карточка жилого комплекса, порядок и вид блоков как у образца mr-group (решение Anuar 31.10.2026):
 * шапка с квартирами → о комплексе (видео/фото, статус) → галерея → генплан → «В проекте» → форма →
 * смотрите также → способы покупки и акции → материалы → ход строительства → новости → контакты → подборки. Описание из API есть только на русском,
 * поэтому версии на других языках пока noindex (см. отчёт).
 */
import Base from '../layouts/Base.astro';
import Img from './Img.astro';
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProjectCard from './ProjectCard.astro';
import LeadForm from './LeadForm.astro';
import { t } from '../i18n/ui';
import { getComplex } from '../lib/api';
import { getComplexes, getUnits, getItems, complexUrl, catUrl, itemUrl, matchComplex, type Complex } from '../lib/catalog';
import { cityBySlug, districtBySlug } from '../lib/geo';
import { geoOf, complexMeta } from '../lib/seo';
import { catCrumbs, SERVICE_TITLES } from '../lib/nav';
import { complexLd, videoLd } from '../lib/ld';
import { guideFor } from '../lib/blog';
import { sanitize } from '../lib/sanitize';
import { moneyL, numL, strip } from '../lib/format';
import { TYPE_WORDS } from '../lib/segments';
import type { Robots } from '../lib/page';
import { pickerFor, pickerReals, PICKER_TEXT } from '../lib/pickers';
import { COMPLEX_BLOCKS } from '../lib/complexBlocks';
import ComplexGenplan from './ComplexGenplan.astro';
import { site } from '../lib/site';

interface Props { c: Complex }
const { c } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const tc = d.complex;
const p = await getComplex(c.project.slug);
const g = geoOf(c);
const city = cityBySlug(c.city)!;
const district = c.district ? districtBySlug(c.city, c.district) : null;
const place = [district?.name[lang], city.name[lang]].filter(Boolean).join(', ');
const self = complexUrl(lang, c);

const units = [...(p?.units ?? c.project.units)].sort((a, b) => (a.priceFrom ?? 0) - (b.priceFrom ?? 0));
// Объекты комплекса из каталога: квартиры проектов Stay и объекты Portfolio с этим кодом.
const objects = [...(await getUnits()), ...(await getItems())].filter((x) => x.complex === c.code);
const prices = [...units.map((u) => u.priceFrom), ...objects.map((x) => x.price)].filter((v): v is number => !!v);
const low = prices.length ? Math.min(...prices) : c.priceFrom;
const high = prices.length > 1 ? Math.max(...prices) : c.priceTo;
const buildEnd = p?.facts.find((f) => f.label === 'build-end')?.value ?? null;
const meta = complexMeta(lang, c.title, g, low, high, c.rooms, buildEnd);
const hero = p?.heroImages[0] ?? c.image;
const gallery = (p?.gallery.length ? p.gallery : p?.heroImages ?? []).filter(Boolean);
const intro = p?.introHtml ? sanitize(p.introHtml) : '';
const description = strip(p?.introHtml || meta.description, 300);
const ytId = p?.video?.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? null;
const FACT_LABEL: Record<string, string> = { price: tc.priceRange, 'build-end': tc.deadline, mix: tc.layouts, location: tc.location };

// Русский — единственный язык с описанием комплекса из API; остальные версии — без индексации и без hreflang.
const robots: Robots = lang === 'ru' ? 'index,follow' : 'noindex,follow';
const alternates = { ru: complexUrl('ru', c) };

const nearby = (await getComplexes()).filter((x) => x.slug !== c.slug && matchComplex(x, { country: c.country, city: c.city, district: c.district ?? undefined }));
const others = (nearby.length >= 3 ? nearby : [...nearby, ...(await getComplexes()).filter((x) => x.slug !== c.slug && x.city === c.city && !nearby.includes(x))]).slice(0, 3);
const geoCat = { country: c.country, city: c.city, district: c.district ?? undefined };
const guide = guideFor(lang, geoCat);
const links = [
  { href: catUrl(lang, { ...geoCat, deal: 'sale', type: 'apartments' }), text: `${TYPE_WORDS[lang].apartments.pl}: ${place}` },
  { href: catUrl(lang, geoCat, { complexes: true }), text: `${d.nav.complexes}: ${district?.name[lang] ?? city.name[lang]}` },
  ...(c.district ? [{ href: catUrl(lang, { country: c.country, city: c.city }, { complexes: true }), text: `${d.nav.complexes}: ${city.name[lang]}` }] : []),
  ...(guide ? [{ href: guide.href, text: guide.title }] : []),
  { href: `/${lang}/services/due-diligence/`, text: SERVICE_TITLES[lang]['due-diligence'] },
];
const crumbs = catCrumbs(lang, { ...geoCat, complexes: true }, c.title);
const vld = p?.video ? videoLd(p.video, c.title, description, new Date().toISOString()) : null;
const ld = [
  complexLd({ url: self, name: c.title, description, images: [hero, ...gallery].filter(Boolean) as string[], city: city.name.en, region: district?.name.en ?? city.name.en, country: c.country === 'turkey' ? 'TR' : c.country === 'uae' ? 'AE' : 'CY', lat: p?.lat ?? c.lat, lng: p?.lng ?? c.lng, units: objects.length || null, amenities: p?.amenities ?? [], low, high, offers: objects.length || units.length }),
  ...(vld ? [vld] : []),
];
const ogImage = `/og/complex/${c.slug}.jpg?lang=${lang}`;
// Блоки по образцу mr-group (31.10.2026): генплан с нашим подборщиком и новые разделы (часть — заглушки).
const tb = COMPLEX_BLOCKS[lang];
const picker = pickerFor(c.slug);
const pickerUrl = `${self}/picker/`;
const real = picker ? await pickerReals(c.code, picker, lang).catch(() => []) : [];
const flatCards = objects.filter((x) => x.image);
const infra = p?.infrastructure ?? [];
const progressPhotos = gallery.slice(2, 6);
// Карточка-характеристики вида «Планировка:» / «1+1, 2+1» / «Площадь:» / «от 61 до 147 кв.м.» → пары «название — значение».
const pairsOf = (html: string) => {
  const ps = [...html.matchAll(/<p[^>]*>([\s\S]*?)<\/p>/g)].map((m) => m[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim()).filter(Boolean);
  if (ps.length < 2 || ps.length % 2) return null;
  const out: [string, string][] = [];
  for (let i = 0; i < ps.length; i += 2) {
    if (!ps[i].endsWith(':') || ps[i + 1].endsWith(':')) return null;
    out.push([ps[i].slice(0, -1), ps[i + 1].replace(/кв\.?\s?м\.?/g, 'м²')]);
  }
  return out;
};
const textLen = (html: string) => html.replace(/<[^>]+>/g, '').trim().length;
// «О проекте»: текст и фото — из карточки «Расположение». Без неё — характеристики плитками (а не столбиком
// «Планировка: / 1+1»), а если их нет — первая карточка с обычным текстом (не списком).
const factsCard = infra.find((x) => pairsOf(x.html));
const aboutCard = infra.find((x) => /располож|location|konum/i.test(x.title)) ?? (factsCard ? undefined : infra.find((x) => !/<li/i.test(x.html) && textLen(x.html) > 150));
const about = aboutCard
  ? { html: sanitize(aboutCard.html), images: aboutCard.images, pairs: null }
  : factsCard ? { html: '', images: factsCard.images, pairs: pairsOf(factsCard.html) } : null;
const year = new Date().getFullYear();
const month = new Date().getMonth();
---
<Base system="new" title={meta.title} description={meta.description} canonical={self} robots={robots} alternates={alternates} image={ogImage} overlayHeader jsonLd={ld}>
  <section class="panel-b pb-8 lg:pb-10">
    <div class="relative isolate overflow-hidden rounded-b-[24px] bg-ink text-white lg:rounded-b-[var(--radius-panel)]">
      <Img src={hero} alt={`${c.title} — ${place}`} class="absolute inset-0 -z-10 size-full" priority sizes="100vw" width={1920} height={1080} />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/50 via-ink/10 to-ink/75"></div>
      <div class="container-n relative flex min-h-[520px] flex-col justify-end pb-8 pt-32 lg:min-h-[520px] lg:pb-10">
        {(p?.promo || buildEnd) && (
          <div class="absolute right-5 top-32 hidden w-[294px] rounded-[20px] bg-white p-3 text-ink-n lg:right-10 lg:block">
            <span class="inline-flex rounded-[6px] bg-ink-n px-2 py-0.5 text-[11px] font-medium uppercase tracking-[1px] text-white">{p?.promo && lang === 'ru' ? tb.promo : tc.deadline}</span>
            <p class="mt-2 text-[15px] leading-[20px]">{p?.promo && lang === 'ru' ? p.promo : buildEnd}</p>
          </div>
        )}
        <h1 class="display h-page max-w-4xl text-white">{meta.h1}</h1>
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] leading-[18px] text-white/90">
          <span class="inline-flex items-center gap-1.5"><Icon name="pin" class="size-4" />{place}</span>
          {buildEnd && <span>{tc.deadline}: {buildEnd}</span>}
          {c.rooms.length > 0 && <span>{c.rooms.join(' · ')}</span>}
        </p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {picker ? <a href="#genplan" class="btn-n btn-n-accent max-sm:w-full">{tb.choose}</a> : <a href="#lead" class="btn-n btn-n-accent max-sm:w-full">{tc.getPrice}</a>}
          {picker && <a href="#lead" class="btn-n btn-n-glass max-sm:w-full">{tc.getPrice}</a>}
        </div>
      </div>
    </div>

    <div class="container-n">
      <div class="pt-5"><Breadcrumbs items={crumbs} /></div>
      {((p?.facts.length ?? 0) > 0 || low || objects.length > 0) && (
        <dl class="mt-6 grid gap-5 sm:grid-cols-2 lg:flex lg:flex-wrap lg:gap-x-10">
          {low && <div class="fact"><span class="fact-i"><Icon name="tag" class="size-5" /></span><div><dt>{tc.priceRange}</dt><dd>{d.from(moneyL(lang, low))}{high && high > low ? ` – ${moneyL(lang, high)}` : ''}</dd></div></div>}
          {p?.facts.filter((f) => f.label !== 'price').map((f) => <div class="fact"><span class="fact-i"><Icon name={f.label === 'build-end' ? 'calendar' : f.label === 'location' ? 'pin' : f.label === 'mix' ? 'layout' : 'building'} class="size-5" /></span><div><dt>{FACT_LABEL[f.label] ?? f.label}</dt><dd>{f.value}</dd></div></div>)}
          {objects.length > 0 && <div class="fact lg:ml-auto"><span class="fact-i fact-dark"><Icon name="building" class="size-5" /></span><div><dt>{tc.available}</dt><dd>{numL(lang, objects.length)}</dd></div></div>}
        </dl>
      )}

      {flatCards.length > 0 ? (
        <div id="choose" class="relative mt-8 scroll-mt-28 lg:mt-10" data-car>
          <h2 class="sr-only">{tb.flats}</h2>
          <ul class="scroll-x -mx-5 flex snap-x scroll-px-5 gap-4 px-5 lg:mx-0 lg:scroll-px-0 lg:px-0" data-car-track>
            {flatCards.map((x) => (
              <li class="w-[248px] shrink-0 snap-start lg:w-[calc((100%-48px)/4)]">
                <a href={itemUrl(lang, x)} class="tile-n group flex h-full flex-col gap-1 p-4 transition hover:shadow-[var(--shadow-card)]">
                  <span class="text-[15px] leading-[20px] text-ink-n">{TYPE_WORDS[lang][x.type].one} {x.rooms}{x.area ? `, ${numL(lang, x.area)} ${d.m2}` : ''}</span>
                  <span class="text-[13px] text-soft">{x.price ? moneyL(lang, x.price) : d.priceOnRequest}</span>
                  <span class="mt-2 overflow-hidden rounded-[12px] bg-white"><Img src={x.image} alt="" class="aspect-[4/3] w-full object-contain" width={480} height={360} /></span>
                </a>
              </li>
            ))}
          </ul>
          {flatCards.length > 4 && <button type="button" class="car-btn absolute -right-5 top-1/2 hidden -translate-y-1/2 lg:grid" data-car-next aria-label={tb.next}><Icon name="chevronRight" class="size-4" /></button>}
        </div>
      ) : units.length > 0 && (
        <div id="choose" class="mt-8 scroll-mt-28 lg:mt-10">
          <h2 class="sr-only">{tc.layouts}</h2>
          <ul class="scroll-x -mx-5 flex snap-x gap-4 px-5 lg:mx-0 lg:grid lg:grid-cols-4 lg:px-0">
            {units.map((u) => (
              <li class="w-[248px] shrink-0 snap-start lg:w-auto">
                <a href="#lead" class="tile-n group relative flex h-full min-h-[168px] flex-col p-5 transition hover:shadow-[var(--shadow-card)]">
                  <span class="text-[16px] leading-[22px] tracking-[.2px] text-ink-n">{u.type}{u.rooms ? ` ${u.rooms}` : ''}{u.areaFrom ? <>, {d.from(`${numL(lang, u.areaFrom)} ${d.m2}`)}</> : null}</span>
                  <span class="mt-1 text-[14px] leading-[19px] text-ink-n">{u.priceFrom ? d.from(moneyL(lang, u.priceFrom)) : d.priceOnRequest}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="mt-20 lg:mt-28" data-tabs>
    <div class="mx-auto max-w-[778px] px-5 text-center">
      <h2 class="display h-section-n mb-4">{c.title}</h2>
      {lang !== 'ru' && <p class="mb-4 rounded-[16px] bg-white p-4 text-left text-sm">{tc.noText}</p>}
      {intro ? <div class="prose-stay complex-intro clamp" lang="ru" set:html={intro} data-clamp /> : <p class="text-[18px] leading-[26px] lg:text-[19px]">{meta.description}</p>}
      {intro && <button type="button" class="mt-3 text-[14px] text-accent" data-more>{tb.promoMore}</button>}
      <div class="mt-6 flex justify-center">
        <div class="seg">
          {ytId && <button type="button" aria-selected="true" data-jump="0">{tb.video}</button>}
          {gallery.length > 0 && <button type="button" aria-selected={ytId ? 'false' : 'true'} data-jump={ytId ? '1' : '0'}>{tb.photo}</button>}
        </div>
      </div>
    </div>
    <div class="mx-auto mt-6 max-w-[1256px] px-5" data-car>
      <div class="scroll-x flex snap-x snap-mandatory gap-3" data-car-track>
        {ytId && (
          <div id="video" class="relative aspect-[1216/730] w-[92%] shrink-0 snap-center overflow-hidden rounded-[24px] bg-ink lg:w-full" data-yt={ytId}>
            <button type="button" class="group absolute inset-0 grid place-items-center" aria-label={tc.video}>
              <img src={`https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" class="absolute inset-0 size-full object-cover opacity-80" />
              <span class="relative grid size-14 place-items-center rounded-[16px] bg-white text-ink shadow-lg"><Icon name="play" class="size-6" /></span>
            </button>
          </div>
        )}
        {gallery.slice(0, 6).map((src, i) => (
          <div class="aspect-[1216/730] w-[92%] shrink-0 snap-center overflow-hidden rounded-[24px] lg:w-full"><Img src={src} alt={`${c.title} — ${d.photo} ${i + 1}`} class="size-full" width={1280} height={720} /></div>
        ))}
      </div>
      <h2 class="sr-only">{tb.status}</h2>
      <ul class="mt-3 grid gap-3 md:grid-cols-3">
        <li class="flex min-h-[220px] flex-col rounded-[24px] bg-white p-6 md:aspect-[397/476] md:min-h-0"><p class="text-[20px] leading-[26px] text-ink-n">{tb.status}</p><p class="mt-1 text-[13px] text-soft">{tc.deadline}: {buildEnd ?? '—'}</p><span class="mt-auto grid size-10 place-items-center self-start rounded-[12px] bg-page-n text-ink-n"><Icon name="building" class="size-5" /></span></li>
        <li class="flex min-h-[220px] flex-col rounded-[24px] bg-white p-6 md:aspect-[397/476] md:min-h-0"><p class="text-[20px] leading-[26px] text-ink-n">{tb.statusStage} <span class="stub">{tb.stub}</span></p><p class="mt-1 text-[13px] text-soft">{tb.statusStageText}</p><span class="mt-auto self-end text-soft"><Icon name="arrowRight" class="size-4" /></span></li>
        <li class="flex min-h-[220px] flex-col rounded-[24px] bg-accent p-6 text-white md:aspect-[397/476] md:min-h-0"><p class="text-[20px] leading-[26px]">{tb.viewing}</p><p class="mt-1 text-[13px] text-white/80">{tb.viewingText}</p><a href="#viewing" class="mt-auto grid size-10 place-items-center self-end rounded-[12px] bg-white text-ink" aria-label={tb.viewingBtn}><Icon name="arrowRight" class="size-4" /></a></li>
      </ul>
    </div>
  </section>

  {gallery.length > 2 && (
    <section class="container-n mt-20 lg:mt-28" data-car>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4 lg:mb-8">
        <h2 class="display h-section-n">{d.item.gallery}</h2>
        <div class="flex items-center gap-2">
          <div class="seg"><span aria-selected="true">{tb.all} · {gallery.length}</span></div>
          <button type="button" class="car-btn hidden lg:grid" data-car-prev aria-label={tb.prev}><Icon name="arrowLeft" class="size-4" /></button>
          <button type="button" class="car-btn hidden lg:grid" data-car-next aria-label={tb.next}><Icon name="arrowRight" class="size-4" /></button>
        </div>
      </div>
      <div class="scroll-x flex snap-x snap-mandatory gap-3" data-car-track>
        {gallery.map((src, i) => (
          <a href={src} target="_blank" rel="noopener" class="w-[86%] shrink-0 snap-start overflow-hidden rounded-[20px] lg:w-[82%]">
            <Img src={src} alt={`${c.title} — ${d.photo} ${i + 1}`} class="aspect-[4/3] w-full lg:aspect-[16/9]" width={1280} height={720} />
          </a>
        ))}
      </div>
    </section>
  )}

  {picker && <ComplexGenplan slug={c.slug} conf={picker} pickerUrl={pickerUrl} units={units} real={real} />}
  {!picker && hero && (
    <section id="genplan" class="container-n mt-20 scroll-mt-28 lg:mt-28">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4 lg:mb-8">
        <h2 class="display h-section-n">{tb.genplan}</h2>
        <div class="seg"><span aria-selected="true">{tb.genplan3d}</span></div>
      </div>
      <div class="relative overflow-hidden rounded-[20px] bg-ink lg:rounded-[24px]">
        <Img src={hero} alt={`${c.title} — ${tb.genplan}`} class="aspect-[4/3] w-full md:aspect-[1384/700]" width={1600} height={810} />
        <div class="absolute inset-x-3 bottom-3 rounded-[16px] bg-white p-4 text-ink-n md:inset-x-auto md:bottom-6 md:left-6 md:w-[360px] md:p-5">
          <p class="text-[16px] leading-[22px]">{tb.gpPickSoon}</p>
          <a href="#lead" class="btn-n btn-n-dark mt-3 h-12! w-full rounded-[14px]!">{tb.leaveRequest}</a>
        </div>
      </div>
    </section>
  )}

  <section class="mt-20 lg:mt-28" data-tabs>
    <div class="mx-auto max-w-[988px] px-5 text-center">
      <h2 class="display h-section-n mb-4">{tb.aboutProject}{infra.length === 0 && <> <span class="stub">{tb.stub}</span></>}</h2>
      {about?.html && <div class="prose-stay about-text" lang="ru" set:html={about.html} />}
      {about?.pairs && (
        <dl class="mt-2 flex flex-wrap justify-center gap-3" lang="ru">
          {about.pairs.map(([k, v]) => <div class="min-w-[160px] rounded-[16px] bg-white px-5 py-4 text-left"><dt class="text-[13px] text-soft">{k}</dt><dd class="mt-1 text-[18px] leading-[24px] text-ink-n">{v}</dd></div>)}
        </dl>
      )}
    </div>
    <div class="mx-auto mt-6 max-w-[1256px] px-5">
      <div class="relative overflow-hidden rounded-[24px] bg-ink text-white">
        <Img src={about?.images[0] ?? gallery[2] ?? hero} alt={c.title} class="aspect-[4/3] w-full md:aspect-[1216/698]" width={1280} height={735} />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-ink/30"></div>
        <p class="display absolute left-6 top-6 text-[24px] leading-[30px] lg:left-8 lg:top-8 lg:text-[32px] lg:leading-[42px]">{c.title}</p>
        {infra.length > 0 && <button type="button" class="btn-n btn-n-white absolute bottom-6 right-6" data-more-infra>{tb.promoMore}</button>}
      </div>
      {infra.length > 0 && (
        <div class="mt-6 hidden rounded-[24px] bg-white p-6 lg:p-8" data-infra>
          {infra.length > 1 && <div class="seg mb-6 max-w-full scroll-x" role="tablist">{infra.map((x, i) => <button type="button" role="tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>{x.title}</button>)}</div>}
          {infra.map((x, i) => {
            const pr = pairsOf(x.html);
            return pr
              ? <dl data-pane={i} hidden={i !== 0} class="flex flex-wrap gap-3" lang="ru">{pr.map(([k, v]) => <div class="min-w-[160px] rounded-[16px] bg-page-n px-5 py-4"><dt class="text-[13px] text-soft">{k}</dt><dd class="mt-1 text-[18px] leading-[24px] text-ink-n">{v}</dd></div>)}</dl>
              : <div data-pane={i} hidden={i !== 0} class="prose-stay infra-text text-[15px]" lang="ru" set:html={sanitize(x.html)} />;
          })}
        </div>
      )}
    </div>
  </section>

  <section id="lead" class="container-n mt-20 scroll-mt-28 lg:mt-28">
    <div class="grid overflow-hidden rounded-[24px] bg-ink-n md:grid-cols-2">
      <Img src={gallery[4] ?? gallery[0] ?? hero} alt="" class="aspect-[16/10] size-full md:aspect-auto" width={960} height={600} />
      <div class="p-6 text-white lg:p-10"><LeadForm context={`complex-${c.code}`} title={tb.formTitle} subtitle={tb.formText} submitLabel={tb.formBtn} dark /></div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="container-n mt-20 lg:mt-28" data-car>
      <div class="mb-6 flex items-center justify-between gap-4 lg:mb-8">
        <h2 class="display h-section-n">{tb.seeAlso}</h2>
        {others.length > 2 && <div class="hidden gap-2 lg:flex"><button type="button" class="car-btn" data-car-prev aria-label={tb.prev}><Icon name="arrowLeft" class="size-4" /></button><button type="button" class="car-btn" data-car-next aria-label={tb.next}><Icon name="arrowRight" class="size-4" /></button></div>}
      </div>
      <ul class="scroll-x flex snap-x gap-6" data-car-track>
        {others.map((o) => (
          <li class="w-[86%] shrink-0 snap-start md:w-[calc(50%-12px)]">
