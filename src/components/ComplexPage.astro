  .gal2-lb-btn:hover { transform: scale(1.05); }
  @media (min-width: 1024px) { .gal2-lb-btn { width: 56px; height: 56px; border-radius: 16px; } }
  .gal2-lb-tabs { background: rgb(255 255 255 / .82); backdrop-filter: blur(8px); }
  .tile-btn { position: relative; margin-top: auto; align-self: flex-end; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: #fff; color: var(--color-ink-n); box-shadow: 0 2px 10px rgba(9,7,20,.08); transition: transform .15s; }
  .tile-btn:hover { transform: translateY(-2px); }
  .stub { display: inline-flex; vertical-align: middle; margin-left: 8px; padding: 3px 8px; border-radius: 6px; border: 1px dashed var(--color-line-2); font-family: var(--font-sans); font-size: 11px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; color: var(--color-soft); }
  .fact { display: flex; align-items: center; gap: 12px; }
  .fact-i { display: grid; place-items: center; flex-shrink: 0; width: 56px; height: 56px; border-radius: 16px; background: #d0d1d766; color: var(--color-ink-n); }
  .fact dt { font-size: 14px; line-height: 20px; color: var(--color-soft); }
  .fact dd { font-size: 16px; line-height: 22px; color: var(--color-ink); }
  @media (min-width: 1024px) {
    .fact-i { width: 50px; height: 50px; border-radius: 12px; }
    .fact dt, .fact dd { font-size: 11px; font-weight: 500; line-height: 13px; letter-spacing: 1px; text-transform: uppercase; }
    .fact dd { margin-top: 4px; }
  }
  .complex-intro { font-size: 16px; line-height: 24px; letter-spacing: .1px; }
  .complex-intro.clamp { max-height: 144px; overflow: hidden; -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); }
  .photo-card { position: relative; display: block; overflow: hidden; border-radius: 24px; background: var(--color-ink); color: #fff; }
  .photo-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(9,7,20,.55), transparent 45%); }
  .photo-card-top { position: absolute; z-index: 1; left: 24px; top: 24px; right: 24px; }
  .infra-text :global(ul) { columns: 2; column-gap: 24px; text-align: left; padding-left: 18px; }
  @media (min-width: 768px) { .infra-text :global(ul) { columns: 3; } }
  .infra-text :global(li) { break-inside: avoid; }
  .chip-n.is-on { background: var(--color-ink-n); color: #fff; }
  .car-btn { place-items: center; width: 44px; height: 44px; border-radius: 12px; background: #fff; color: var(--color-ink-n); box-shadow: var(--shadow-btn); }
  .car-btn:hover { background: var(--color-page-n); }
  .seg > button { cursor: pointer; }
  .fact-dark { background: var(--color-ink-n); color: #fff; }
  .fact-sub { display: block; margin-top: 2px; color: var(--color-soft); }
  .fact-chip { display: inline-flex; margin-left: 8px; border-radius: 999px; background: #d0d1d766; padding: 2px 8px; color: var(--color-ink-n); }
  .fact-chip:hover { background: var(--color-ink-n); color: #fff; }
  /* Форма: край фото дугой и мягкое затемнение к форме (как у образца). */
  .lead-photo { overflow: hidden; }
  .lead-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 55%, var(--color-ink-n)); }
  .lead-photo :global(img), .lead-art { clip-path: ellipse(140% 100% at 50% 0%); }
  .lead-art { background: radial-gradient(120% 90% at 30% 20%, #8d70ff 0%, var(--color-accent, #6b4bd8) 45%, #4a2fb8 100%); }
  @media (min-width: 768px) {
    .lead-photo::after { background: linear-gradient(to right, transparent 55%, var(--color-ink-n) 98%); }
    .lead-photo :global(img), .lead-art { clip-path: ellipse(100% 140% at 0% 50%); }
  }
  .seg { display: inline-flex; gap: 2px; border-radius: 999px; background: #fff; padding: 4px; box-shadow: 0 2px 12px rgba(9,7,20,.06); }
  .seg button { border-radius: 999px; padding: 10px 14px; font-size: 11px; font-weight: 600; letter-spacing: .6px; text-transform: uppercase; color: #8e9099; white-space: nowrap; transition: background .2s, color .2s, box-shadow .2s; }
  .seg button[aria-selected='true'] { background: #fff; color: var(--color-ink-n); box-shadow: 0 2px 10px rgba(9,7,20,.16); }
  .prog-arrow { position: absolute; top: calc(50% - 26px); z-index: 1; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: rgba(30,30,36,.72); color: #fff; backdrop-filter: blur(6px); transition: background .2s; }
  .prog-arrow:hover { background: rgba(30,30,36,.9); }
  .prog-arrow:disabled { opacity: .35; cursor: default; }
  .prog-y { margin-top: -1px; min-width: 40px; border-top: 1px solid #8e9099; padding-top: 12px; font-size: 16px; line-height: 20px; color: #8e9099; }
  .prog-y[aria-selected='true'] { border-top-color: var(--color-ink-n); color: var(--color-ink-n); }
  .prog-m { min-width: 52px; flex: 1; margin-top: -1px; border-top: 2px solid transparent; padding: 12px 4px 0; text-align: center; font-size: 11px; line-height: 16px; color: #6f717c; }
  .prog-m:disabled { color: #c3c4cc; cursor: default; }
  .prog-m:not(:disabled):hover { color: var(--color-ink-n); }
  .prog-m[aria-pressed='true'] { border-top-color: var(--color-ink-n); color: var(--color-ink-n); font-weight: 500; }
  .news-text summary::-webkit-details-marker { display: none; }
</style>
<script>
  import { mountMap } from '../scripts/map';
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((v) => v.querySelector('button')?.addEventListener('click', () => {
    v.innerHTML = `<iframe class="absolute inset-0 size-full" src="https://www.youtube-nocookie.com/embed/${v.dataset.yt}?autoplay=1&rel=0" title="Video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
  }));
  // 3D-тур открываем только по нажатию (тяжёлый).
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((v) => v.querySelector('button')?.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.className = 'absolute inset-0 size-full'; f.src = v.dataset.tour!; f.title = '3D'; f.allow = 'fullscreen; xr-spatial-tracking'; f.allowFullscreen = true;
    v.replaceChildren(f);
  }));
  // Ход строительства: вид (фото / трансляция / видео), год и месяц на шкале.
  document.querySelectorAll<HTMLElement>('[data-prog]').forEach((box) => {
    const views = [...box.querySelectorAll<HTMLElement>('[data-prog-view]')];
    views.forEach((b) => b.addEventListener('click', () => {
      views.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      box.querySelectorAll<HTMLElement>('[data-prog-pane]').forEach((pn) => { pn.hidden = pn.dataset.progPane !== b.dataset.progView; });
    }));
    const pick = (m: string) => {
      box.querySelectorAll<HTMLElement>('[data-prog-month-pane]').forEach((pn) => { pn.hidden = pn.dataset.progMonthPane !== m; });
      box.querySelectorAll<HTMLElement>('[data-prog-month]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.progMonth === m)));
    };
    box.querySelectorAll<HTMLButtonElement>('[data-prog-month]').forEach((b) => b.addEventListener('click', () => pick(b.dataset.progMonth!)));
    // Стрелки листают на ширину видимой части — ровно два фото; в начале «назад» неактивна, в конце — «вперёд».
    box.querySelectorAll<HTMLElement>('[data-prog-month-pane]').forEach((pn) => {
      const track = pn.querySelector<HTMLElement>('[data-prog-track]');
      const btns = [...pn.querySelectorAll<HTMLButtonElement>('[data-prog-step]')];
      if (!track || !btns.length) return;
      const gap = () => parseFloat(getComputedStyle(track).columnGap) || 0;
      const sync = () => btns.forEach((b) => { b.disabled = b.dataset.progStep === '-1' ? track.scrollLeft <= 2 : track.scrollLeft + track.clientWidth >= track.scrollWidth - 2; });
      btns.forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.progStep) * (track.clientWidth + gap()), behavior: 'smooth' })));
      track.addEventListener('scroll', sync, { passive: true });
      new ResizeObserver(sync).observe(track);
      sync();
    });
    box.querySelectorAll<HTMLElement>('[data-prog-year]').forEach((b) => b.addEventListener('click', () => {
      const y = b.dataset.progYear!;
      box.querySelectorAll<HTMLElement>('[data-prog-year]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      box.querySelectorAll<HTMLElement>('[data-prog-row]').forEach((r) => { r.hidden = r.dataset.progRow !== y; });
      const last = [...box.querySelectorAll<HTMLButtonElement>(`[data-prog-row="${y}"] [data-prog-month]:not(:disabled)`)].pop();
      if (last) pick(last.dataset.progMonth!);
    }));
  });
  // Галерея-карусель (как у ЖК МИРА): стрелки и вкладки листают к фото по центру, вкладка подсвечивается по текущему фото;
  // «на весь экран» — крупное фото со стрелками, ←/→, свайпом; Esc и клик по фону закрывают.
  document.querySelectorAll<HTMLElement>('[data-gal2]').forEach((box) => {
    const track = box.querySelector<HTMLElement>('[data-gal2-track]')!;
    const slides = [...box.querySelectorAll<HTMLElement>('[data-gal2-slide]')];
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-gal2-tab]')];
    const center = (el: HTMLElement) => el.offsetLeft - track.offsetLeft + el.offsetWidth / 2 - track.clientWidth / 2;
    const current = () => { const mid = track.scrollLeft; let best = 0, dist = Infinity; slides.forEach((el, i) => { const dd = Math.abs(center(el) - mid); if (dd < dist) { dist = dd; best = i; } }); return best; };
    const goTo = (i: number, smooth = true) => { const n = (i + slides.length) % slides.length; track.scrollTo({ left: center(slides[n]), behavior: smooth ? 'smooth' : 'auto' }); };
    const markTab = () => { const g = slides[current()]?.dataset.g; tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.gal2Tab === g))); };
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(markTab); }, { passive: true });
    box.querySelectorAll<HTMLButtonElement>('[data-gal2-step]').forEach((b) => b.addEventListener('click', () => goTo(current() + Number(b.dataset.gal2Step))));
    tabs.forEach((t) => t.addEventListener('click', () => { const i = slides.findIndex((el) => el.dataset.g === t.dataset.gal2Tab); if (i >= 0) goTo(i); }));
    requestAnimationFrame(() => goTo(0, false));
    // На весь экран: сразу то, что уже на экране, затем исходный файл.
    const lb = box.querySelector<HTMLDialogElement>('[data-gal2-lb]')!;
    const lbImg = box.querySelector<HTMLImageElement>('[data-gal2-lb-img]')!;
    const lbCount = box.querySelector<HTMLElement>('[data-gal2-lb-count]')!;
    let at = 0;
    const showLb = (i: number) => {
      at = (i + slides.length) % slides.length;
      const el = slides[at];
      const shown = el.querySelector('img');
      lbImg.src = shown?.currentSrc || shown?.src || el.dataset.src!;
      lbImg.alt = shown?.alt ?? '';
      const big = new Image();
      big.onload = () => { if (slides[at] === el) lbImg.src = big.src; };
      big.src = el.dataset.src!.replace(/([^:])\/\/+/g, '$1/');
      const g = el.dataset.g!;
      const inG = slides.filter((x) => x.dataset.g === g);
      const pad = (n: number) => String(n).padStart(2, '0');
      lbCount.innerHTML = `${pad(inG.indexOf(el) + 1)}<span style="opacity:.6"> / ${pad(inG.length)}</span>`;
      box.querySelectorAll<HTMLElement>('[data-gal2-lb-tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.gal2LbTab === g)));
    };
    slides.forEach((el, i) => el.querySelectorAll('[data-gal2-open]').forEach((b) => b.addEventListener('click', () => { showLb(i); lb.showModal(); document.documentElement.style.overflow = 'hidden'; })));
    lb.addEventListener('close', () => { document.documentElement.style.overflow = ''; goTo(at, false); });
    lb.addEventListener('click', (e) => { if (e.target === lb || e.target === box.querySelector('[data-gal2-lb-stage]')) lb.close(); });
    box.querySelector('[data-gal2-lb-close]')?.addEventListener('click', () => lb.close());
    box.querySelectorAll<HTMLElement>('[data-gal2-lb-tab]').forEach((t) => t.addEventListener('click', () => { const i = slides.findIndex((el) => el.dataset.g === t.dataset.gal2LbTab); if (i >= 0) showLb(i); }));
    box.querySelectorAll<HTMLButtonElement>('[data-gal2-lb-step]').forEach((b) => b.addEventListener('click', () => showLb(at + Number(b.dataset.gal2LbStep))));
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') { showLb(at - 1); e.preventDefault(); } if (e.key === 'ArrowRight') { showLb(at + 1); e.preventDefault(); } });
    let x0 = 0, y0 = 0;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) showLb(at + (dx < 0 ? 1 : -1)); });
  });
  const mapEl = document.querySelector<HTMLElement>('[data-map]');
  if (mapEl) {
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); mountMap(mapEl); } }, { rootMargin: '200px' });
    io.observe(mapEl);
  }
  // Карусели: стрелки листают ленту на ширину видимой части.
  document.querySelectorAll<HTMLElement>('[data-car]').forEach((car) => {
    const track = car.querySelector<HTMLElement>('[data-car-track]');
    if (!track) return;
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: 'smooth' });
    car.querySelectorAll('[data-car-prev]').forEach((b) => b.addEventListener('click', () => go(-1)));
    car.querySelectorAll('[data-car-next]').forEach((b) => b.addEventListener('click', () => go(1)));
    car.closest('section')?.querySelectorAll<HTMLElement>('[data-jump]').forEach((b) => b.addEventListener('click', () => {
      const slide = track.children[Number(b.dataset.jump)] as HTMLElement | undefined;
      if (slide) track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
      b.parentElement?.querySelectorAll('[data-jump]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    }));
  });
  // Вкладки внутри блока: кнопка data-tab показывает панель data-pane с тем же номером.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      box.querySelectorAll<HTMLElement>('[data-tab]').forEach((x) => { x.classList.toggle('is-on', x === b); if (x.hasAttribute('aria-selected')) x.setAttribute('aria-selected', String(x === b)); });
      box.querySelectorAll<HTMLElement>('[data-pane]').forEach((pn) => { pn.hidden = pn.dataset.pane !== b.dataset.tab; });
    }));
  });
  // «Подробнее» на фото «О проекте» открывает карточки инфраструктуры.
  document.querySelectorAll<HTMLElement>('[data-more-infra]').forEach((b) => b.addEventListener('click', () => {
    const box = b.closest('section')?.querySelector<HTMLElement>('[data-infra]'); box?.classList.remove('hidden'); b.remove(); box?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }));
  // Карточка планировки открывает список её квартир; закрытие — крестик или клик по фону.
  document.querySelectorAll<HTMLElement>('[data-grp]').forEach((b) => b.addEventListener('click', () => {
    (document.getElementById(b.dataset.grp!) as HTMLDialogElement | null)?.showModal();
  }));
  document.querySelectorAll<HTMLDialogElement>('dialog.grp-dlg').forEach((dl) => {
    dl.addEventListener('click', (e) => { if (e.target === dl || (e.target as HTMLElement).closest('[data-grp-close]')) dl.close(); });
  });
  // «Подробнее» под описанием комплекса раскрывает весь текст.
  document.querySelectorAll<HTMLElement>('[data-more]').forEach((b) => b.addEventListener('click', () => {
    b.parentElement?.querySelector('[data-clamp]')?.classList.remove('clamp'); b.remove();
  }));
</script>
