<style>
  .stub { display: inline-flex; vertical-align: middle; margin-left: 8px; padding: 3px 8px; border-radius: 6px; border: 1px dashed var(--color-line-2); font-family: var(--font-sans); font-size: 11px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; color: var(--color-soft); }
  .fact { display: flex; align-items: center; gap: 12px; }
  .fact-i { display: grid; place-items: center; flex-shrink: 0; width: 56px; height: 56px; border-radius: 16px; background: #d0d1d766; color: var(--color-ink-n); }
  .fact dt { font-size: 14px; line-height: 20px; color: var(--color-soft); }
  .fact dd { font-size: 16px; line-height: 22px; color: var(--color-ink); }
  @media (min-width: 1024px) {
    .fact-i { width: 50px; height: 50px; border-radius: 12px; }
    .fact dt, .fact dd { font-size: 11px; font-weight: 500; line-height: 13px; letter-spacing: 1px; text-transform: uppercase; }
    .fact dd { margin-top: 4px; }
  }
  .complex-intro { font-size: 16px; line-height: 24px; letter-spacing: .1px; }
  .complex-intro.clamp { max-height: 144px; overflow: hidden; -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); }
  .about-text { font-size: 16px; line-height: 24px; max-height: 120px; overflow: hidden; -webkit-mask-image: linear-gradient(#000 55%, transparent); mask-image: linear-gradient(#000 55%, transparent); }
  .photo-card { position: relative; display: block; overflow: hidden; border-radius: 24px; background: var(--color-ink); color: #fff; }
  .photo-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(9,7,20,.55), transparent 45%); }
  .photo-card-top { position: absolute; z-index: 1; left: 24px; top: 24px; right: 24px; }
  .infra-text :global(ul) { columns: 2; column-gap: 24px; text-align: left; padding-left: 18px; }
  @media (min-width: 768px) { .infra-text :global(ul) { columns: 3; } }
  .infra-text :global(li) { break-inside: avoid; }
  .chip-n.is-on { background: var(--color-ink-n); color: #fff; }
  .car-btn { place-items: center; width: 44px; height: 44px; border-radius: 12px; background: #fff; color: var(--color-ink-n); box-shadow: var(--shadow-btn); }
  .car-btn:hover { background: var(--color-page-n); }
  .seg > button { cursor: pointer; }
  .fact-dark { background: var(--color-ink-n); color: #fff; }
</style>
<script>
  import { mountMap } from '../scripts/map';
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((v) => v.querySelector('button')?.addEventListener('click', () => {
    v.innerHTML = `<iframe class="absolute inset-0 size-full" src="https://www.youtube-nocookie.com/embed/${v.dataset.yt}?autoplay=1&rel=0" title="Video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
  }));
  const mapEl = document.querySelector<HTMLElement>('[data-map]');
  if (mapEl) {
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); mountMap(mapEl); } }, { rootMargin: '200px' });
    io.observe(mapEl);
  }
  // Карусели: стрелки листают ленту на ширину видимой части.
  document.querySelectorAll<HTMLElement>('[data-car]').forEach((car) => {
    const track = car.querySelector<HTMLElement>('[data-car-track]');
    if (!track) return;
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: 'smooth' });
    car.querySelectorAll('[data-car-prev]').forEach((b) => b.addEventListener('click', () => go(-1)));
    car.querySelectorAll('[data-car-next]').forEach((b) => b.addEventListener('click', () => go(1)));
    car.closest('section')?.querySelectorAll<HTMLElement>('[data-jump]').forEach((b) => b.addEventListener('click', () => {
      const slide = track.children[Number(b.dataset.jump)] as HTMLElement | undefined;
      if (slide) track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
      b.parentElement?.querySelectorAll('[data-jump]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    }));
  });
  // Вкладки внутри блока: кнопка data-tab показывает панель data-pane с тем же номером.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      box.querySelectorAll<HTMLElement>('[data-tab]').forEach((x) => { x.classList.toggle('is-on', x === b); if (x.hasAttribute('aria-selected')) x.setAttribute('aria-selected', String(x === b)); });
      box.querySelectorAll<HTMLElement>('[data-pane]').forEach((pn) => { pn.hidden = pn.dataset.pane !== b.dataset.tab; });
    }));
  });
  // «Подробнее» на фото «О проекте» открывает карточки инфраструктуры.
  document.querySelectorAll<HTMLElement>('[data-more-infra]').forEach((b) => b.addEventListener('click', () => {
    const box = b.closest('section')?.querySelector<HTMLElement>('[data-infra]'); box?.classList.remove('hidden'); b.remove(); box?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }));
  // «Подробнее» под описанием комплекса раскрывает весь текст.
  document.querySelectorAll<HTMLElement>('[data-more]').forEach((b) => b.addEventListener('click', () => {
    b.parentElement?.querySelector('[data-clamp]')?.classList.remove('clamp'); b.remove();
  }));
</script>
