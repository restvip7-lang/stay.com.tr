          {hero && <Img src={hero} alt="" class="absolute inset-0 size-full opacity-50" width={1280} height={720} />}
          <div class="relative px-6 text-center text-white">
            <p class="inline-flex items-center gap-2 text-[14px] uppercase tracking-[1px]"><span class="size-2 rounded-full bg-[#e5304f]" aria-hidden="true"></span>Live</p>
            {liveUrl ? <a href={liveUrl} target="_blank" rel="noopener" class="btn-n btn-n-white mt-4 gap-2">{N.liveOpen}<Icon name="arrowUpRight" class="size-4" /></a>
              : <p class="mt-3 max-w-[420px] text-[16px] leading-[24px] text-white/85">{N.liveSoon}</p>}
          </div>
        </div>
      </div>
    )}
    {ytId && (
      <div data-prog-pane="video" hidden>
        <div class="relative aspect-[16/9] overflow-hidden rounded-[20px] bg-ink md:aspect-[1240/560]" data-yt={ytId}>
          <button type="button" class="group absolute inset-0 grid place-items-center" aria-label={N.video}>
            <img src={`https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" class="absolute inset-0 size-full object-cover opacity-80" />
            <span class="relative grid size-14 place-items-center rounded-[16px] bg-white text-ink shadow-lg"><Icon name="play" class="size-6" /></span>
          </button>
        </div>
      </div>
    )}
  </section>
  )}

  {news.length > 0 && (
  <section class="container-n mt-20 lg:mt-28" data-car>
    {/* Новости проекта: заводит сотрудник в админке; три последние по дате. */}
    <div class="mb-6 flex items-center justify-between gap-4 lg:mb-8">
      <h2 class="display h-section-n">{tb.news}{!newsReal.length && <> <span class="stub">{N.example}</span></>}</h2>
      {news.length > 3 && <div class="hidden gap-2 lg:flex"><button type="button" class="car-btn" data-car-prev aria-label={tb.prev}><Icon name="arrowLeft" class="size-4" /></button><button type="button" class="car-btn" data-car-next aria-label={tb.next}><Icon name="arrowRight" class="size-4" /></button></div>}
    </div>
    <ul class="scroll-x flex snap-x gap-6" data-car-track>
      {news.map((x) => (
        <li class="flex w-[84%] shrink-0 snap-start flex-col overflow-hidden rounded-[24px] bg-white md:w-[calc((100%-48px)/3)]">
          {x.image && <Img src={x.image} alt="" class="aspect-[16/10] w-full" width={560} height={350} />}
          <div class="flex flex-1 flex-col gap-3 p-6">
            <span class="text-[11px] font-medium uppercase tracking-[1px] text-soft">{x.date}</span>
            <span class="text-[20px] leading-[26px] text-ink-n">{x.title}</span>
            {x.text && (x.text.length > 140
              ? <details class="news-text group text-[15px] leading-[22px] text-soft"><summary class="cursor-pointer list-none"><span class="line-clamp-3 group-open:line-clamp-none">{x.text}</span><span class="mt-2 block text-[14px] text-accent group-open:hidden">{N.readMore}</span></summary></details>
              : <p class="text-[15px] leading-[22px] text-soft">{x.text}</p>)}
          </div>
        </li>
      ))}
    </ul>
  </section>
  )}

  <section id="viewing" class="panel mt-20 scroll-mt-24 py-12 lg:mt-28 lg:py-20" data-tabs>
    <div class="container-n">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4 lg:mb-8">
        <h2 class="display h-section-n">{tb.contacts}</h2>
        <div class="seg" role="tablist">{tb.contactsTabs.map((x, i) => <button type="button" role="tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>{x}</button>)}</div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        {(p?.lat ?? c.lat) && (p?.lng ?? c.lng) ? <div data-map data-zoom="14" data-points={JSON.stringify([{ t: c.title, u: '', lat: p?.lat ?? c.lat, lng: p?.lng ?? c.lng, a: place }])} class="h-[340px] overflow-hidden rounded-[28px] bg-page-n lg:h-auto lg:min-h-[784px]"></div> : <div class="hidden lg:block"></div>}
        <div class="flex flex-col gap-6">
          <div class="flex flex-1 flex-col gap-2 rounded-[28px] bg-page-n p-6" data-pane="0">
            <p class="display text-[24px] leading-[30px] text-ink-n">{c.title}</p>
            <p class="text-[16px] text-soft">{place}</p>
            {(p?.lat ?? c.lat) && <a href={`https://maps.google.com/?q=${p?.lat ?? c.lat},${p?.lng ?? c.lng}`} target="_blank" rel="noopener" class="text-[16px] text-soft underline-offset-2 hover:underline"><Icon name="pin" class="mr-1 inline size-4" />Google Maps</a>}
            <div class="mt-auto flex flex-col gap-2 pt-8 text-[16px] text-ink-n"><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.phone.href}>{site.phone.label}</a></div>
          </div>
          <div class="flex flex-1 flex-col gap-2 rounded-[28px] bg-page-n p-6" data-pane="1" hidden>
            {/* Офис продаж — Аланийский для всех ЖК (Anuar 28.11.2026), данные со страницы «Контакты». */}
            <p class="display text-[24px] leading-[30px] text-ink-n">{N.office}</p>
            <p class="text-[16px] text-soft">{office.address}</p>
            <p class="text-[16px]"><span class="text-soft">{N.hours}:</span> {N.hoursText}</p>
            <a href={`https://www.google.com/maps/dir/?api=1&destination=${office.lat},${office.lng}`} target="_blank" rel="noopener" class="text-[16px] text-soft underline-offset-2 hover:underline"><Icon name="pin" class="mr-1 inline size-4" />Google Maps</a>
            <div class="mt-auto flex flex-col gap-2 pt-8 text-[16px] text-ink-n"><a href={`mailto:${office.email}`}>{office.email}</a><a href={officeTel}>{officePhone}</a>{office.wa && <a href={`https://wa.me/${office.wa}`} target="_blank" rel="noopener" class="text-accent">{N.write}</a>}</div>
          </div>
          <div class="rounded-[24px] bg-ink-n p-6 text-white"><LeadForm context={`complex-${c.code}-viewing`} title={tb.callback} subtitle={tb.callbackText} submitLabel={tb.send} headingLevel="p" dark /></div>
        </div>
      </div>
    </div>
  </section>

</Base>
<style>
  .tile-sq { position: relative; display: flex; min-height: 240px; flex-direction: column; border-radius: 24px; padding: 24px; }
  @media (min-width: 768px) { .tile-sq { aspect-ratio: 397 / 476; min-height: 0; } }
  /* Плиток меньше трёх — не растягиваем их в высоту: низкие широкие карточки. */
  @media (min-width: 768px) { .tiles-low .tile-sq { aspect-ratio: auto; min-height: 200px; } .tiles-one .tile-sq { min-height: 150px; } }
  .gal2-track { scrollbar-width: none; padding-inline: 5vw; scroll-padding-inline: 5vw; }
  .gal2-track::-webkit-scrollbar { display: none; }
  .gal2-slide { width: 90vw; }
  @media (min-width: 1024px) { .gal2-track { padding-inline: 10vw; scroll-padding-inline: 10vw; } .gal2-slide { width: 80vw; } }
  .gal2-arrow { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; color: #fff; background: rgb(28 30 38 / .55); backdrop-filter: blur(6px); transition: background .2s; }
