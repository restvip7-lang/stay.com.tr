          <p class="text-[20px] leading-[26px] text-ink-n">{tb.tiles.live}<span class="ml-0.5 inline-block size-1.5 -translate-y-2 rounded-full bg-[#e5304f]" aria-hidden="true"></span></p>
          <p class="mt-1.5 max-w-[260px] text-[15px] leading-[21px] text-soft">{tb.tiles.liveText}</p>
