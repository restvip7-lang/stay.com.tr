---
/**
 * Каретта — талисман Stay Property. Морская черепаха-каретта (Caretta caretta)
 * живёт и откладывает яйца на пляжах Антальи и Аланьи. Панцирь в фирменном
 * фиолетовом, кожа мятная, на голове морская кепка.
 */
interface Props { size?: number; class?: string; wave?: boolean }
const { size = 64, class: cls, wave = false } = Astro.props;
---
<svg viewBox="0 0 120 120" width={size} height={size} class:list={['mascot', wave && 'mascot-wave', cls]} aria-hidden="true">
  <!-- задние ласты -->
  <ellipse cx="39" cy="106" rx="11" ry="6.5" fill="#6cc79c" />
  <ellipse cx="81" cy="106" rx="11" ry="6.5" fill="#6cc79c" />
  <!-- панцирь: край со щитками -->
  <ellipse cx="60" cy="78" rx="42" ry="35" fill="#4b32c9" />
  <ellipse cx="60" cy="77" rx="40" ry="33" fill="#754be9" />
  <g stroke="#a993ff" stroke-width="2.6" stroke-linecap="round" fill="none">
    <ellipse cx="60" cy="78" rx="31" ry="25" />
    <path d="M29 78 h-10 M91 78 h10 M35 62 l-8 -7 M85 62 l8 -7 M35 94 l-8 7 M85 94 l8 7" />
  </g>
  <!-- брюшной щит -->
  <ellipse cx="60" cy="86" rx="21" ry="19" fill="#fbecc0" />
  <path d="M60 68 v36 M42 80 h36 M43 92 h34" stroke="#e8cf8a" stroke-width="2" stroke-linecap="round" />
  <!-- левая ласта -->
  <ellipse cx="23" cy="82" rx="13" ry="7" transform="rotate(-20 23 82)" fill="#8fdcb6" />
  <!-- правая ласта (машет) -->
  <g class="mascot-flipper">
    <ellipse cx="97" cy="70" rx="13" ry="7" transform="rotate(-50 97 70)" fill="#8fdcb6" />
  </g>
  <!-- голова -->
  <ellipse cx="60" cy="43" rx="29" ry="25" fill="#8fdcb6" />
  <g fill="#6cc79c">
    <ellipse cx="44" cy="27" rx="4" ry="3" />
    <ellipse cx="78" cy="29" rx="3.5" ry="2.6" />
    <ellipse cx="36" cy="38" rx="2.6" ry="2" />
    <ellipse cx="85" cy="40" rx="2.6" ry="2" />
  </g>
  <!-- морская кепка -->
  <g transform="rotate(-12 60 22)">
    <path d="M41 23 Q60 1 79 23 Z" fill="#fff" stroke="#c9c2f5" stroke-width="1.5" stroke-linejoin="round" />
    <rect x="40" y="19.5" width="40" height="6" rx="3" fill="#090714" />
    <path d="M41 24 q-9 0 -13 5 q11 0 16 -3 z" fill="#090714" />
    <circle cx="60" cy="9.5" r="2.4" fill="#754be9" />
    <path d="M55 22.5 h10" stroke="#d9d7ff" stroke-width="2" stroke-linecap="round" />
  </g>
  <!-- глаза -->
  <g class="mascot-eyes">
    <ellipse cx="48" cy="44" rx="8" ry="9" fill="#fff" />
    <ellipse cx="72" cy="44" rx="8" ry="9" fill="#fff" />
    <circle cx="49.5" cy="45.5" r="5" fill="#090714" />
    <circle cx="70.5" cy="45.5" r="5" fill="#090714" />
    <circle cx="51.3" cy="43.4" r="1.8" fill="#fff" />
    <circle cx="72.3" cy="43.4" r="1.8" fill="#fff" />
  </g>
  <!-- щёки и улыбка -->
  <ellipse cx="38" cy="54" rx="5" ry="3" fill="#ff7f9e" opacity=".45" />
  <ellipse cx="82" cy="54" rx="5" ry="3" fill="#ff7f9e" opacity=".45" />
  <path d="M50 56 q10 8 20 0" fill="none" stroke="#090714" stroke-width="2.4" stroke-linecap="round" />
</svg>

<style is:global>
  .mascot { display: block; overflow: visible; }
  .mascot-wave .mascot-flipper { transform-origin: 88px 76px; animation: mascot-wave 2.4s ease-in-out infinite; }
  .mascot-eyes { transform-origin: 60px 45px; animation: mascot-blink 5s infinite; }
  @keyframes mascot-wave { 0%, 60%, 100% { transform: rotate(0deg); } 70% { transform: rotate(-22deg); } 80% { transform: rotate(6deg); } 90% { transform: rotate(-16deg); } }
  @keyframes mascot-blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(.1); } }
</style>
