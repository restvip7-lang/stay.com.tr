---
import Base from '../layouts/Base.astro';
import FilterForm from './FilterForm.astro';
import SaleCard from './SaleCard.astro';
import Pagination from './Pagination.astro';
import { searchListings } from '../lib/api';
import { parseQuery } from '../lib/query';
import Icon from './Icon.astro';

interface Props { operation: 'sale' | 'rental'; title: string; description: string }
const { operation, title, description } = Astro.props;
const q = parseQuery(Astro.url.searchParams, operation);
const res = await searchListings(q);
const sort = q.sort ?? 'new';
const sortHref = (s: string) => {
  const u = new URL(Astro.url);
  u.searchParams.delete('page');
  if (s === 'new') u.searchParams.delete('sort'); else u.searchParams.set('sort', s);
  return u.pathname + u.search;
};
const pageHref = (p: number) => {
  const u = new URL(Astro.url);
  u.searchParams.set('page', String(p));
  return u.pathname + u.search;
};
---
<Base title={title} description={description}>
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page">{title}</h1>
    <div class="mt-10 md:mt-14"><FilterForm action={Astro.url.pathname} operation={operation} query={q} tabs={operation === 'sale'} catalog /></div>
  </section>
  <section class="mt-12 bg-white/60 py-10 md:mt-16 md:py-14">
    <div class="container-x transition-opacity" data-results>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <nav class="flex flex-wrap gap-2 text-sm" aria-label="Сортировка">
          {[['new', 'Сначала новые'], ['price-asc', 'Дешевле'], ['price-desc', 'Дороже'], ['area-desc', 'Больше площадь'], ['sea-asc', 'Ближе к морю']].map(([k, l]) => (
            <a href={sortHref(k)} class:list={['chip px-4 py-2', sort === k && '!border-ink !bg-ink text-white']}>{l}</a>
          ))}
        </nav>
        <div class="flex gap-1 rounded-full border border-line bg-white p-1" role="group" aria-label="Вид выдачи">
          <button type="button" data-layout="grid" class="view-btn" aria-label="Плиткой" title="Плиткой"><Icon name="grid" /></button>
          <button type="button" data-layout="list" class="view-btn" aria-label="Списком" title="Списком"><Icon name="list" /></button>
        </div>
      </div>
      {res.items.length ? (
        <div data-grid class="results-grid grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{res.items.map((x) => <SaleCard x={x} />)}</div>
      ) : (
        <div class="card p-10 text-center">
          <p class="display text-2xl">Ничего не нашлось</p>
          <p class="mt-2 text-muted">Попробуйте изменить фильтр или оставьте заявку — подберём вручную.</p>
          <div class="mt-6 flex justify-center gap-3"><a href={Astro.url.pathname} class="btn btn-ghost">Сбросить фильтр</a><a href="#" data-lead-open class="btn btn-accent">Оставить заявку</a></div>
        </div>
      )}
      {res.page < res.pages && (
        <div class="mt-10 flex justify-center"><a href={pageHref(res.page + 1)} data-more class="btn btn-ghost min-w-[240px]">Показать ещё</a></div>
      )}
      <div data-pager><Pagination page={res.page} pages={res.pages} url={Astro.url} /></div>
    </div>
  </section>
</Base>

<style is:global>
  .view-btn { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--color-muted); }
  .view-btn[aria-pressed="true"] { background: var(--color-ink); color: #fff; }
  .view-list .results-grid { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) {
    .view-list .sale-card { display: grid; grid-template-columns: 300px minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 8px; }
    .view-list .sc-img { grid-row: 1 / 3; grid-column: 1; }
    .view-list .sc-head { grid-column: 2; grid-row: 1; }
    .view-list .sc-body { grid-column: 2; grid-row: 2; }
    .view-list .sc-fav { top: 20px; left: 252px; right: auto; }
  }
</style>
<script>
  import { syncFavorites } from '../scripts/client';
  const KEY = 'stay-view';
  const setView = (v: string) => {
    document.documentElement.classList.toggle('view-list', v === 'list');
    document.querySelectorAll<HTMLElement>('[data-layout]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layout === v)));
    try { localStorage.setItem(KEY, v); } catch { /* */ }
  };
  let saved = 'grid';
  try { saved = localStorage.getItem(KEY) || 'grid'; } catch { /* */ }
  setView(saved);
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const v = t.closest<HTMLElement>('[data-layout]');
    if (v) { setView(v.dataset.layout!); return; }
    // «Показать ещё»: дозагружаем следующую страницу под текущими карточками.
    const more = t.closest<HTMLAnchorElement>('[data-more]');
    if (!more) return;
    e.preventDefault();
    more.textContent = 'Загружаю…';
    try {
      const doc = new DOMParser().parseFromString(await (await fetch(more.href)).text(), 'text/html');
      document.querySelector('[data-grid]')?.append(...doc.querySelectorAll('[data-grid] > *'));
      const pager = document.querySelector('[data-pager]');
      const nextPager = doc.querySelector('[data-pager]');
      if (pager && nextPager) pager.innerHTML = nextPager.innerHTML;
      const nextMore = doc.querySelector<HTMLAnchorElement>('[data-more]');
      if (nextMore) { more.href = nextMore.href; more.textContent = 'Показать ещё'; } else more.parentElement?.remove();
      syncFavorites();
    } catch { location.href = more.href; }
  });
  document.addEventListener('results:updated', () => { setView(document.documentElement.classList.contains('view-list') ? 'list' : 'grid'); syncFavorites(); });
</script>
