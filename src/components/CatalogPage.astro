---
import Base from '../layouts/Base.astro';
import FilterForm from './FilterForm.astro';
import SaleCard from './SaleCard.astro';
import Pagination from './Pagination.astro';
import { searchListings } from '../lib/api';
import { parseQuery } from '../lib/query';
import { num, plural } from '../lib/format';

interface Props { operation: 'sale' | 'rental'; title: string; description: string }
const { operation, title, description } = Astro.props;
const q = parseQuery(Astro.url.searchParams, operation);
const res = await searchListings(q);
const sort = q.sort ?? 'new';
const sortHref = (s: string) => {
  const u = new URL(Astro.url);
  u.searchParams.delete('page');
  if (s === 'new') u.searchParams.delete('sort'); else u.searchParams.set('sort', s);
  return u.pathname + u.search;
};
---
<Base title={title} description={description}>
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page">{title}</h1>
    <div class="mt-10 md:mt-14"><FilterForm action={Astro.url.pathname} operation={operation} query={q} tabs={operation === 'sale'} /></div>
  </section>
  <section class="mt-12 bg-white/60 py-10 md:mt-16 md:py-14">
    <div class="container-x">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <p class="text-muted">Найдено {num(res.total)} {plural(res.total, ['объект', 'объекта', 'объектов'])}</p>
        <nav class="flex gap-2 text-sm" aria-label="Сортировка">
          {[['new', 'Сначала новые'], ['price-asc', 'Дешевле'], ['price-desc', 'Дороже']].map(([k, l]) => (
            <a href={sortHref(k)} class:list={['chip px-4 py-2', sort === k && '!border-ink !bg-ink text-white']}>{l}</a>
          ))}
        </nav>
      </div>
      {res.items.length ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{res.items.map((x) => <SaleCard x={x} />)}</div>
      ) : (
        <div class="card p-10 text-center">
          <p class="display text-2xl">Ничего не нашлось</p>
          <p class="mt-2 text-muted">Попробуйте изменить фильтр или оставьте заявку — подберём вручную.</p>
          <div class="mt-6 flex justify-center gap-3"><a href={Astro.url.pathname} class="btn btn-ghost">Сбросить фильтр</a><a href="#" data-lead-open class="btn btn-accent">Оставить заявку</a></div>
        </div>
      )}
      <Pagination page={res.page} pages={res.pages} url={Astro.url} />
    </div>
  </section>
</Base>
