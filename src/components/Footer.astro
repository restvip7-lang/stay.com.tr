---
/**
 * Футер: блоки dev-сайта (заявка, трансляция, приложение, проекты Stay) + мега-футер по ТЗ 6.3:
 * «Недвижимость в Алании» (топ-10 посадочных), «Районы» (топ-10), «Покупателю», контакты и реквизиты.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import { site } from '../lib/site';
import { getHomeConfig } from '../lib/homeConfig';
import { getComplexes, complexUrl } from '../lib/catalog';
import { footerColumns } from '../lib/nav';
import { t } from '../i18n/ui';

const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const home = await getHomeConfig();
const all = await getComplexes().catch(() => []);
const projects = home.projects.map((c) => all.find((p) => p.code === c)).filter(Boolean) as Awaited<ReturnType<typeof getComplexes>>;
const cols = await footerColumns(lang).catch(() => null);
const year = new Date().getFullYear();
---
<footer class="mt-24 md:mt-32">
  <div class="container-x">
    <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)]">
      <div class="card flex flex-col gap-3 p-5 md:p-6">
        <Logo class="mb-4 h-9 w-auto text-ink/40" />
        <a href="#lead" data-lead-open class="btn btn-ghost w-full"><Icon name="user" class="size-4" />{d.getOffer}</a>
        <a href={site.streamUrl} target="_blank" rel="noopener" class="btn btn-ghost w-full"><Icon name="play" class="size-4" />{d.footer.stream}</a>
        <div class="mt-auto rounded-2xl bg-page p-4">
          <p class="text-sm">{d.footer.app}</p>
          <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <a class="chip" href="https://apps.apple.com/" target="_blank" rel="noopener">App Store</a>
            <a class="chip" href="https://play.google.com/store/apps/" target="_blank" rel="noopener">Google Play</a>
            <a class="chip" href="https://appgallery.huawei.ru/app/" target="_blank" rel="noopener">AppGallery</a>
          </div>
        </div>
      </div>
      <div class="card p-5 md:p-6">
        <p class="mb-4 text-sm text-muted">{d.footer.projects}</p>
        <ul class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 xl:grid-cols-4">
          {projects.map((p) => (
            <li>
              <a href={complexUrl(lang, p)} class="group flex items-center gap-3">
                <span class="size-11 shrink-0 overflow-hidden rounded-xl"><Img src={p.image} alt="" class="size-full" width={44} height={44} /></span>
                <span class="text-[13px] leading-tight group-hover:text-accent">{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <!-- Мега-футер и нижняя полоса — на всю ширину экрана. -->
  <div class="mt-3 bg-ink text-white">
    {cols && (
      <div class="container-x grid gap-8 border-b border-white/10 py-10 sm:grid-cols-2 lg:grid-cols-3 md:py-14">
        <nav aria-label={cols.title1}>
          <p class="mb-4 text-base text-white/60">{cols.title1}</p>
          <ul class="space-y-2 text-sm">{cols.landings.map((l) => <li><a href={l.href} class="hover:text-lavender">{l.text}</a></li>)}</ul>
        </nav>
        <nav aria-label={d.footer.districts}>
          <p class="mb-4 text-base text-white/60">{d.footer.districts}</p>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">{cols.districts.map((l) => <li><a href={l.href} class="hover:text-lavender">{l.text}</a></li>)}</ul>
        </nav>
        <nav aria-label={d.footer.buyer}>
          <p class="mb-4 text-base text-white/60">{d.footer.buyer}</p>
          <ul class="space-y-2 text-sm">{cols.buyer.map((l) => <li><a href={l.href} class="hover:text-lavender">{l.text}</a></li>)}</ul>
        </nav>
      </div>
    )}
    <div class="container-x grid gap-8 py-8 md:grid-cols-[1fr_1fr_auto] md:py-12">
      <div class="space-y-3 text-sm text-white/70">
        <p class="text-white">{d.footer.company}</p>
        <p>{site.address}</p>
        <p><a href={`/${lang}/privacy-policy/`} class="text-white hover:text-lavender">{d.footer.privacy}</a></p>
        <p>{d.footer.disclaimer}</p>
        <p>StayProperty. All rights reserved © {year}</p>
      </div>
      <div class="space-y-3 text-sm">
        <p class="text-base text-white/70">{d.footer.contacts}</p>
        {site.phones.map((p, i) => (
          <div><p class="text-white/50">{i === 0 ? d.footer.phoneTR : d.footer.phoneRU}</p><a href={p.href} class="hover:text-lavender">{p.label}</a></div>
        ))}
        <a href={`mailto:${site.email}`} class="block hover:text-lavender">{site.email}</a>
        <div class="flex gap-3 pt-1">
          {site.socials.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="opacity-80 hover:opacity-100"><Icon name={s.name} class="size-5" /></a>)}
        </div>
      </div>
    </div>
  </div>
</footer>

<button type="button" data-to-top class="to-top" aria-label={d.footer.toTop}>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
</button>
<style is:global>
  .to-top { position: fixed; left: 20px; bottom: 24px; z-index: 50; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px; background: #fff; color: var(--color-ink); box-shadow: 0 8px 24px #09071426; opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity .3s, transform .3s, background-color .2s; }
  .to-top.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { background: var(--color-lavender-2); }
</style>
<script>
  const b = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (b) {
    const sync = () => b.classList.toggle('is-on', scrollY > innerHeight * 0.8);
    addEventListener('scroll', sync, { passive: true });
    sync();
    b.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
