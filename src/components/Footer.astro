---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import { site } from '../lib/site';
import { getProjects } from '../lib/api';
import home from '../content/data/home.json';

const all = await getProjects().catch(() => []);
const projects = home.projects.map((c) => all.find((p) => p.code === c)).filter(Boolean) as Awaited<ReturnType<typeof getProjects>>;
const year = new Date().getFullYear();
---
<footer class="mt-24 pb-4 md:mt-32">
  <div class="container-x">
    <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)]">
      <div class="card flex flex-col gap-3 p-5 md:p-6">
        <Logo class="mb-4 h-9 w-auto text-ink/40" />
        <a href="#lead" data-lead-open class="btn btn-ghost w-full"><Icon name="user" class="size-4" />Получить предложение</a>
        <a href={site.streamUrl} target="_blank" rel="noopener" class="btn btn-ghost w-full"><Icon name="play" class="size-4" />Трансляция строительства</a>
        <div class="mt-auto rounded-2xl bg-page p-4">
          <p class="text-sm">Приложение STAY PROPERTY</p>
          <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <a class="chip" href="https://apps.apple.com/" target="_blank" rel="noopener">App Store</a>
            <a class="chip" href="https://play.google.com/store/apps/" target="_blank" rel="noopener">Google Play</a>
            <a class="chip" href="https://appgallery.huawei.ru/app/" target="_blank" rel="noopener">AppGallery</a>
          </div>
        </div>
      </div>
      <div class="card p-5 md:p-6">
        <p class="mb-4 text-sm text-muted">Проекты STAY</p>
        <ul class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 xl:grid-cols-4">
          {projects.map((p) => (
            <li>
              <a href={p.url} class="group flex items-center gap-3">
                <span class="size-11 shrink-0 overflow-hidden rounded-xl"><Img src={p.image} alt="" class="size-full" /></span>
                <span class="text-[13px] leading-tight group-hover:text-accent">{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-3 grid gap-8 rounded-[var(--radius-big)] bg-ink p-6 text-white md:grid-cols-[1fr_1fr_auto] md:p-10">
      <div class="space-y-3 text-sm text-white/70">
        <p>{site.address}</p>
        <p><a href="/privacy-policy/" class="text-white hover:text-lavender">Политика конфиденциальности</a></p>
        <p>Информация на сайте носит справочный характер и не является публичной офертой.</p>
        <p>StayProperty. All rights reserved © {year}</p>
      </div>
      <div class="space-y-3 text-sm">
        <p class="text-base text-white/70">Контакты и соцсети</p>
        {site.phones.map((p) => (
          <div><p class="text-white/50">{p.country}</p><a href={p.href} class="hover:text-lavender">{p.label}</a></div>
        ))}
        <a href={`mailto:${site.email}`} class="block hover:text-lavender">{site.email}</a>
        <div class="flex gap-3 pt-1">
          {site.socials.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="opacity-80 hover:opacity-100"><Icon name={s.name} class="size-5" /></a>)}
        </div>
      </div>
      <a href="#top" class="hidden self-start text-sm text-white/60 hover:text-white md:block">Наверх ↑</a>
    </div>
  </div>
</footer>
