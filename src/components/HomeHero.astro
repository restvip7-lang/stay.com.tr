---
import Img from './Img.astro';
import Icon from './Icon.astro';
import { complexUrl, type Complex } from '../lib/catalog';
import { cityBySlug, districtBySlug } from '../lib/geo';
import { moneyL } from '../lib/format';
import { t } from '../i18n/ui';
/** Слайдер проектов. h1 — заголовок страницы (передаётся сверху), названия проектов — не заголовки. */
interface Props { slides: Complex[]; h1?: string; lead?: string }
const { slides, h1, lead } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const place = (p: Complex) => [p.district ? districtBySlug(p.city, p.district)?.name[lang] : null, cityBySlug(p.city)?.name[lang]].filter(Boolean).join(', ');
---
<section class="relative isolate overflow-hidden bg-ink text-white" data-hero aria-roledescription="carousel" aria-label={d.hp.heroAria}>
  {slides.map((p, i) => (
    <div class:list={['hero-slide absolute inset-0 transition-opacity duration-700', i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0']} data-slide={i} aria-hidden={i !== 0 ? 'true' : undefined}>
      <Img src={p.image} alt={`${p.title} — ${place(p)}`} class="size-full" priority={i === 0} sizes="100vw" width={1920} height={1080} />
      <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/20 to-ink/80"></div>
    </div>
  ))}
  <div class="container-x relative flex min-h-[100svh] flex-col pb-6 pt-32 md:pb-10 md:pt-40">
    {h1 && <h1 class="max-w-3xl text-[clamp(18px,1.6vw,22px)] font-medium leading-snug">{h1}</h1>}
    {lead && <p class="mb-8 mt-2 max-w-2xl text-[15px] text-white/75">{lead}</p>}
    {slides.map((p, i) => (
      <div class:list={['hero-text max-w-4xl transition-opacity duration-500', i === 0 ? '' : 'hidden']} data-text={i}>
        <p class="display h-hero">{p.title}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">{d.hp.stayProjects}</span>
          <span class="chip chip-dark">{place(p)}</span>
          {p.priceFrom && <span class="chip chip-dark">{d.from(moneyL(lang, p.priceFrom))}</span>}
        </div>
        {p.rooms.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">{p.rooms.map((r) => <span class="chip chip-dark">{r}</span>)}</div>
        )}
        {p.action && lang === 'ru' && <p class="mt-5 max-w-md text-white/80">{p.action}</p>}
        <a href={complexUrl(lang, p)} class="btn btn-outline-light mt-8">{d.hp.aboutProject}<span class="sr-only">: {p.title}</span></a>
      </div>
    ))}
    <div class="mt-auto flex items-end gap-3 pt-16">
      <!-- Стрелки как у образца: вокруг «вперёд» идёт контур-таймер, круг замкнулся — следующий слайд. -->
      <div class="hidden shrink-0 flex-col items-center gap-1 rounded-full bg-white/25 p-[5px] backdrop-blur-md md:flex">
        <button type="button" data-next class="hero-next relative grid size-[70px] place-items-center rounded-full bg-white text-muted transition-colors hover:text-ink" aria-label={d.hp.nextProject}>
          {slides.length > 1 && (
            <svg class="hero-ring pointer-events-none absolute inset-0 size-full -rotate-90" viewBox="0 0 70 70" aria-hidden="true">
              <circle cx="35" cy="35" r="34" fill="none" stroke="currentColor" stroke-width="2" pathLength="100" />
            </svg>
          )}
          <Icon name="arrowRight" class="size-5" />
        </button>
        <button type="button" data-prev class="grid size-[70px] place-items-center rounded-full text-white/80 transition-colors hover:bg-white/20 hover:text-white" aria-label={d.hp.prevProject}><Icon name="arrowLeft" class="size-5" /></button>
      </div>
      <div class="scroll-x flex flex-1 gap-3">
        {slides.map((p, i) => (
          <button type="button" data-go={i} class:list={['hero-thumb flex min-w-[240px] flex-1 items-stretch gap-3 overflow-hidden rounded-[var(--radius-card)] bg-white p-2 text-left text-ink transition-shadow', i === 0 && 'is-active']} aria-label={d.hp.showProject(p.title)}>
            <span class="flex flex-1 flex-col justify-between p-2">
              <span class="display text-[15px] leading-tight">{p.title}</span>
              <span class="mt-3 text-xs text-muted">{place(p)}</span>
              {p.priceFrom && <span class="chip chip-accent mt-2 self-start">{d.from(moneyL(lang, p.priceFrom))}</span>}
            </span>
            <span class="w-24 shrink-0 overflow-hidden rounded-[14px]"><Img src={p.image} alt="" class="size-full" width={96} height={96} /></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-thumb.is-active { box-shadow: 0 0 0 2px var(--color-accent); }
  .hero-ring { color: var(--color-accent); }
  .hero-ring circle { stroke-dasharray: 100; stroke-dashoffset: 100; }
  .hero-ring.is-running circle { animation: hero-ring var(--hero-ms, 9000ms) linear forwards; }
  @keyframes hero-ring { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-ring { display: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const texts = [...hero.querySelectorAll<HTMLElement>('[data-text]')];
    const thumbs = [...hero.querySelectorAll<HTMLElement>('[data-go]')];
    let cur = 0;
    const ring = hero.querySelector<SVGElement>('.hero-ring');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const go = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-0', i !== cur);
        s.classList.toggle('pointer-events-none', i !== cur);
        s.toggleAttribute('aria-hidden', i !== cur);
      });
      texts.forEach((t, i) => t.classList.toggle('hidden', i !== cur));
      thumbs.forEach((t, i) => t.classList.toggle('is-active', i === cur));
      restart();
    };
    // Таймер — сама анимация контура (9 с): закончилась — переключаем.
    let timer: number | undefined;
    const restart = () => {
      clearTimeout(timer);
      if (reduced.matches || slides.length < 2) return;
      // На телефоне стрелок нет (контур скрыт и не анимируется) — там обычный таймер на те же 9 с.
      if (!ring || !ring.getClientRects().length) { timer = window.setTimeout(() => go(cur + 1), 9000); return; }
      ring.classList.remove('is-running');
      void ring.getBoundingClientRect();
      ring.classList.add('is-running');
    };
    ring?.addEventListener('animationend', () => go(cur + 1));
    hero.querySelector('[data-next]')?.addEventListener('click', () => go(cur + 1));
    hero.querySelector('[data-prev]')?.addEventListener('click', () => go(cur - 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.go))));
    restart();
  });
</script>
