---
/**
 * Тизер объекта (ТЗ Б.2 п. 4, раздел 10): фото, тип + комнатность, район, площадь, цена, 2–3 чипса-фичи.
 * Вся карточка кликабельна через одну ссылку с полным текстом; заголовок — h3.
 */
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { Item } from '../lib/catalog';
import { itemUrl } from '../lib/catalog';
import { cityBySlug, districtBySlug } from '../lib/geo';
import { FEATURE_LABEL, TYPE_WORDS } from '../lib/segments';
import { moneyL, numL } from '../lib/format';
import { t } from '../i18n/ui';
import { LABEL_TEXT, LABEL_STYLE } from '../lib/objectsConfig';

interface Props { x: Item; headingLevel?: 'h2' | 'h3' }
const { x, headingLevel = 'h3' } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const url = itemUrl(lang, x);
const city = cityBySlug(x.city)!;
const district = x.district ? districtBySlug(x.city, x.district) : null;
const place = [district?.name[lang], city.name[lang]].filter(Boolean).join(', ');
const title = `${TYPE_WORDS[lang][x.type].one}${x.rooms ? ` ${x.rooms}` : ''}`;
const area = x.area ? `${numL(lang, x.area)} ${d.m2}` : '';
const price = x.price ? moneyL(lang, x.price) + (x.deal === 'rent' ? d.perMonth : '') : d.priceOnRequest;
const chips = x.features.filter((f) => !/bedroom|price-to/.test(f)).slice(0, 3);
const alt = `${title}${district ? ` — ${district.name[lang]}` : ''}${area ? `, ${area}` : ''} — ${d.photo} 1`;
const fav = { id: x.id, url, title, image: x.image, price, meta: place };
const H = headingLevel;
---
<article class="sale-card card group relative flex h-full flex-col p-2 shadow-[var(--shadow-card)]">
  <div class="sc-img relative aspect-[4/3] overflow-hidden rounded-[16px]">
    <Img src={x.image} alt={alt} class={`size-full transition-transform duration-700 group-hover:scale-[1.03]${x.label === 'sold' ? ' opacity-60 grayscale' : ''}`} width={640} height={480} />
    <span class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      <span class="chip chip-accent !text-[11px]">{x.deal === 'rent' ? d.rent : d.sale}</span>
      {x.label && <span class="chip !text-[11px]" style={`${LABEL_STYLE[x.label]};border-color:transparent`}>{LABEL_TEXT[lang][x.label]}</span>}
      {x.isPrivate && <span class="chip !text-[11px]" style="background:#bc906e;color:#fff;border-color:transparent">PRIVE</span>}
    </span>
  </div>
  <div class="sc-body flex flex-1 flex-col px-3 pb-3 pt-4">
    <H class="text-lg font-medium leading-tight tracking-[-0.01em]">
      <a href={url} class="sc-link after:absolute after:inset-0 after:rounded-[inherit] after:content-[''] hover:text-accent">{title}</a>
    </H>
    <p class="mt-1 text-[15px] text-muted">{place}</p>
    {chips.length > 0 && <ul class="mt-3 flex flex-wrap gap-1.5">{chips.map((f) => <li class="chip !text-[11px]">{FEATURE_LABEL[lang][f]}</li>)}</ul>}
    <div class="mt-auto flex items-end justify-between gap-3 pt-4">
      <p class="text-[15px] text-muted">{area}{x.sea ? <><br />{d.toSea(numL(lang, x.sea))}</> : null}</p>
      <p class="text-right text-2xl font-medium tracking-[-0.01em]">{price}</p>
    </div>
  </div>
  <button type="button" data-fav={x.id} data-fav-item={JSON.stringify(fav)} aria-pressed="false" aria-label={d.addFav} class="sc-fav absolute right-5 top-5 z-10 grid size-10 place-items-center rounded-full bg-white/90 shadow hover:text-accent">
    <Icon name="heart" class="size-5" />
  </button>
</article>
