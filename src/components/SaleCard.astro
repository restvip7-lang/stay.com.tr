---
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { Listing } from '../lib/api';
import { money, num } from '../lib/format';
interface Props { x: Listing }
const { x } = Astro.props;
const place = [x.city, x.area].filter(Boolean).join(', ');
const priceLabel = x.operation === 'rental' && x.price ? `${money(x.price)}/мес` : money(x.price);
const fav = { id: x.id, url: x.url, title: x.title, image: x.image, price: priceLabel, meta: place };
---
<article class="card group relative flex h-full flex-col p-2 shadow-[var(--shadow-card)]">
  <div class="flex items-start justify-between gap-3 px-3 pb-3 pt-3">
    <p class="text-lg font-medium leading-tight tracking-[-0.02em]">{place || x.country || 'Турция'}</p>
    <span class="chip chip-accent shrink-0">{x.operation === 'rental' ? 'Аренда' : 'Продажа'}</span>
  </div>
  <a href={x.url} class="relative block aspect-[4/3] overflow-hidden rounded-[16px]">
    <Img src={x.image} alt={x.title} class="size-full transition-transform duration-700 group-hover:scale-[1.03]" />
    <span class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      {x.ref && <span class="chip !text-[11px]">ID: {x.ref}</span>}
      {x.distanceToSea && <span class="chip !text-[11px]">До моря {num(x.distanceToSea)} м</span>}
    </span>
  </a>
  <button type="button" data-fav={x.id} data-fav-item={JSON.stringify(fav)} aria-pressed="false" aria-label="В избранное" class="absolute right-5 top-[76px] z-10 grid size-10 place-items-center rounded-full bg-white/90 shadow hover:text-accent">
    <Icon name="heart" class="size-5" />
  </button>
  <div class="flex flex-1 flex-col px-3 pb-3 pt-4">
    <a href={x.url} class="line-clamp-2 leading-snug hover:text-accent">{x.title}</a>
    <div class="mt-auto flex items-end justify-between gap-3 pt-4">
      <div class="text-[15px] text-muted">
        <p>{x.typeLabel}{x.rooms ? ` ${x.rooms}` : ''}</p>
        {x.totalArea && <p>Площадь {num(x.totalArea)} м²</p>}
      </div>
      <p class="text-right text-2xl font-medium tracking-[-0.02em]">{priceLabel}</p>
    </div>
  </div>
</article>
