---
/**
 * Тизер объекта (ТЗ Б.2 п. 4, раздел 10): фото, тип + комнатность, район, площадь, цена, 2–3 чипса-фичи.
 * Вся карточка кликабельна через одну ссылку с полным текстом; заголовок — h3.
 */
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { Item } from '../lib/catalog';
import { itemUrl } from '../lib/catalog';
import { cityBySlug, districtBySlug } from '../lib/geo';
import { FEATURE_LABEL, TYPE_WORDS } from '../lib/segments';
import { moneyL, numL } from '../lib/format';
import { t } from '../i18n/ui';
import { LABEL_TEXT, LABEL_STYLE } from '../lib/objectsConfig';

interface Props { x: Item; headingLevel?: 'h2' | 'h3' }
const { x, headingLevel = 'h3' } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const url = itemUrl(lang, x);
const city = cityBySlug(x.city)!;
const district = x.district ? districtBySlug(x.city, x.district) : null;
const place = [district?.name[lang], city.name[lang]].filter(Boolean).join(', ');
const title = `${TYPE_WORDS[lang][x.type].one}${x.rooms ? ` ${x.rooms}` : ''}`;
const area = x.area ? `${numL(lang, x.area)} ${d.m2}` : '';
const price = x.price ? moneyL(lang, x.price) + (x.deal === 'rent' ? d.perMonth : '') : d.priceOnRequest;
const chips = x.features.filter((f) => !/bedroom|price-to/.test(f)).slice(0, 3);
const alt = `${title}${district ? ` — ${district.name[lang]}` : ''}${area ? `, ${area}` : ''} — ${d.photo} 1`;
const perM2 = x.price && x.area && x.deal === 'sale' ? `${moneyL(lang, Math.round(x.price / x.area))} ${d.item.perM2}` : '';
const fav = { id: x.id, url, title, image: x.image, price, meta: place };
const H = headingLevel;
const sold = x.label === 'sold';
---
<!-- Карточка объекта по эталону (каталог mr-group): белая, скругление 20, отступы 20; сверху заголовок 16/500 и район,
     в середине фото, бейджи капсом 11 px, внизу цена 22/500 и цена за м². По наведению — тень и «♡». -->
<article class="sale-card group relative flex h-full flex-col rounded-[20px] bg-white p-4 transition-shadow duration-100 ease-in-out hover:shadow-[0_2px_12px_#1c1e261a,inset_3px_3px_.5px_-3.5px_#fff] lg:p-5">
  <div class="sc-head min-h-[44px] pr-14">
    <H class="text-[16px] font-medium leading-[22px] tracking-[0.2px]">
      <a href={url} class="sc-link after:absolute after:inset-0 after:rounded-[inherit] after:content-['']">{title}{area ? `, ${area}` : ''}</a>
    </H>
    <p class="mt-0.5 text-[13px] leading-[18px] tracking-[0.1px] text-soft">{place}{x.sea ? ` · ${d.toSea(numL(lang, x.sea))}` : ''}</p>
  </div>
  <div class="sc-img relative mt-4 aspect-[4/3] overflow-hidden rounded-[12px]">
    <Img src={x.image} alt={alt} class={`size-full transition-transform duration-700 group-hover:scale-[1.03]${sold ? ' opacity-60 grayscale' : ''}`} width={640} height={480} />
  </div>
  <div class="sc-body flex flex-1 flex-col">
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {x.label && <li><span class="badge badge-solid" style={LABEL_STYLE[x.label]}>{LABEL_TEXT[lang][x.label]}</span></li>}
      {x.isPrivate && <li><span class="badge badge-solid" style="background:#bc906e">PRIVE</span></li>}
      <li><span class="badge">{x.deal === 'rent' ? d.rent : d.sale}</span></li>
      {chips.slice(0, 2).map((f) => <li><span class="badge">{FEATURE_LABEL[lang][f]}</span></li>)}
    </ul>
    <div class="mt-auto pt-4"><div class="border-t border-line pt-3">
      <p class:list={['text-[22px] font-medium leading-[27px] tracking-[0.6px] text-ink-n', sold && 'text-muted line-through']}>{price}</p>
      {perM2 && <p class="mt-0.5 text-[14px] leading-5 tracking-[0.2px] text-ink-n/50">{perM2}</p>}
    </div></div>
  </div>
  <button type="button" data-fav={x.id} data-fav-item={JSON.stringify(fav)} aria-pressed="false" aria-label={d.addFav} class="sc-fav absolute right-4 top-4 z-10 grid size-14 place-items-center rounded-[16px] bg-white shadow-[var(--shadow-btn)] transition-colors hover:bg-page-n lg:right-5 lg:top-5 lg:size-[50px] lg:rounded-[12px] lg:invisible lg:group-hover:visible lg:aria-pressed:visible">
    <Icon name="heart" class="size-5" />
  </button>
</article>
