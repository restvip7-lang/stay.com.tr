---
/**
 * Тизер объекта (ТЗ Б.2 п. 4, раздел 10): фото, тип + комнатность, район, площадь, цена, 2–3 чипса-фичи.
 * Вся карточка кликабельна через одну ссылку с полным текстом (её ::after с z-index 1 лежит поверх фото и бейджей, «♡» с z-10 выше); заголовок — h3.
 */
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { Item } from '../lib/catalog';
import { itemUrl } from '../lib/catalog';
import { cityBySlug, districtBySlug } from '../lib/geo';
import { FEATURE_LABEL, TYPE_WORDS } from '../lib/segments';
import { moneyL, numL } from '../lib/format';
import { t } from '../i18n/ui';
import { LABEL_TEXT, LABEL_STYLE } from '../lib/objectsConfig';

/** project — карточка квартиры в каталоге STAY PROJECTS, по образцу mr-group (/flats/): цена сразу под заголовком, планировка,
 *  внизу «проект · блок · этаж», срок сдачи и район (метро у нас нет). */
interface Props { x: Item; headingLevel?: 'h2' | 'h3'; project?: { title: string; ready: string | null; year: number | null } | null }
const { x, headingLevel = 'h3', project = null } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const url = itemUrl(lang, x);
const city = cityBySlug(x.city)!;
const district = x.district ? districtBySlug(x.city, x.district) : null;
const place = [district?.name[lang], city.name[lang]].filter(Boolean).join(', ');
const title = `${TYPE_WORDS[lang][x.type].one}${x.rooms ? ` ${x.rooms}` : ''}`;
const area = x.area ? `${numL(lang, x.area)} ${d.m2}` : '';
const price = x.price ? moneyL(lang, x.price) + (x.deal === 'rent' ? d.perMonth : '') : d.priceOnRequest;
const alt = `${title}${district ? ` — ${district.name[lang]}` : ''}${area ? `, ${area}` : ''} — ${d.photo} 1`;
const perM2 = x.price && x.area && x.deal === 'sale' ? `${moneyL(lang, Math.round(x.price / x.area))} ${d.item.perM2}` : '';
const fav = { id: x.id, url, title, image: x.image, price, meta: place };
// ID объекта на карточке (Anuar 26.11.2026): клиент пишет менеджеру «ID 4397», в админке он ищется так же. Выделяется кликом для копирования.
const idText = `ID ${x.ref ?? x.id}`;
const H = headingLevel;
const sold = x.label === 'sold';
// Фиолетовая карточка «Stay» — для наших объектов; у PRIVE-лотов остаётся золотое оформление PRIVE.
const own = !!x.own && !x.isPrivate;
// Бейджи на фото справа сверху: «Гражданство» и «ВНЖ» — только по ручным отметкам в админке (решение Anuar 25.11.2026: по цене не подходит).
const citizenship = !sold && !!x.citMark;
const residence = !sold && !!x.resMark;
// Гражданство и ВНЖ показаны бейджами на фото, в чипах их не повторяем.
const chips = x.features.filter((f) => !/bedroom|price-to/.test(f) && !(f === 'citizenship' && citizenship) && !(f === 'residence-permit' && residence)).slice(0, 3);
const RIGHTS: Record<string, { cit: string; res: string }> = {
  ru: { cit: 'Гражданство', res: 'ВНЖ' }, en: { cit: 'Citizenship', res: 'Residence permit' }, tr: { cit: 'Vatandaşlık', res: 'Oturma izni' },
  de: { cit: 'Staatsbürgerschaft', res: 'Aufenthaltstitel' }, sr: { cit: 'Državljanstvo', res: 'Boravišna dozvola' },
};
const rights = RIGHTS[lang] ?? RIGHTS.ru;
// Карточка STAY PROJECTS: блок и номер — из названия лота («…, №3, Блок C, …»), этаж — из базы.
const PC = ({
  ru: { or: 'или', ready: 'Срок сдачи', block: 'Блок', floor: (n: number) => `${n} этаж` },
  en: { or: 'or', ready: 'Completion', block: 'Block', floor: (n: number) => `floor ${n}` },
  tr: { or: 'veya', ready: 'Teslim', block: 'Blok', floor: (n: number) => `${n}. kat` },
  de: { or: 'oder', ready: 'Fertigstellung', block: 'Block', floor: (n: number) => `${n}. Etage` },
  sr: { or: 'ili', ready: 'Rok završetka', block: 'Blok', floor: (n: number) => `${n}. sprat` },
} as Record<string, { or: string; ready: string; block: string; floor: (n: number) => string }>)[lang] ?? null;
const numM = project ? x.titleRu.match(/№\s*([0-9A-Za-z-]+)/) : null;
const pLine = project && PC ? [x.block && `${PC.block} ${x.block}${numM ? `, №${numM[1]}` : ''}`, x.floor ? PC.floor(x.floor) : ''].filter(Boolean).join(' · ') : '';
const readyText = project ? (lang === 'ru' ? project.ready : project.year ? String(project.year) : null) : null;
const perM2Short = x.price && x.area && PC ? `${PC.or} ${moneyL(lang, Math.round(x.price / x.area))}/${d.m2}` : '';
const pChips = x.features.filter((f) => !/bedroom|price-to|new|citizenship|residence-permit/.test(f)).slice(0, 2);
---
<!-- project: карточка квартиры STAY PROJECTS по образцу (mr-group.ru/flats/): заголовок, крупная цена и «или N €/м²», планировка на белом,
     чипы, внизу проект · блок · этаж, срок сдачи и район; «♡» справа внизу. -->
{project ? (
<article class="sale-card group relative flex h-full flex-col rounded-[20px] bg-white p-4 transition-shadow duration-100 ease-in-out hover:shadow-[0_2px_12px_#1c1e261a] lg:p-5">
  <H class="text-[18px] font-medium leading-[24px] tracking-[0.2px] text-ink-n">
    <a href={url} class="sc-link after:absolute after:inset-0 after:z-[1] after:rounded-[inherit] after:content-['']">{title}{area ? `, ${area}` : ''}</a>
  </H>
  <p class:list={['mt-1 text-[24px] font-medium leading-[30px] tracking-[0.4px] text-ink-n', sold && 'text-muted line-through']}>{price}</p>
  {perM2Short && <p class="mt-0.5 text-[13px] leading-[18px] text-soft">{perM2Short}</p>}
  <div class="relative mt-3 aspect-[4/3] overflow-hidden bg-white">
    <Img src={x.image} alt={alt} class={`size-full !object-contain${sold ? ' opacity-60 grayscale' : ''}`} width={640} height={480} />
    {(citizenship || residence) && (
      <ul class="sc-rights pointer-events-none absolute right-0 top-0 z-[2] flex gap-1.5">
        {citizenship && <li class="sc-right sc-right-cit">{rights.cit}</li>}
        {residence && <li class="sc-right sc-right-res">{rights.res}</li>}
      </ul>
    )}
  </div>
  <ul class="mt-3 flex min-h-[26px] flex-wrap gap-1.5">
    {x.label && <li><span class="badge badge-solid" style={LABEL_STYLE[x.label]}>{LABEL_TEXT[lang][x.label]}</span></li>}
    {x.isPrivate && <li><span class="badge badge-solid" style="background:#bc906e">PRIVE</span></li>}
    {pChips.map((f) => <li><span class="badge">{FEATURE_LABEL[lang][f]}</span></li>)}
  </ul>
  <div class="mt-auto pr-16 pt-4 text-[13px] leading-[19px] text-soft">
    <p class="truncate"><span class="font-medium text-ink-n">{project.title}</span>{pLine && ` · ${pLine}`}</p>
    {readyText && <p>{PC?.ready}: {readyText}</p>}
    <p class="truncate">{place}{x.sea ? ` · ${d.toSea(numL(lang, x.sea))}` : ''}</p>
    <p class="sc-id relative z-[2] w-fit select-all">{idText}</p>
  </div>
  <button type="button" data-fav={x.id} data-fav-item={JSON.stringify(fav)} aria-pressed="false" aria-label={d.addFav} class="sc-fav absolute bottom-4 right-4 z-10 grid size-12 place-items-center rounded-[14px] bg-white shadow-[var(--shadow-btn)] transition-colors hover:bg-page-n lg:bottom-5 lg:right-5">
    <Icon name="heart" class="size-5" />
  </button>
</article>
) : (<>
<!-- Карточка объекта по эталону (каталог mr-group): белая, скругление 20, отступы 20; сверху заголовок 16/500 и район,
     в середине фото, бейджи капсом 11 px, внизу цена 22/500 и цена за м². По наведению — тень и «♡».
     Наш объект (отметка в админке) — светло-фиолетовая карточка с бейджем STAY, по образцу золотого PRIVE. -->
<article class:list={['sale-card group relative flex h-full flex-col rounded-[20px] p-4 transition-shadow duration-100 ease-in-out hover:shadow-[0_2px_12px_#1c1e261a,inset_3px_3px_.5px_-3.5px_#fff] lg:p-5', own ? 'bg-[#f4f0fd] ring-1 ring-[#754be9]/25' : 'bg-white']}>
  <!-- Высота шапки постоянная (1 строка заголовка + 2 строки района = 62 px), чтобы фото во всех карточках ряда стояли на одном уровне. -->
  <div class="sc-head h-[62px] pr-14">
    <H class="truncate text-[16px] font-medium leading-[22px] tracking-[0.2px]">
      <a href={url} class="sc-link after:absolute after:inset-0 after:z-[1] after:rounded-[inherit] after:content-['']">{title}{area ? `, ${area}` : ''}</a>
    </H>
    <p class="mt-0.5 line-clamp-2 text-[13px] leading-[18px] tracking-[0.1px] text-soft">{place}{x.sea ? ` · ${d.toSea(numL(lang, x.sea))}` : ''}</p>
  </div>
  <div class="sc-img relative mt-4 aspect-[4/3] overflow-hidden rounded-[12px]">
    <Img src={x.image} alt={alt} class={`size-full transition-transform duration-700 group-hover:scale-[1.03]${sold ? ' opacity-60 grayscale' : ''}`} width={640} height={480} />
    {(citizenship || residence) && (
      <ul class="sc-rights pointer-events-none absolute right-2.5 top-2.5 z-[2] flex gap-1.5">
        {citizenship && <li class="sc-right sc-right-cit">{rights.cit}</li>}
        {residence && <li class="sc-right sc-right-res">{rights.res}</li>}
      </ul>
    )}
  </div>
  <div class="sc-body flex flex-1 flex-col">
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {x.label && <li><span class="badge badge-solid" style={LABEL_STYLE[x.label]}>{LABEL_TEXT[lang][x.label]}</span></li>}
      {x.isPrivate && <li><span class="badge badge-solid" style="background:#bc906e">PRIVE</span></li>}
      {own && <li><span class="badge badge-solid" style="background:#754be9">STAY</span></li>}
      <li><span class="badge">{x.deal === 'rent' ? d.rent : d.sale}</span></li>
      {chips.slice(0, 2).map((f) => <li><span class="badge">{FEATURE_LABEL[lang][f]}</span></li>)}
    </ul>
    <div class="mt-auto pt-4"><div class="border-t border-line pt-3">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class:list={['text-[22px] font-medium leading-[27px] tracking-[0.6px] text-ink-n', sold && 'text-muted line-through']}>{price}</p>
          {perM2 && <p class="mt-0.5 text-[14px] leading-5 tracking-[0.2px] text-ink-n/50">{perM2}</p>}
        </div>
        <span class="sc-id relative z-[2] shrink-0 select-all pt-[5px] text-[14px] leading-5 tracking-[0.2px] text-ink-n/50">{idText}</span>
      </div>
    </div></div>
  </div>
  <button type="button" data-fav={x.id} data-fav-item={JSON.stringify(fav)} aria-pressed="false" aria-label={d.addFav} class="sc-fav absolute right-4 top-4 z-10 grid size-14 place-items-center rounded-[16px] bg-white shadow-[var(--shadow-btn)] transition-colors hover:bg-page-n lg:right-5 lg:top-5 lg:size-[50px] lg:rounded-[12px] lg:invisible lg:group-hover:visible lg:aria-pressed:visible">
    <Icon name="heart" class="size-5" />
  </button>
</article>
</>)}
