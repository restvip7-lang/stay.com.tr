---
/**
 * Фильтр каталога (ТЗ 8.1). Гео, сделка и тип — это части адреса (ЧПУ), остальное — GET-параметры.
 * Сочетание из белого списка (одна комнатность, «до 100/150/200 тыс.», «Гражданство ТР»)
 * переписывает адрес на чистый: …/apartments/2-bedrooms/ вместо ?rooms=2+1.
 * catalog — режим посадочной: выдача обновляется на месте; home — форма на главной ведёт в каталог.
 */
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { INTL } from '../i18n/config';
import { geoOptions, allowedFeatureMap, itemsOf, rangesOf, type Cat, type Filters, type Ranges } from '../lib/catalog';
import { DEAL_WORDS, FEATURE_LABEL, FEATURES, TYPES, TYPE_WORDS, type Deal, type FeatureSlug } from '../lib/segments';
const allowedDeals = Object.fromEntries(FEATURES.map((x) => [x.slug, x.deals as string[]])) as Record<string, string[]>;
import { numL, pluralL } from '../lib/format';

interface Props { cat: Cat & { deal: Deal }; f: Filters; total: number; mode?: 'catalog' | 'home' | 'prive'; types?: string[]; ranges?: Ranges; preset?: boolean }
const { cat, f, total, mode = 'catalog', ranges, preset = false } = Astro.props;
// preset: блок «как на главной» на странице всех стран — поля заполнены текущим фильтром (на самой главной — пустые).
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const tf = d.filter;
const opts = await geoOptions(cat.deal);
const types = Astro.props.types ?? TYPES;
const catalog = mode === 'catalog';
const prive = mode === 'prive';
// Каталог: точные минимум и максимум по объектам раздела (без учёта выбранных фильтров). Главная — как раньше, по всей базе сделки.
const rg = catalog ? rangesOf(await itemsOf({ ...cat, feature: undefined })) : null;
const priceMin = rg ? rg.price[0] : Math.max(0, Math.floor(opts.priceMin / 1000) * 1000);
const priceMax = rg ? rg.price[1] : Math.ceil(opts.priceMax / (cat.deal === 'rent' ? 1000 : 100000)) * (cat.deal === 'rent' ? 1000 : 100000);
const step = rg ? 1 : cat.deal === 'rent' ? 50 : 1000;
const [areaMin, areaMax] = rg ? rg.area : [10, 800];
const [seaMin, seaMax] = rg ? rg.sea : [1, 1000];
// Страница PRIVE: границы ползунков по самим PRIVE-лотам.
const pPrice = ranges?.price ?? [priceMin, priceMax];
const pArea = ranges?.area ?? [20, 500];
const aptNouns = TYPE_WORDS[lang].apartments.n as [string, string, string];
const rooms = [{ v: 'studio', l: tf.studio }, { v: '1+1', l: '1+1' }, { v: '2+1', l: '2+1' }, { v: '3+1', l: '3+1' }, { v: '4+', l: '4+' }];
const selRooms = new Set(f.rooms);
const allowed = allowedFeatureMap(cat.country);
const loc = INTL[lang];
// Фичи, которые выражаются полями формы: из адреса переносим в поля, клиент соберёт ЧПУ заново.
const pf = cat.feature ?? null;
const pathPriceTo = pf?.startsWith('price-to-') ? Number(pf.slice(9)) : undefined;
const pathRooms = pf ? ({ '1-bedroom': '1+1', '2-bedrooms': '2+1', '3-bedrooms': '3+1', '4-bedrooms': '4+' } as Record<string, string>)[pf] : undefined;
const hiddenFeature = pf && !/bedroom|price-to|citizenship/.test(pf) ? pf : null;
const priceTo = f.priceTo ?? pathPriceTo;
// Главная: три вкладки типа (по макету), по умолчанию «Квартиры»; слово в кнопке склоняется по числу.
const homeTypes = (['apartments', 'villas', 'duplexes'] as const).filter((x) => types.includes(x));
const homeType = (cat.type && (homeTypes as readonly string[]).includes(cat.type) ? cat.type : 'apartments') as (typeof homeTypes)[number];
const nouns = Object.fromEntries(homeTypes.map((x) => [x, TYPE_WORDS[lang][x].n])) as Record<string, [string, string, string]>;
const allW = ({ ru: 'Все', en: 'All', tr: 'Tümü', de: 'Alle', sr: 'Sve' } as Record<string, string>)[lang] ?? 'Все';
/** Тумблер «наши объекты» (объекты компании). */
const OWN_LABEL: Record<string, string> = { ru: 'Объекты Stay', en: 'Stay properties', tr: 'Stay ilanları', de: 'Stay-Objekte', sr: 'Stay nekretnine' };
/** «Все фильтры»: подписи и колонки «Расширенных» (только фичи, допустимые для сделки). */
const A = ({
  ru: { reset: 'Сбросить', main: 'Основные', more: 'Расширенные', area: 'Площадь', floor: 'Этаж', resetAll: 'Сбросить все', general: 'Общее', object: 'Объект', place: 'Расположение и класс', buy: 'Особенности покупки', market: 'Рынок', props: 'Характеристики', loc: 'Расположение', cls: 'Класс' },
  en: { reset: 'Reset', main: 'Main', more: 'Advanced', area: 'Area', floor: 'Floor', resetAll: 'Reset all', general: 'General', object: 'Property', place: 'Location and class', buy: 'Purchase', market: 'Market', props: 'Features', loc: 'Location', cls: 'Class' },
  tr: { reset: 'Sıfırla', main: 'Temel', more: 'Gelişmiş', area: 'Alan', floor: 'Kat', resetAll: 'Tümünü sıfırla', general: 'Genel', object: 'Mülk', place: 'Konum ve sınıf', buy: 'Satın alma', market: 'Pazar', props: 'Özellikler', loc: 'Konum', cls: 'Sınıf' },
  de: { reset: 'Zurücksetzen', main: 'Basis', more: 'Erweitert', area: 'Fläche', floor: 'Etage', resetAll: 'Alle zurücksetzen', general: 'Allgemein', object: 'Objekt', place: 'Lage und Klasse', buy: 'Kauf', market: 'Markt', props: 'Ausstattung', loc: 'Lage', cls: 'Klasse' },
  sr: { reset: 'Poništi', main: 'Osnovni', more: 'Prošireni', area: 'Površina', floor: 'Sprat', resetAll: 'Poništi sve', general: 'Opšte', object: 'Nekretnina', place: 'Lokacija i klasa', buy: 'Kupovina', market: 'Tržište', props: 'Karakteristike', loc: 'Lokacija', cls: 'Klasa' },
} as Record<string, Record<string, string>>)[lang] ?? {};
const fdeal = (slugs: string[]) => slugs.filter((x) => x === 'citizenship' ? cat.deal === 'sale' && cat.country === 'turkey' : (allowedDeals[x] ?? []).includes(cat.deal) && (x !== 'residence-permit' || cat.country === 'turkey'))
  .map((x) => ({ name: x, label: FEATURE_LABEL[lang][x as FeatureSlug] }));
const advCols: { title: string; groups: { title: string; items: { name: string; label: string }[]; floor?: boolean }[] }[] = [
  // Этажа в базе Portfolio нет — фильтр по этажу не показываем (параметры floor_from/floor_to поддержаны на будущее).
  { title: A.general, groups: [{ title: A.buy, items: fdeal(['citizenship', 'residence-permit', 'installment', 'from-developer']) }] },
  { title: A.object, groups: [{ title: A.market, items: fdeal(['new', 'resale']) }, { title: A.props, items: fdeal(['furnished', 'with-pool']) }] },
  { title: A.place, groups: [{ title: A.loc, items: fdeal(['near-sea', 'first-line', 'sea-view']) }, { title: A.cls, items: fdeal(['luxury', 'cheap', 'investment']) }] },
].map((c) => ({ ...c, groups: c.groups.filter((g) => g.floor || g.items.length) }));
const strings = { found: tf.found, show: tf.show, remove: tf.remove('{l}'), prive: tf.onlyPrive, citizenship: tf.citizenship };
---
<form method="get" action={`/${lang}/`} data-filter data-mode={mode} data-lang={lang} data-loc={loc} data-allowed={JSON.stringify(allowed)} data-t={JSON.stringify(strings)} class:list={['filter', catalog ? 'filter-n' : 'filter-home']}>
  {prive ? (
    <>
      <!-- Страница PRIVE — уменьшенный фильтр по образцу (mr-group.ru/private/): стоимость, комнаты, площадь и «Показать N квартир».
           Считает и показывает только PRIVE-лоты. -->
      <input type="hidden" name="deal" value="sale" />
      <input type="hidden" name="prive" value="1" />
      <div class="grid items-start gap-x-6 gap-y-5 lg:grid-cols-[minmax(0,1.2fr)_auto_minmax(0,1fr)_auto]">
        <fieldset class="range min-w-0" data-range data-min={pPrice[0]} data-max={pPrice[1]} data-step="1" aria-labelledby="p-price-l">
          <span class="hlabel" id="p-price-l">{tf.price}</span>
          <div class="hsplit hsplit-v">
            <label><span>{tf.fromW}</span><input name="price_from" inputmode="numeric" placeholder={`${numL(lang, pPrice[0])}`} value={f.priceFrom ? numL(lang, f.priceFrom) : ''} data-lo aria-label={tf.priceFrom} /></label>
            <label><span>{tf.toW}</span><input name="price_to" inputmode="numeric" placeholder={`${numL(lang, pPrice[1])}`} value={f.priceTo ? numL(lang, f.priceTo) : ''} data-hi aria-label={tf.priceTo} /></label>
          </div>
          <div class="dual dual-home -mt-[9px] px-4" aria-hidden="true">
            <input type="range" min={pPrice[0]} max={pPrice[1]} step="1" value={f.priceFrom ?? pPrice[0]} data-slo tabindex="-1" />
            <input type="range" min={pPrice[0]} max={pPrice[1]} step="1" value={f.priceTo ?? pPrice[1]} data-shi tabindex="-1" />
          </div>
        </fieldset>
        <fieldset>
          <legend class="hlabel">{tf.rooms}</legend>
          <div class="flex flex-wrap gap-2">
            {rooms.map((r) => (
              <label class="cursor-pointer">
                <input type="checkbox" name="rooms" value={r.v} checked={selRooms.has(r.v)} class="peer sr-only" />
                <span class="inline-flex h-[52px] min-w-[52px] items-center justify-center rounded-full bg-white px-3 text-[14px] transition-colors hover:bg-line peer-checked:bg-accent peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{r.l}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="range min-w-0" data-range data-min={pArea[0]} data-max={pArea[1]} data-step="1" aria-labelledby="p-area-l">
          <span class="hlabel" id="p-area-l">{d.item.area}, {d.m2}</span>
          <div class="hsplit hsplit-v">
            <label><span>{tf.fromW}</span><input name="area_from" inputmode="numeric" placeholder={`${pArea[0]}`} value={f.areaFrom ?? ''} data-lo aria-label={`${d.item.area} ${tf.fromW}`} /></label>
            <label><span>{tf.toW}</span><input name="area_to" inputmode="numeric" placeholder={`${pArea[1]}`} value={f.areaTo ?? ''} data-hi aria-label={`${d.item.area} ${tf.toW}`} /></label>
          </div>
          <div class="dual dual-home -mt-[9px] px-4" aria-hidden="true">
            <input type="range" min={pArea[0]} max={pArea[1]} step="1" value={f.areaFrom ?? pArea[0]} data-slo tabindex="-1" />
            <input type="range" min={pArea[0]} max={pArea[1]} step="1" value={f.areaTo ?? pArea[1]} data-shi tabindex="-1" />
          </div>
        </fieldset>
        <button type="submit" class="btn btn-accent h-[52px] whitespace-nowrap lg:mt-[28px]" data-nouns={JSON.stringify({ '': aptNouns })}>
          <span>{tf.show} <span data-total>{numL(lang, total)}</span> <span data-noun>{pluralL(lang, total, aptNouns)}</span></span><Icon name="chevronRight" class="size-3.5" />
        </button>
      </div>
    </>
  ) : catalog ? (
    <>
      <!-- Каталог (новая система образца): 6 полей 50 в ряд с подписью сверху + кнопка «Фильтры», ниже чипы. -->
      <div class="scroll-x -mx-5 flex gap-2 px-5 lg:mx-0 lg:grid lg:grid-cols-[repeat(5,minmax(0,1fr))_minmax(0,1fr)_auto] lg:overflow-visible lg:px-0">
        <label class="fsel" for="f-deal">
          <span>{tf.deal}</span>
          <select id="f-deal" name="deal">{(['sale', 'rent'] as Deal[]).map((x) => <option value={x} selected={cat.deal === x}>{DEAL_WORDS[lang][x].name}</option>)}</select>
          <Icon name="chevronDown" class="fsel-i" />
        </label>
        <label class="fsel" for="f-type">
          <span>{tf.type}</span>
          <select id="f-type" name="type">
            <option value="">{tf.anyType}</option>
            {types.map((x) => <option value={x} selected={cat.type === x}>{TYPE_WORDS[lang][x as keyof typeof TYPE_WORDS.ru].pl}</option>)}
          </select>
          <Icon name="chevronDown" class="fsel-i" />
        </label>
        <label class="fsel" for="f-country">
          <span>{tf.country}</span>
          <select id="f-country" name="country" data-country><option value="" selected={!cat.country}>{tf.allCountries ?? allW}</option>{opts.countries.map((c) => <option value={c.slug} selected={cat.country === c.slug}>{c.name[lang]}</option>)}</select>
          <Icon name="chevronDown" class="fsel-i" />
        </label>
        <label class="fsel" for="f-city">
          <span>{tf.city}</span>
          <select id="f-city" name="city" data-city>
            <option value="">{tf.allCities}</option>
            {opts.cities.map((c) => <option value={c.slug} data-country={c.country} selected={cat.city === c.slug}>{c.name[lang]}</option>)}
          </select>
          <Icon name="chevronDown" class="fsel-i" />
        </label>
        <label class="fsel" for="f-district">
          <span>{tf.district}</span>
          <select id="f-district" name="district" data-district>
            <option value="">{tf.allDistricts}</option>
            {opts.districts.map((x) => <option value={x.d.slug} data-city={x.city} selected={cat.city === x.city && cat.district === x.d.slug}>{x.d.name[lang]}</option>)}
          </select>
          <Icon name="chevronDown" class="fsel-i" />
        </label>
        <label class="fsel" for="f-ref">
          <span>{tf.id}</span>
          <input id="f-ref" name="ref" placeholder={tf.idPh} maxlength="20" autocomplete="off" value={f.ref ?? ''} />
        </label>
        <button type="button" data-adv-open class="btn-n btn-n-white hidden shrink-0 lg:inline-flex"><Icon name="filter" class="size-5" />{tf.all}</button>
      </div>
      <button type="button" data-adv-open class="btn-n btn-n-white mt-3 w-full lg:hidden"><Icon name="filter" class="size-5" />{tf.all}</button>
      <!-- Чипы: комнатность, PRIVE, гражданство, фичи из адреса -->
      <div class="scroll-x relative -mx-5 mt-4 flex gap-2 px-5 lg:mx-0 lg:flex-wrap lg:px-0">
        {rooms.map((r) => (
          <label class="shrink-0 cursor-pointer">
            <input type="checkbox" name="rooms" value={r.v} checked={selRooms.has(r.v) || pathRooms === r.v} data-sync class="peer sr-only" />
            <span class="chip-n peer-checked:!bg-ink-n peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{r.l}</span>
          </label>
        ))}
        <span data-sale-only hidden={cat.deal !== 'sale'} class="contents">
          <label class="shrink-0 cursor-pointer"><input type="checkbox" name="prive" value="1" checked={f.prive} data-sync class="peer sr-only" /><span class="chip-n peer-checked:!bg-prive peer-checked:text-white">PRIVE</span></label>
          <label class="shrink-0 cursor-pointer"><input type="checkbox" name="citizenship" value="1" checked={f.citizenship || cat.feature === 'citizenship'} data-sync class="peer sr-only" /><span class="chip-n peer-checked:!bg-ink-n peer-checked:text-white">{tf.citizenship}</span></label>
          <label class="shrink-0 cursor-pointer"><input type="checkbox" name="own" value="1" checked={f.own} data-sync class="peer sr-only" /><span class="chip-n peer-checked:!bg-own peer-checked:text-white">{OWN_LABEL[lang]}</span></label>
        </span>
        {hiddenFeature && <button type="button" class="chip-n shrink-0 !bg-lime" data-chip-field="feature" aria-label={tf.remove(FEATURE_LABEL[lang][hiddenFeature])}>{FEATURE_LABEL[lang][hiddenFeature]} <span aria-hidden="true">×</span></button>}
        {f.extras.filter((e) => e !== cat.feature).map((e) => <button type="button" class="chip-n shrink-0 !bg-lime" data-uncheck={e} aria-label={tf.remove(FEATURE_LABEL[lang][e])}>{FEATURE_LABEL[lang][e]} <span aria-hidden="true">×</span></button>)}
      </div>

      <!-- «Все фильтры»: окно на весь экран по образцу (mr-group.ru/flats/): «Основные» и «Расширенные» в три колонки, только наши поля.
           Выдача под окном обновляется сразу; внизу «Показать N» закрывает окно, «Сбросить все» — чистый адрес раздела. -->
      <div data-adv-panel class="fixed inset-0 z-[60] hidden overflow-y-auto bg-white" role="dialog" aria-modal="true" aria-label={tf.all}>
        <div class="mx-auto max-w-[1392px] px-4 pb-36 pt-3 lg:px-[42px] lg:pt-5">
          <div class="sticky top-0 z-10 -mx-4 -mt-3 bg-white px-4 pb-2 pt-3 lg:static lg:mx-0 lg:mt-0 lg:bg-transparent lg:p-0">
            <div class="relative flex h-12 items-center justify-center rounded-[16px] bg-[#f3f4f6] lg:bg-page-n/70 text-[16px] font-medium shadow-[var(--shadow-btn)] lg:h-[50px] lg:text-[14px]">
            {tf.all}
            <button type="button" data-adv-close class="icon-hover absolute right-4" aria-label={d.closeMenu}><Icon name="close" class="size-5" /></button>
          </div>
          </div>

          <h3 class="adv-h2">{A.main}</h3>
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-[auto_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] lg:gap-8">
            <fieldset class="min-w-0">
              <legend class="adv-h4">{tf.rooms}</legend>
              <div class="flex flex-wrap gap-2">
                {rooms.map((r) => (
                  <label class="cursor-pointer">
                    <input type="checkbox" name="rooms" value={r.v} checked={selRooms.has(r.v) || pathRooms === r.v} data-sync class="peer sr-only" />
                    <span class="adv-chip peer-checked:!bg-ink-n peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{r.l}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <fieldset class="range min-w-0" data-range data-min={priceMin} data-max={priceMax} data-step={step}>
              <legend class="adv-h4">{tf.price}</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="field fld"><span>{tf.fromW}</span><input name="price_from" inputmode="numeric" placeholder={`${numL(lang, priceMin)}`} value={f.priceFrom ? numL(lang, f.priceFrom) : ''} data-lo aria-label={tf.priceFrom} /></label>
                <label class="field fld"><span>{tf.toW}</span><input name="price_to" inputmode="numeric" placeholder={`${numL(lang, priceMax)}`} value={priceTo ? numL(lang, priceTo) : ''} data-hi aria-label={tf.priceTo} /></label>
              </div>
              <div class="dual mt-4 hidden lg:block" aria-hidden="true">
                <input type="range" min={priceMin} max={priceMax} step={step} value={f.priceFrom ?? priceMin} data-slo tabindex="-1" />
                <input type="range" min={priceMin} max={priceMax} step={step} value={priceTo ?? priceMax} data-shi tabindex="-1" />
              </div>
            </fieldset>
            <fieldset class="range min-w-0" data-range data-min={areaMin} data-max={areaMax} data-step="1">
              <legend class="adv-h4">{A.area}, {d.m2}</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="field fld"><span>{tf.fromW}</span><input name="area_from" inputmode="numeric" placeholder={`${numL(lang, areaMin)}`} value={f.areaFrom ?? ''} data-lo aria-label={`${A.area} ${tf.fromW}`} /></label>
                <label class="field fld"><span>{tf.toW}</span><input name="area_to" inputmode="numeric" placeholder={`${numL(lang, areaMax)}`} value={f.areaTo ?? ''} data-hi aria-label={`${A.area} ${tf.toW}`} /></label>
              </div>
              <div class="dual mt-4 hidden lg:block" aria-hidden="true">
                <input type="range" min={areaMin} max={areaMax} step="1" value={f.areaFrom ?? areaMin} data-slo tabindex="-1" />
                <input type="range" min={areaMin} max={areaMax} step="1" value={f.areaTo ?? areaMax} data-shi tabindex="-1" />
              </div>
            </fieldset>
            <fieldset class="range min-w-0" data-range data-min={seaMin} data-max={seaMax} data-step="1">
              <legend class="adv-h4">{tf.sea}</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                <label class="field fld"><span>{tf.fromW}</span><input name="sea_from" inputmode="numeric" placeholder={`${seaMin}`} value={f.seaFrom ?? ''} data-lo aria-label={tf.seaFrom} /></label>
                <label class="field fld"><span>{tf.toW}</span><input name="sea_to" inputmode="numeric" placeholder={`${numL(lang, seaMax)}`} value={f.seaTo ?? ''} data-hi aria-label={tf.seaTo} /></label>
              </div>
              <div class="dual mt-4 hidden lg:block" aria-hidden="true">
                <input type="range" min={seaMin} max={seaMax} step="1" value={f.seaFrom ?? seaMin} data-slo tabindex="-1" />
                <input type="range" min={seaMin} max={seaMax} step="1" value={f.seaTo ?? seaMax} data-shi tabindex="-1" />
              </div>
            </fieldset>
          </div>
          {cat.deal === 'sale' && (
            <div class="mt-5 flex flex-wrap gap-2">
              <label class="cursor-pointer"><input type="checkbox" name="prive" value="1" checked={f.prive} data-sync class="peer sr-only" /><span class="adv-chip peer-checked:!bg-prive peer-checked:text-white">{tf.prive}</span></label>
              <label class="cursor-pointer"><input type="checkbox" name="own" value="1" checked={f.own} data-sync class="peer sr-only" /><span class="adv-chip peer-checked:!bg-own peer-checked:text-white">{OWN_LABEL[lang]}</span></label>
            </div>
          )}

          <h3 class="adv-h2 mt-10 border-t border-line pt-8 lg:mt-14 lg:border-0 lg:pt-0">{A.more}</h3>
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-0 lg:divide-x lg:divide-line">
            {advCols.map((col, i) => (
              <div class:list={[i > 0 && 'lg:pl-8', i < 2 && 'lg:pr-8']}>
                <h4 class="adv-h3">{col.title}</h4>
                {col.groups.map((g) => (
                  <div class="mt-6">
                    <p class="adv-h4">{g.title}</p>
                    {g.floor ? (
                      <div class="grid grid-cols-2 gap-2">
                        <input class="field" name="floor_from" inputmode="numeric" placeholder={tf.fromW} value={f.floorFrom ?? ''} aria-label={`${A.floor} ${tf.fromW}`} />
                        <input class="field" name="floor_to" inputmode="numeric" placeholder={tf.toW} value={f.floorTo ?? ''} aria-label={`${A.floor} ${tf.toW}`} />
                      </div>
                    ) : (
                      <div class="flex flex-wrap gap-2">
                        {g.items.map((it) => (
                          <label class="cursor-pointer">
                            {it.name === 'citizenship'
                              ? <input type="checkbox" name="citizenship" value="1" checked={f.citizenship || cat.feature === 'citizenship'} data-sync class="peer sr-only" />
                              : <input type="checkbox" name="f" value={it.name} checked={f.extras.includes(it.name as FeatureSlug) || cat.feature === it.name} data-feature class="peer sr-only" />}
                            <span class="adv-chip peer-checked:!bg-ink-n peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{it.label}</span>
                          </label>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="fixed inset-x-0 bottom-0 border-t border-line bg-white">
          <div class="mx-auto flex max-w-[1392px] items-center gap-3 px-4 pb-5 pt-4 lg:gap-6 lg:pb-6 lg:pt-5 lg:px-[42px]">
            <a href={`/${lang}/${[cat.country, cat.city, cat.district, cat.deal].filter(Boolean).join('/')}/`} class="order-first inline-flex h-14 shrink-0 items-center justify-center rounded-[16px] bg-[#f0f1f4] px-5 text-[15px] font-medium lg:order-last lg:h-auto lg:bg-transparent lg:px-0 lg:hover:text-accent"><span class="lg:hidden">{A.reset}</span><span class="hidden lg:inline">{A.resetAll} ✕</span></a>
            <button type="button" data-adv-close class="btn-n btn-n-dark min-w-0 flex-1 !bg-ink-n lg:w-[360px] lg:flex-none"><span data-swap="count-btn">{tf.show}: {numL(lang, total)}</span></button>
          </div>
        </div>
      </div>
    </>
  ) : (
    <>
      <!-- Главная — макет, согласованный с директором: вкладки-типы, ряд «Страна / Город / Район / ID»,
           ниже стоимость с тумблерами PRIVE и «Гражданство ТР», планировка кругами, до моря и кнопка «Показать N квартир». -->
      <input type="hidden" name="deal" value="sale" />
      <div class="scroll-x relative flex gap-8 border-b border-line" role="radiogroup" aria-label={tf.type}>
        {homeTypes.map((x) => (
          <label class="shrink-0 cursor-pointer">
            <input type="radio" name="type" value={x} checked={homeType === x} class="peer sr-only" />
            <span class="-mb-px block border-b-2 border-transparent pb-3 pt-2 text-[20px] leading-[26px] tracking-[-0.4px] text-muted transition-colors hover:text-ink peer-checked:border-ink peer-checked:text-ink peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{TYPE_WORDS[lang][x].pl}</span>
          </label>
        ))}
      </div>
      <div class="mt-8 grid grid-cols-4 gap-x-6 gap-y-6">
        <div>
          <label class="hlabel" for="h-country">{tf.country}</label>
          <div class="relative">
            <select id="h-country" name="country" class="hfield appearance-none pr-10" data-country>
              <option value="">{allW}</option>
              {opts.countries.map((c) => <option value={c.slug} selected={preset && cat.country === c.slug}>{c.name[lang]}</option>)}
            </select>
            <Icon name="chevronDown" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted" />
          </div>
        </div>
        <div>
          <label class="hlabel" for="h-city">{tf.city}</label>
          <div class="relative">
            <select id="h-city" name="city" class="hfield appearance-none pr-10" data-city>
              <option value="">{allW}</option>
              {opts.cities.map((c) => <option value={c.slug} data-country={c.country} selected={preset && cat.city === c.slug}>{c.name[lang]}</option>)}
            </select>
            <Icon name="chevronDown" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted" />
          </div>
        </div>
        <div>
          <label class="hlabel" for="h-district">{tf.district}</label>
          <div class="relative">
            <select id="h-district" name="district" class="hfield appearance-none pr-10 disabled:cursor-default" data-district>
              <option value="">{allW}</option>
              {opts.districts.map((x) => <option value={x.d.slug} data-city={x.city} selected={preset && cat.city === x.city && cat.district === x.d.slug}>{x.d.name[lang]}</option>)}
            </select>
            <Icon name="chevronDown" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted" />
          </div>
        </div>
        <div>
          <label class="hlabel" for="h-ref">{tf.id}</label>
          <input id="h-ref" name="ref" class="hfield" placeholder={tf.idPh} maxlength="20" autocomplete="off" value={preset ? f.ref ?? "" : ""} />
        </div>
      </div>
      <div class="mt-6 grid grid-cols-[minmax(0,1.35fr)_auto_minmax(0,1fr)_auto] items-start gap-x-6">
        <fieldset class="range" data-range data-min={priceMin} data-max={priceMax} data-step={step} aria-labelledby="h-price-l">
          <div class="mb-2 flex items-center justify-between gap-3">
            <span class="text-[14px] text-muted" id="h-price-l">{tf.price}</span>
            <span class="flex items-center gap-4" data-sale-only>
              <label class="switch switch-prive"><input type="checkbox" name="prive" value="1" checked={preset && f.prive} /><span>{tf.prive}</span></label>
              <label class="switch"><input type="checkbox" name="citizenship" value="1" checked={preset && f.citizenship} /><span>{tf.citizenship}</span></label>
            </span>
          </div>
          <div class="hsplit">
            <input name="price_from" inputmode="numeric" placeholder={tf.fromW} data-lo aria-label={tf.priceFrom} value={preset && f.priceFrom ? numL(lang, f.priceFrom) : ""} />
            <input name="price_to" inputmode="numeric" placeholder={tf.toW} data-hi aria-label={tf.priceTo} value={preset && f.priceTo ? numL(lang, f.priceTo) : ""} />
          </div>
          <div class="dual dual-home -mt-[9px] px-4" aria-hidden="true">
            <input type="range" min={priceMin} max={priceMax} step={step} value={priceMin} data-slo tabindex="-1" />
            <input type="range" min={priceMin} max={priceMax} step={step} value={priceMax} data-shi tabindex="-1" />
          </div>
        </fieldset>
        <fieldset>
          <legend class="hlabel">{d.item.rooms}</legend>
          <div class="flex gap-2">
            {rooms.map((r) => (
              <label class="cursor-pointer">
                <input type="checkbox" name="rooms" value={r.v} checked={preset && selRooms.has(r.v)} class="peer sr-only" />
                <span class="inline-flex h-[52px] min-w-[52px] items-center justify-center rounded-full bg-white px-3 text-[14px] transition-colors hover:bg-line peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{r.l}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="range" data-range data-min={seaMin} data-max={seaMax} data-step="10" aria-labelledby="h-sea-l">
          <span class="hlabel" id="h-sea-l">{tf.sea}</span>
          <div class="hsplit">
            <input name="sea_from" inputmode="numeric" placeholder={tf.fromW} data-lo aria-label={tf.seaFrom} value={preset ? f.seaFrom ?? "" : ""} />
            <input name="sea_to" inputmode="numeric" placeholder={tf.toW} data-hi aria-label={tf.seaTo} value={preset ? f.seaTo ?? "" : ""} />
          </div>
          <div class="dual dual-home -mt-[9px] px-4" aria-hidden="true">
            <input type="range" min={seaMin} max={seaMax} step="10" value={seaMin} data-slo tabindex="-1" />
            <input type="range" min={seaMin} max={seaMax} step="10" value={seaMax} data-shi tabindex="-1" />
          </div>
        </fieldset>
        <button type="submit" class="btn btn-accent mt-[30px] h-[52px] whitespace-nowrap" data-nouns={JSON.stringify(nouns)}>
          <span>{tf.show} <span data-total>{numL(lang, total)}</span> <span data-noun>{pluralL(lang, total, nouns[homeType])}</span></span><Icon name="chevronRight" class="size-3.5" />
        </button>
      </div>
    </>
  )}
  {catalog && hiddenFeature && <input type="hidden" name="feature" value={hiddenFeature} />}
  {f.sort !== 'new' && <input type="hidden" name="sort" value={f.sort} />}
  <div data-chips hidden></div>
  <noscript><button type="submit" class="btn-n btn-n-dark mt-4">{tf.show}</button></noscript>
</form>

<style>
  .adv-h2 { margin: 28px 0 20px; font-size: 24px; line-height: 30px; font-weight: 500; letter-spacing: -.3px; }
  @media (min-width: 1024px) { .adv-h2 { margin: 36px 0 24px; font-size: 26px; line-height: 32px; } }
  .adv-h3 { font-size: 20px; line-height: 26px; font-weight: 500; }
  @media (min-width: 1024px) { .adv-h3 { font-size: 22px; line-height: 28px; } }
  .adv-h4 { display: block; margin-bottom: 12px; font-size: 16px; line-height: 20px; font-weight: 500; }
  .adv-chip { display: inline-flex; align-items: center; height: 42px; padding: 0 18px; border-radius: 999px; background: #f0f1f4; font-size: 15px; transition: background-color .2s, color .2s; }
  .adv-chip:hover { background: #e4e5ea; }
  .switch { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; color: var(--color-muted); white-space: nowrap; }
  .switch input { appearance: none; position: relative; width: 26px; height: 16px; border-radius: 999px; background: #d9dbe1; transition: background-color .2s; cursor: pointer; flex: none; }
  .switch input::after { content: ''; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 2px #0003; }
  .switch input:checked { background: var(--color-ink); }
  .switch input:checked::after { transform: translateX(10px); }
  .switch input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .switch-prive span { color: #bc906e; }
  .switch-prive input:checked { background: #bc906e; }
  .hlabel { display: block; margin-bottom: 8px; font-size: 14px; line-height: 20px; color: var(--color-muted); }
  .hfield { display: block; width: 100%; height: 52px; padding: 0 16px; border-radius: 12px; background: #fff; border: 1px solid transparent; outline: none; font-size: 14px; color: var(--color-ink); transition: border-color .2s; }
  select.hfield { cursor: pointer; }
  .hfield:hover, .hfield:focus { border-color: var(--color-line-2); }
  .hfield::placeholder { color: var(--color-muted); }
  .hsplit { display: flex; height: 52px; overflow: hidden; border-radius: 12px; background: #fff; }
  .hsplit input { width: 50%; min-width: 0; padding: 0 16px; background: transparent; outline: none; font-size: 14px; }
  .hsplit input + input { border-left: 1px solid var(--color-line); }
  .hsplit input::placeholder { color: var(--color-muted); text-transform: capitalize; }
  /* Поля «от/до» как у образца: «от» серым, граница (минимум/максимум по объектам) — тёмным значением. */
  .fld { display: flex; align-items: center; gap: 8px; cursor: text; }
  .fld:focus-within { border-color: var(--color-ink); }
  .fld > span, .hsplit-v span { flex: none; color: var(--color-muted); font-size: 15px; }
  .fld input { flex: 1; width: 0; min-width: 0; height: 100%; background: transparent; outline: none; font-weight: 500; }
  .fld input::placeholder, .hsplit-v input::placeholder { color: var(--color-ink); font-weight: 500; text-transform: none; }
  .hsplit-v label { display: flex; align-items: center; gap: 6px; width: 50%; min-width: 0; padding-left: 16px; cursor: text; }
  .hsplit-v label + label { border-left: 1px solid var(--color-line); }
  .hsplit-v input { width: 0; min-width: 0; flex: 1; padding: 0 12px 0 0; font-weight: 500; }
  .dual { position: relative; height: 18px; }
  .dual-home::before { left: 16px; right: 16px; background: var(--color-ink); }
  .dual::before { content: ''; position: absolute; left: 0; right: 0; top: 8px; height: 2px; background: var(--color-line-2); border-radius: 2px; }
  .dual input:hover::-webkit-slider-thumb { background: var(--color-accent); }
  /* Поле-выпадашка новой системы: 50, скругление 12, подпись 11 сверху, значение 14/500 */
  .fsel { position: relative; display: block; flex: none; width: 160px; height: 56px; border-radius: 16px; background: #ffffff99; border: .67px solid #d0d1d7b3; transition: border-color .2s; cursor: pointer; }
  @media (min-width: 1024px) { .fsel { width: auto; height: 50px; border-radius: 12px; } }
  .fsel:hover, .fsel:focus-within { border-color: var(--color-ink); }
  .fsel > span { position: absolute; left: 12px; top: 6px; font-size: 11px; line-height: 15px; letter-spacing: .2px; color: var(--color-muted); pointer-events: none; }
  .fsel select, .fsel input { appearance: none; width: 100%; height: 100%; padding: 18px 32px 0 12px; background: transparent; border: 0; outline: none; font-size: 16px; font-weight: 500; letter-spacing: .1px; color: var(--color-ink); text-overflow: ellipsis; cursor: pointer; }
  @media (min-width: 1024px) { .fsel select, .fsel input { font-size: 14px; } }
  .fsel input { cursor: text; padding-right: 12px; }
  .fsel input::placeholder { font-weight: 400; color: #1c1e26cc; }
  :global(.fsel-i) { position: absolute; right: 10px; top: 50%; width: 16px; height: 16px; transform: translateY(-50%); color: var(--color-ink); pointer-events: none; }
  .dual input { position: absolute; inset: 0; width: 100%; appearance: none; background: none; pointer-events: none; margin: 0; }
  .dual input::-webkit-slider-thumb { appearance: none; pointer-events: auto; width: 18px; height: 18px; border-radius: 50%; background: var(--color-ink); border: 3px solid #fff; box-shadow: 0 0 0 1px var(--color-line-2); cursor: pointer; transition: background-color .2s; }
  .dual input::-moz-range-thumb { pointer-events: auto; width: 14px; height: 14px; border-radius: 50%; background: var(--color-ink); border: 3px solid #fff; cursor: pointer; }
</style>

<script>
  import { initFilters } from '../scripts/filter';
  initFilters();
</script>
