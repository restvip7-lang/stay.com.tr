---
/**
 * Фильтр каталога (ТЗ 8.1). Гео, сделка и тип — это части адреса (ЧПУ), остальное — GET-параметры.
 * Сочетание из белого списка (одна комнатность, «до 100/150/200 тыс.», «Гражданство ТР»)
 * переписывает адрес на чистый: …/apartments/2-bedrooms/ вместо ?rooms=2+1.
 * catalog — режим посадочной: выдача обновляется на месте; home — форма на главной ведёт в каталог.
 */
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { INTL } from '../i18n/config';
import { geoOptions, allowedFeatureMap, type Cat, type Filters } from '../lib/catalog';
import { DEAL_WORDS, FEATURE_LABEL, TYPES, TYPE_WORDS, type Deal } from '../lib/segments';
import { numL } from '../lib/format';

interface Props { cat: Cat & { deal: Deal }; f: Filters; total: number; mode?: 'catalog' | 'home'; types?: string[] }
const { cat, f, total, mode = 'catalog' } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const tf = d.filter;
const opts = await geoOptions(cat.deal);
const types = Astro.props.types ?? TYPES;
const priceMin = Math.max(0, Math.floor(opts.priceMin / 1000) * 1000);
const priceMax = Math.ceil(opts.priceMax / (cat.deal === 'rent' ? 1000 : 100000)) * (cat.deal === 'rent' ? 1000 : 100000);
const step = cat.deal === 'rent' ? 50 : 1000;
const seaMin = 1;
const seaMax = 1000;
const catalog = mode === 'catalog';
const advancedOpen = !catalog || !!(f.priceFrom || f.priceTo || cat.feature?.startsWith('price-to') || f.seaFrom || f.seaTo || f.prive || f.citizenship || f.ref);
const rooms = [{ v: 'studio', l: tf.studio }, { v: '1+1', l: '1+1' }, { v: '2+1', l: '2+1' }, { v: '3+1', l: '3+1' }, { v: '4+', l: '4+' }];
const selRooms = new Set(f.rooms);
const allowed = allowedFeatureMap(cat.country);
const loc = INTL[lang];
// Фичи, которые выражаются полями формы: из адреса переносим в поля, клиент соберёт ЧПУ заново.
const pf = cat.feature ?? null;
const pathPriceTo = pf?.startsWith('price-to-') ? Number(pf.slice(9)) : undefined;
const pathRooms = pf ? ({ '1-bedroom': '1+1', '2-bedrooms': '2+1', '3-bedrooms': '3+1', '4-bedrooms': '4+' } as Record<string, string>)[pf] : undefined;
const hiddenFeature = pf && !/bedroom|price-to|citizenship/.test(pf) ? pf : null;
const priceTo = f.priceTo ?? pathPriceTo;
const strings = { found: tf.found, show: tf.show, remove: tf.remove('{l}'), prive: tf.onlyPrive, citizenship: tf.citizenship };
---
<form method="get" action={`/${lang}/`} data-filter data-mode={mode} data-lang={lang} data-loc={loc} data-allowed={JSON.stringify(allowed)} data-t={JSON.stringify(strings)} class="filter">
  <div class="mb-6 flex flex-wrap items-center gap-x-8 gap-y-3">
    <div class="flex gap-1 rounded-full bg-white p-1" role="radiogroup" aria-label={tf.deal}>
      {(['sale', 'rent'] as Deal[]).map((x) => (
        <label class="cursor-pointer">
          <input type="radio" name="deal" value={x} checked={cat.deal === x} class="peer sr-only" />
          <span class="inline-flex h-10 items-center rounded-full px-5 text-[15px] transition-colors peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{DEAL_WORDS[lang][x].name}</span>
        </label>
      ))}
    </div>
    <div class="scroll-x flex gap-5 text-lg md:text-xl" role="radiogroup" aria-label={tf.type}>
      <label class="shrink-0 cursor-pointer">
        <input type="radio" name="type" value="" checked={!cat.type} class="peer sr-only" />
        <span class="border-b-2 border-transparent pb-1 text-muted transition-colors peer-checked:border-ink peer-checked:text-ink hover:text-ink">{tf.anyType}</span>
      </label>
      {types.map((x) => (
        <label class="shrink-0 cursor-pointer">
          <input type="radio" name="type" value={x} checked={cat.type === x} class="peer sr-only" />
          <span class="border-b-2 border-transparent pb-1 text-muted transition-colors peer-checked:border-ink peer-checked:text-ink hover:text-ink">{TYPE_WORDS[lang][x as keyof typeof TYPE_WORDS.ru].pl}</span>
        </label>
      ))}
    </div>
  </div>
  <div class="grid gap-x-4 gap-y-5 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <label class="label" for="f-country">{tf.country}</label>
      <div class="relative">
        <select id="f-country" name="country" class="field appearance-none pr-10" data-country>
          {opts.countries.map((c) => <option value={c.slug} selected={cat.country === c.slug}>{c.name[lang]}</option>)}
        </select>
        <Icon name="chevronDown" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted" />
      </div>
    </div>
    <div>
      <label class="label" for="f-city">{tf.city}</label>
      <div class="relative">
        <select id="f-city" name="city" class="field appearance-none pr-10" data-city>
          <option value="">{tf.allCities}</option>
          {opts.cities.map((c) => <option value={c.slug} data-country={c.country} selected={cat.city === c.slug}>{c.name[lang]}</option>)}
        </select>
        <Icon name="chevronDown" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted" />
      </div>
    </div>
    <div>
      <label class="label" for="f-district">{tf.district}</label>
      <div class="relative">
        <select id="f-district" name="district" class="field appearance-none pr-10" data-district>
          <option value="">{tf.allDistricts}</option>
          {opts.districts.map((x) => <option value={x.d.slug} data-city={x.city} selected={cat.city === x.city && cat.district === x.d.slug}>{x.d.name[lang]}</option>)}
        </select>
        <Icon name="chevronDown" class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted" />
      </div>
    </div>
    <div>
      <label class="label" for="f-ref">{tf.id}</label>
      <input id="f-ref" name="ref" class="field" placeholder={tf.idPh} maxlength="20" autocomplete="off" value={f.ref ?? ''} />
    </div>

    <fieldset class:list={['range', !advancedOpen && 'hidden']} data-adv data-range data-min={priceMin} data-max={priceMax} data-step={step} aria-labelledby="f-price-l">
      <div class="mb-2 flex items-center justify-between gap-2">
        <span class="label mb-0 whitespace-nowrap" id="f-price-l">{tf.price}</span>
        <span class="flex items-center gap-2" data-sale-only hidden={cat.deal !== 'sale'}>
          <label class="switch switch-prive"><input type="checkbox" name="prive" value="1" checked={f.prive} /><span>{tf.prive}</span></label>
          <label class="switch"><input type="checkbox" name="citizenship" value="1" checked={f.citizenship || cat.feature === 'citizenship'} /><span>{tf.citizenship}</span></label>
        </span>
      </div>
      <div class="flex overflow-hidden rounded-full border border-line bg-white">
        <input class="h-12 w-1/2 bg-transparent px-4 text-[15px] outline-none" name="price_from" inputmode="numeric" placeholder={`${tf.fromW} ${numL(lang, priceMin)}`} value={f.priceFrom ? numL(lang, f.priceFrom) : ''} data-lo aria-label={tf.priceFrom} />
        <input class="h-12 w-1/2 border-l border-line bg-transparent px-4 text-[15px] outline-none" name="price_to" inputmode="numeric" placeholder={`${tf.toW} ${numL(lang, priceMax)}`} value={priceTo ? numL(lang, priceTo) : ''} data-hi aria-label={tf.priceTo} />
      </div>
      <div class="dual mt-3" aria-hidden="true">
        <input type="range" min={priceMin} max={priceMax} step={step} value={f.priceFrom ?? priceMin} data-slo tabindex="-1" />
        <input type="range" min={priceMin} max={priceMax} step={step} value={priceTo ?? priceMax} data-shi tabindex="-1" />
      </div>
    </fieldset>

    <fieldset class="lg:col-span-2">
      <legend class="label">{tf.rooms}</legend>
      <div class="flex flex-wrap gap-2">
        {rooms.map((r) => (
          <label class="cursor-pointer">
            <input type="checkbox" name="rooms" value={r.v} checked={selRooms.has(r.v) || pathRooms === r.v} class="peer sr-only" />
            <span class="inline-flex h-12 min-w-12 items-center justify-center rounded-full border border-line bg-white px-4 text-[15px] transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{r.l}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class:list={['range', !advancedOpen && 'hidden']} data-adv data-range data-min={seaMin} data-max={seaMax} data-step="10">
      <legend class="label">{tf.sea}</legend>
      <div class="flex overflow-hidden rounded-full border border-line bg-white">
        <input class="h-12 w-1/2 bg-transparent px-4 text-[15px] outline-none" name="sea_from" inputmode="numeric" placeholder={`${tf.fromW} ${seaMin}`} value={f.seaFrom ?? ''} data-lo aria-label={tf.seaFrom} />
        <input class="h-12 w-1/2 border-l border-line bg-transparent px-4 text-[15px] outline-none" name="sea_to" inputmode="numeric" placeholder={`${tf.toW} ${numL(lang, seaMax)}`} value={f.seaTo ?? ''} data-hi aria-label={tf.seaTo} />
      </div>
      <div class="dual mt-3" aria-hidden="true">
        <input type="range" min={seaMin} max={seaMax} step="10" value={f.seaFrom ?? seaMin} data-slo tabindex="-1" />
        <input type="range" min={seaMin} max={seaMax} step="10" value={f.seaTo ?? seaMax} data-shi tabindex="-1" />
      </div>
    </fieldset>
  </div>
  <!-- Фича из адреса (…/sea-view/) и доп. фича (?f=) — чипсы с крестиком. -->
  {hiddenFeature && <input type="hidden" name="feature" value={hiddenFeature} />}
  {f.extra && <input type="hidden" name="f" value={f.extra} />}
  {f.sort !== 'new' && <input type="hidden" name="sort" value={f.sort} />}
  <div data-chips class="mt-4 flex flex-wrap gap-2 empty:hidden">
    {hiddenFeature && <button type="button" class="chip gap-2 bg-page" data-chip-field="feature" aria-label={tf.remove(FEATURE_LABEL[lang][hiddenFeature])}>{FEATURE_LABEL[lang][hiddenFeature]} <span aria-hidden="true">×</span></button>}
    {f.extra && <button type="button" class="chip gap-2 bg-page" data-chip-field="f" aria-label={tf.remove(FEATURE_LABEL[lang][f.extra])}>{FEATURE_LABEL[lang][f.extra]} <span aria-hidden="true">×</span></button>}
  </div>
  {catalog ? (
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <p class="mr-auto text-[15px]" data-swap="count">{tf.found}: <b data-total class="font-medium">{numL(lang, total)}</b></p>
      <a href={`/${lang}/${[cat.country, cat.city, cat.district, cat.deal].filter(Boolean).join('/')}/`} class="text-sm text-muted hover:text-ink">{tf.reset}</a>
      <button type="button" data-adv-toggle class="btn btn-ghost" aria-expanded={advancedOpen ? 'true' : 'false'}><Icon name="filter" class="size-5" />{tf.all}</button>
      <noscript><button type="submit" class="btn btn-accent">{tf.show}</button></noscript>
    </div>
  ) : (
    <div class="mt-6 flex flex-wrap items-center justify-end gap-3">
      <button type="submit" class="btn btn-accent min-w-[220px]">
        <span>{tf.show} <span data-total>{numL(lang, total)}</span></span><Icon name="chevronRight" class="size-4" />
      </button>
    </div>
  )}
</form>

<style>
  .switch { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; color: var(--color-muted); white-space: nowrap; }
  .switch input { appearance: none; position: relative; width: 26px; height: 16px; border-radius: 999px; background: #d9dbe1; transition: background-color .2s; cursor: pointer; flex: none; }
  .switch input::after { content: ''; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 2px #0003; }
  .switch input:checked { background: var(--color-ink); }
  .switch input:checked::after { transform: translateX(10px); }
  .switch input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .switch-prive span { color: #bc906e; }
  .switch-prive input:checked { background: #bc906e; }
  .dual { position: relative; height: 18px; }
  .dual::before { content: ''; position: absolute; left: 0; right: 0; top: 8px; height: 2px; background: var(--color-ink); border-radius: 2px; }
  .dual input { position: absolute; inset: 0; width: 100%; appearance: none; background: none; pointer-events: none; margin: 0; }
  .dual input::-webkit-slider-thumb { appearance: none; pointer-events: auto; width: 18px; height: 18px; border-radius: 50%; background: var(--color-ink); border: 3px solid #fff; box-shadow: 0 0 0 1px var(--color-ink); cursor: pointer; }
  .dual input::-moz-range-thumb { pointer-events: auto; width: 14px; height: 14px; border-radius: 50%; background: var(--color-ink); border: 3px solid #fff; cursor: pointer; }
</style>

<script>
  import { initFilters } from '../scripts/filter';
  initFilters();
</script>
