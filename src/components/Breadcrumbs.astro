---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, item: it.href ? new URL(it.href, Astro.site).toString() : undefined })),
};
---
<nav aria-label="Хлебные крошки" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">·</span>}
        {it.href ? <a href={it.href} class="hover:text-ink">{it.label}</a> : <span class="text-ink" aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</nav>
