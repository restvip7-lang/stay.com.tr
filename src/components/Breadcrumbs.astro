---
/** Хлебные крошки: <nav aria-label="breadcrumb"><ol>… + BreadcrumbList (ТЗ 6.1). */
import { breadcrumbLd } from '../lib/ld';
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">·</span>}
        {it.href && i < items.length - 1 ? <a href={it.href} class="hover:text-ink">{it.label}</a> : <span class="text-ink" aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd(items))} />
</nav>
