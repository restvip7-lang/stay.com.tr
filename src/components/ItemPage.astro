---
/**
 * Карточка объекта (ТЗ 3.3, 13): цена в EUR + переключатель валют, характеристики таблицей <dl>,
 * описание на языке страницы, галерея, карта района, комплекс, чипсы-ссылки на фича-лендинги,
 * «Купить безопасно», похожие ±20% по цене, форма заявки. Проданный объект — плашка и похожие.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Gallery from './Gallery.astro';
import Calculator from './Calculator.astro';
import LeadSection from './LeadSection.astro';
import SaleCard from './SaleCard.astro';
import Icon from './Icon.astro';
import ManagerCard from './ManagerCard.astro';
import { t } from '../i18n/ui';
import { LABEL_TEXT, LABEL_STYLE } from '../lib/objectsConfig';
import { LANGS, SITE, type Lang } from '../i18n/config';
import { getDetailL, type DetailL } from '../lib/api';
import { getItems, getUnits, itemUrl, catUrl, countOf, getComplexes, complexUrl, INDEX_MIN, type Item } from '../lib/catalog';
import { cityBySlug, districtBySlug } from '../lib/geo';
import { geoOf, itemMeta } from '../lib/seo';
import { FEATURE_LABEL, TYPE_WORDS } from '../lib/segments';
import { catCrumbs, SERVICE_TITLES } from '../lib/nav';
import { listingLd, videoLd } from '../lib/ld';
import { moneyL, numL, dateL, strip } from '../lib/format';
import { sanitize } from '../lib/sanitize';
import { site } from '../lib/site';
import type { Robots } from '../lib/page';
import { pickerLinkFor, PICKER_TEXT } from '../lib/pickers';

interface Props { x: Item; sold?: boolean; soldAt?: string | null }
const { x, sold = false, soldAt = null } = Astro.props;
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const ti = d.item;
const op = x.deal === 'rent' ? 'rental' : 'sale';
const g = geoOf(x);
const city = cityBySlug(x.city)!;
const district = x.district ? districtBySlug(x.city, x.district) : null;
const place = [district?.name[lang], city.name[lang]].filter(Boolean).join(', ');
const tw = TYPE_WORDS[lang][x.type];

// Переводы описания: у квартир в проектах Stay описание только на русском.
const details: Partial<Record<Lang, DetailL | null>> = {};
if (x.unit) details.ru = null;
else await Promise.all(LANGS.map(async (l) => { details[l] = await getDetailL(x.id, op, l); }));
const own = details[lang] ?? null;
const fallback = own ?? (lang === 'tr' || lang === 'de' ? details.en ?? details.ru : details.ru ?? details.en) ?? null;
const translated = LANGS.filter((l) => details[l]);
const self = itemUrl(lang, x);
// Квартира ЖК с подборщиком — ссылка на неё на плане.
const onPlan = sold ? null : await pickerLinkFor(x, lang).catch(() => null);
// hreflang — только между языками, где у объекта есть перевод (ТЗ 4.2).
const alternates = Object.fromEntries((translated.length ? translated : (['ru'] as Lang[])).map((l) => [l, itemUrl(l, x)]));
const hasText = !!own || (x.unit && lang === 'ru');
const robots: Robots = hasText ? 'index,follow' : 'noindex,follow';

const images = fallback?.images?.length ? fallback.images : x.image ? [x.image] : [];
const descHtml = own?.html ? sanitize(own.html) : '';
const fallbackHtml = !own && fallback?.html ? sanitize(fallback.html) : '';
const descText = strip(own?.html || '', 300);
const meta = itemMeta(lang, x, g, descText || `${tw.one}${x.rooms ? ' ' + x.rooms : ''} ${place}. ${moneyL(lang, x.price)}`);
const altBase = `${tw.one}${x.rooms ? ` ${x.rooms}` : ''}${district ? ` — ${district.name[lang]}` : ''}${x.area ? `, ${numL(lang, x.area)} ${d.m2}` : ''}`;

const price = x.price ? moneyL(lang, x.price) + (x.deal === 'rent' ? d.perMonth : '') : d.priceOnRequest;
const perM2 = (own ?? fallback)?.pricePerSquare ?? (x.price && x.area && x.deal === 'sale' ? Math.round(x.price / x.area) : null);
const isNew = x.features.includes('new');
const complex = x.complex ? (await getComplexes()).find((c) => c.code === x.complex) ?? null : null;
// Чипсы-фичи → ссылки на фича-лендинги района (если там ≥3 объектов, иначе города).
const chipLinks = (await Promise.all(x.features.filter((f) => !/price-to/.test(f)).map(async (f) => {
  for (const c of [{ country: x.country, city: x.city, district: x.district ?? undefined, deal: x.deal, type: x.type, feature: f }, { country: x.country, city: x.city, deal: x.deal, type: x.type, feature: f }]) {
    if ((await countOf(c)) >= INDEX_MIN) return { slug: f, href: catUrl(lang, c), text: FEATURE_LABEL[lang][f] };
  }
  return { slug: f, href: null as string | null, text: FEATURE_LABEL[lang][f] };
})));

// Признаки, которые уже есть строкой в «Характеристиках» (планировка, мебель, новостройка/вторичка), показываем там ссылкой, а не чипсом.
const chipOf = (slug: string) => chipLinks.find((c) => c.slug === slug) ?? null;
const usedChips = new Set<string>();
const linkOf = (slug: string) => { const c = chipOf(slug); if (c) usedChips.add(slug); return c?.href ?? undefined; };
const bedSlug = chipLinks.find((c) => /bedroom/.test(c.slug))?.slug ?? '';
// Характеристики зависят от типа (Anuar 28.11.2026: «у нас квартиры, виллы и т. д.»): у квартиры — этаж и этажность дома,
// у виллы — участок и этажи самой виллы. Каждый факт на странице один раз: только здесь, без повторов в шапке.
// Поля сверх карточки берём из мета-полей Portfolio по именам (extra) — какие заполнены, те и видны.
const X = { ...((own ?? fallback)?.extra ?? {}) } as Record<string, string>;
const ex = (re: RegExp) => Object.entries(X).find(([k, v]) => re.test(k) && v && !/^(0|-|no|n|нет|null)$/i.test(v.trim()))?.[1]?.trim() ?? null;
const exAny = (re: RegExp) => Object.entries(X).find(([k, v]) => re.test(k) && v)?.[1]?.trim() ?? null;
const XT = {
  floorOf: { ru: 'из', en: 'of', tr: '/', de: 'von', sr: 'od' }[lang],
  floorsTotal: { ru: 'Этажей в доме', en: 'Floors in building', tr: 'Bina kat sayısı', de: 'Etagen im Haus', sr: 'Spratova u zgradi' }[lang],
  villaFloors: { ru: 'Этажей', en: 'Floors', tr: 'Kat sayısı', de: 'Etagen', sr: 'Spratova' }[lang],
  bedrooms: { ru: 'Спальни', en: 'Bedrooms', tr: 'Yatak odası', de: 'Schlafzimmer', sr: 'Spavaće sobe' }[lang],
  baths: { ru: 'Санузлы', en: 'Bathrooms', tr: 'Banyo', de: 'Badezimmer', sr: 'Kupatila' }[lang],
  furniture: { ru: 'Мебель', en: 'Furniture', tr: 'Eşya', de: 'Möblierung', sr: 'Nameštaj' }[lang],
  land: { ru: 'Участок', en: 'Plot', tr: 'Arsa', de: 'Grundstück', sr: 'Plac' }[lang],
  purpose: { ru: 'Назначение', en: 'Zoning', tr: 'İmar durumu', de: 'Nutzung', sr: 'Namena' }[lang],
  communication: { ru: 'Коммуникации', en: 'Utilities', tr: 'Altyapı', de: 'Erschließung', sr: 'Infrastruktura' }[lang],
  business: { ru: 'Тип помещения', en: 'Premises type', tr: 'İşyeri türü', de: 'Gewerbeart', sr: 'Vrsta prostora' }[lang],
  view: { ru: 'Вид', en: 'View', tr: 'Manzara', de: 'Aussicht', sr: 'Pogled' }[lang],
  toCenter: { ru: 'До центра', en: 'To the centre', tr: 'Merkeze', de: 'Zum Zentrum', sr: 'Do centra' }[lang],
  toAirport: { ru: 'До аэропорта', en: 'To the airport', tr: 'Havalimanına', de: 'Zum Flughafen', sr: 'Do aerodroma' }[lang],
  yes: { ru: 'Есть', en: 'Yes', tr: 'Var', de: 'Ja', sr: 'Da' }[lang],
  no: { ru: 'Нет', en: 'No', tr: 'Yok', de: 'Nein', sr: 'Ne' }[lang],
  km: { ru: 'км', en: 'km', tr: 'km', de: 'km', sr: 'km' }[lang],
};
const yesNo = (v: string | null) => (v == null ? null : /^(y|yes|1|true|да|var|furnished|full)/i.test(v) ? XT.yes : /^(n|no|0|false|нет|yok|unfurnished)/i.test(v) ? XT.no : v);
// Расстояние: «1.2 km» оставляем как есть; число — метры, а для аэропорта до 300 — километры.
const dist = (v: string | null, kmBelow = 0) => {
  if (!v) return null;
  if (/[a-zа-я]/i.test(v)) return v;
  const n = Number(v.replace(',', '.'));
  if (!Number.isFinite(n) || n <= 0) return null;
  if (n < kmBelow || n >= 1000) return `${numL(lang, n >= 1000 ? Math.round(n / 100) / 10 : n)} ${XT.km}`;
  return `${numL(lang, n)} ${d.m}`;
};
const isHouse = x.type === 'villas' || x.type === 'townhouses';
const isFlat = x.type === 'apartments' || x.type === 'penthouses' || x.type === 'duplexes';
const floorsTotal = ex(/^(floors_total|floors_count|number_of_floors|building_floors|storeys)$/i);
const land = ex(/land|plot|участ/i);
const views = (own ?? fallback)?.view ?? [];
const facts: [string, string | null, string?][] = [
  [ti.type, `${tw.one}${x.rooms ? ` ${x.rooms}` : ''}`],
  [ti.rooms, x.rooms, x.rooms && bedSlug ? linkOf(bedSlug) : undefined],
  [ti.area, x.area ? `${numL(lang, x.area)} ${d.m2}` : null],
  ...(isFlat ? [
    [ti.floor, x.floor ? `${x.floor}${floorsTotal ? ` ${XT.floorOf} ${floorsTotal}` : ''}` : null],
    [XT.floorsTotal, !x.floor ? floorsTotal : null],
  ] as [string, string | null][] : []),
  ...(isHouse || x.type === 'land' ? [
    [XT.land, land ? (/\d$/.test(land) ? `${numL(lang, Number(land) || 0) || land} ${d.m2}` : land) : null],
  ] as [string, string | null][] : []),
  ...(isHouse ? [
    [XT.villaFloors, ex(/^(floors_villa|villa_floors|floors)$/i)],
    [XT.bedrooms, x.bedrooms ? String(x.bedrooms) : ex(/^bedrooms$/i)],
  ] as [string, string | null][] : []),
  ...(x.type === 'land' ? [
    [XT.purpose, ((own ?? fallback)?.purpose ?? []).join(', ') || null],
    [XT.communication, ex(/communication/i)],
  ] as [string, string | null][] : []),
  ...(x.type === 'commercial' ? [
    [XT.business, ((own ?? fallback)?.businessType ?? []).join(', ') || null],
  ] as [string, string | null][] : []),
  ...(x.type !== 'land' ? [
    [XT.baths, ex(/^(toilet|bath|bathrooms|wc)$|санузл/i)],
    [XT.furniture, x.type !== 'commercial' ? (yesNo(exAny(/furni|мебел/i)) ?? (chipOf('furnished') ? XT.yes : null)) : null, chipOf('furnished') ? linkOf('furnished') : undefined],
  ] as [string, string | null, string?][] : []),
  [XT.view, views.length ? views.join(', ') : null],
  [ti.toSea, x.sea ? (x.sea >= 10000 ? dist(String(x.sea)) : `${numL(lang, x.sea)} ${d.m}`) : null],
  [XT.toCenter, dist(ex(/cent(er|re)|центр/i), 30)],
  [XT.toAirport, dist(ex(/airport|аэропорт/i), 300)],
  [ti.year, (own ?? fallback)?.yearBuilt ?? null],
  [ti.status, x.deal === 'sale' ? (isNew ? ti.newBuild : x.features.includes('resale') ? ti.resale : null) : null, x.deal === 'sale' ? (isNew ? linkOf('new') : x.features.includes('resale') ? linkOf('resale') : undefined) : undefined],
  [ti.district, district?.name[lang] ?? null, x.district ? catUrl(lang, { country: x.country, city: x.city, district: x.district }) : undefined],
  [ti.city, city.name[lang], catUrl(lang, { country: x.country, city: x.city })],
  [ti.complex, complex?.title ?? null, complex ? complexUrl(lang, complex) : undefined],
  [ti.id, x.ref ?? x.id],
];
// Инфраструктура: у квартиры — комплекса, у виллы — то, что на её территории.
// В Portfolio у части удобств русская подпись не заполнена (приходит английская) — переводим известные.
const INFRA_RU: Record<string, string> = { "children's swimming pool": 'Детский бассейн', 'kids pool': 'Детский бассейн', 'kids club': 'Детский клуб', 'playground': 'Детская площадка', 'garden': 'Сад', 'elevator': 'Лифт', 'lift': 'Лифт', 'security': 'Охрана', 'parking': 'Парковка', 'gym': 'Фитнес-центр', 'sauna': 'Сауна', 'jacuzzi': 'Джакузи', 'tennis court': 'Теннисный корт', 'barbecue': 'Зона барбекю', 'bbq': 'Зона барбекю' };
const infraList = [...new Set(((own ?? fallback)?.infrastructure ?? []).map((s) => (lang === 'ru' && !/[а-яё]/i.test(s) ? INFRA_RU[s.trim().toLowerCase()] ?? s : s)))];
const restChips = chipLinks.filter((c) => !usedChips.has(c.slug));
const infraTitle = isHouse
  ? { ru: 'На территории', en: 'On the property', tr: 'Mülkte', de: 'Auf dem Grundstück', sr: 'Na imanju' }[lang]
  : complex || isFlat
    ? { ru: 'Инфраструктура комплекса', en: 'Complex amenities', tr: 'Site olanakları', de: 'Ausstattung der Anlage', sr: 'Sadržaji kompleksa' }[lang]
    : ti.infra;

// Похожие: та же сделка, город и тип, цена ±20%; сначала тот же район.
// PRIVE только в разделе PRIVE (Anuar 26.11.2026): у обычного объекта — без PRIVE (кроме наших проектов), у PRIVE-объекта — только PRIVE.
const pool = x.unit ? await getUnits() : await getItems();
const similar = pool
  .filter((y) => (x.isPrivate ? y.isPrivate : !y.isPrivate || y.own))
  .filter((y) => y.id !== x.id && y.label !== 'sold' && y.deal === x.deal && y.city === x.city && y.type === x.type && (!x.price || (y.price && Math.abs(y.price - x.price) <= x.price * 0.2)))
  .sort((a, b) => Number(b.district === x.district) - Number(a.district === x.district) || Math.abs((a.price ?? 0) - (x.price ?? 0)) - Math.abs((b.price ?? 0) - (x.price ?? 0)))
  .slice(0, 6);

const crumbs = catCrumbs(lang, { country: x.country, city: x.city, district: x.district ?? undefined, deal: x.deal, type: x.type }, meta.h1);
const video = (own ?? fallback)?.video ?? null;
const vld = video ? videoLd(video, meta.h1, meta.description, (own ?? fallback)?.updated ?? new Date().toISOString()) : null;
const updated = (own ?? fallback)?.updated ?? null;
const ld = [
  listingLd({
    url: self, name: meta.h1, description: meta.description, images: images.slice(0, 8), price: x.price, deal: x.deal, type: x.type,
    rooms: x.bedrooms != null ? x.bedrooms + 1 : null, area: x.area, city: city.name.en, region: district?.name.en ?? city.name.en, country: x.country === 'turkey' ? 'TR' : x.country === 'uae' ? 'AE' : 'CY', sold, updated: updated ?? undefined,
  }),
  ...(vld ? [vld] : []),
];
const fav = { id: x.id, url: self, title: `${tw.one}${x.rooms ? ' ' + x.rooms : ''}`, image: x.image, price, meta: place };
const ytId = video?.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? null;
const mapPoint = complex?.lat && complex?.lng ? { lat: complex.lat, lng: complex.lng } : city.lat && city.lng ? { lat: city.lat, lng: city.lng } : null;
const ogImage = `/og/item/${x.deal}/${x.id}.jpg?lang=${lang}`;
const lessW = ({ ru: 'Свернуть', en: 'Show less', tr: 'Daha az göster', de: 'Weniger anzeigen', sr: 'Prikaži manje' } as Record<string, string>)[lang] ?? 'Свернуть';
---
<Base system="new" title={meta.title} description={meta.description} canonical={self} robots={robots} alternates={alternates} image={ogImage} ogType="product" jsonLd={ld}>
  <div class="container-n pt-5 lg:pt-6">
    <Breadcrumbs items={crumbs} />
    {sold && (
      <div class="mt-5 rounded-[var(--radius-big)] bg-ink p-5 text-white md:p-6" role="status">
        <p class="text-xl font-medium">{d.sold}</p>
        {soldAt && <p class="mt-1 text-white/70">{d.pages.goneText} · {dateL(lang, soldAt)}</p>}
        <a href="#similar" class="btn-n btn-n-white mt-4">{ti.similar}</a>
      </div>
    )}
    <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,868fr)_minmax(0,424fr)] lg:grid-rows-[auto_1fr]">
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <div class="card-n p-3">
          <div class="flex items-start justify-between gap-4 px-2 pb-5 pt-2 lg:px-5 lg:pt-5">
            <div class="min-w-0">
              <h1 class="text-[21px] font-medium leading-[26px] tracking-[.2px] text-ink lg:text-[20px] lg:leading-[24px] lg:tracking-[.1px]">{meta.h1}</h1>
              <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px] leading-[20px] text-soft">
                {complex ? <a href={complexUrl(lang, complex)} class="font-medium text-ink hover:text-accent">{complex.title}</a> : <span class="font-medium text-ink">{tw.one}{x.rooms ? ` ${x.rooms}` : ''}</span>}
                <span aria-hidden="true">·</span><span>{place}</span>
              </p>
            </div>
            <div class="flex shrink-0 gap-2">
              <button type="button" data-share class="btn-n btn-n-white btn-n-icon" aria-label={d.share}><Icon name="share" class="size-4" /></button>
              <button type="button" data-fav={x.id} data-fav-item={JSON.stringify(fav)} aria-pressed="false" class="btn-n btn-n-white btn-n-icon" aria-label={d.addFav}><Icon name="heart" class="size-5" /></button>
            </div>
          </div>
          <Gallery images={images} alt={altBase} />
        </div>
      </div>

      <div class="space-y-5 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div class="card-n p-5">
          {x.label && x.label !== 'sold' && <p class="mb-3"><span class="badge badge-solid" style={LABEL_STYLE[x.label]}>{LABEL_TEXT[lang][x.label]}</span></p>}
          <p class:list={['text-[22px] font-medium leading-[27px] tracking-[.6px] text-ink-n', sold && 'text-muted line-through']} data-price-eur={x.price ?? ''} data-price-suffix={x.deal === 'rent' ? d.perMonth : ''}>{price}</p>
          {perM2 && <p class="mt-1 text-[14px] leading-[20px] text-soft"><span data-m2-eur={perM2}>{moneyL(lang, perM2)}</span> {ti.perM2}</p>}
          {x.price && (
            <div class="mt-3 flex flex-wrap items-center gap-1.5 text-sm" data-currency>
              <span class="sr-only">{ti.currency}</span>
              {['EUR', 'USD', 'GBP', 'TRY'].map((c) => <button type="button" data-cur={c} class:list={['cur-chip', c === 'EUR' && 'is-on']} aria-pressed={c === 'EUR' ? 'true' : 'false'}>{c}</button>)}
            </div>
          )}
          <div class="mt-4 flex flex-wrap gap-1.5">
            <span class="badge">{x.deal === 'rent' ? d.rent : d.sale}</span>
            {x.isPrivate && <span class="badge badge-solid" style="background:#bc906e;color:#fff">PRIVE</span>}
          </div>
          {!sold && <a href="#lead" class="btn-n btn-n-dark mt-5 w-full"><Icon name="phone" class="size-4" />{ti.book}</a>}
          <a href={site.phones[0].href} target="_blank" rel="noopener" class="btn-n btn-n-white mt-2 w-full"><Icon name="whatsapp" class="size-4" />{d.whatsapp}</a>
          {onPlan && <a href={onPlan} class="btn-n btn-n-white mt-2 w-full"><Icon name="layout" class="size-4" />{PICKER_TEXT[lang].onPlan}</a>}
        </div>
        {!sold && <ManagerCard objectId={x.ref ?? x.id} url={self} />}
        <div class="card-n p-5">
          <h2 class="text-[19px] font-medium leading-[24px] lg:text-[18px] lg:leading-[22px]">{ti.specs}</h2>
          <dl class="mt-4 space-y-3 text-[14px] font-medium leading-[20px] tracking-[.2px]">
            {facts.filter(([, v]) => v).map(([k, v, href]) => (
              <div class="flex justify-between gap-4"><dt class="text-soft">{k}</dt><dd class="text-right text-ink">{href ? <a href={href} class="underline underline-offset-4 hover:text-accent">{v}</a> : v}</dd></div>
            ))}
          </dl>
          {updated && <p class="mt-5 text-xs text-muted">{ti.updated(dateL(lang, updated))}</p>}
        </div>
        <a href={`/${lang}/services/due-diligence/`} aria-label={SERVICE_TITLES[lang]['due-diligence']} class="group flex items-center justify-between gap-4 rounded-[20px] bg-[#e8e9ee] p-5 transition hover:bg-white">
          <span>
            <span class="block text-[14px] font-medium leading-[20px]">{ti.safeBuy}</span>
            <span class="mt-0.5 block text-[14px] leading-[20px] text-soft">{ti.safeBuyText}</span>
          </span>
          <span class="grid size-11 shrink-0 place-items-center rounded-[12px] bg-white text-ink-2 shadow-[var(--shadow-btn)]"><Icon name="arrowRight" class="size-4" /></span>
        </a>
        {x.deal === 'sale' && !sold && (
          <div class="card-n p-5">
            <h2 class="mb-4 text-[18px] font-medium leading-[22px]">{ti.calc}</h2>
            <Calculator price={x.price} compact />
          </div>
        )}
      </div>
      <!-- Левая колонка под галереей: особенности и описание (свёрнуто, раскрывается по кнопке). -->
      <div class="space-y-5 self-start lg:col-start-1 lg:row-start-2">
        <section class="card-n p-5 lg:p-6" aria-labelledby="desc-h">
          <h2 id="desc-h" class="mb-3 text-[18px] font-medium leading-[22px]">{ti.description}</h2>
          {descHtml ? <div class="prose-stay about-text" data-clamp set:html={descHtml} /> : (
            <>
              <p class="mb-4 rounded-[16px] bg-page-n p-4 text-sm">{ti.noText}</p>
              {fallbackHtml && <div class="prose-stay about-text text-ink/80" data-clamp lang={details.en && (lang === 'tr' || lang === 'de') ? 'en' : 'ru'} set:html={fallbackHtml} />}
            </>
          )}
          <button type="button" data-clamp-btn hidden aria-expanded="false" data-more={d.showMore} data-less={lessW} class="mt-3 inline-flex items-center gap-1 text-[14px] font-medium text-accent hover:underline"><span>{d.showMore}</span><Icon name="chevronDown" class="size-4 transition-transform" /></button>
        </section>
        {infraList.length > 0 && (
          <section class="card-n p-5 lg:p-6" aria-labelledby="infra-h">
            <h2 id="infra-h" class="mb-4 text-[18px] font-medium leading-[22px]">{infraTitle}</h2>
            <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
              {infraList.map((s) => (
                <li class="flex items-center gap-3 text-[14px] leading-[20px]"><span class="grid size-7 shrink-0 place-items-center rounded-[8px] bg-accent/10 text-accent"><Icon name="check" class="size-4" /></span>{s}</li>
              ))}
            </ul>
          </section>
        )}
        {restChips.length > 0 && (
          <section class="card-n p-5 lg:p-6" aria-labelledby="feat-h">
            <h2 id="feat-h" class="mb-3 text-[18px] font-medium leading-[22px]">{ti.features}</h2>
            <ul class="flex flex-wrap gap-2">{restChips.map((c) => <li>{c.href ? <a href={c.href} class="chip-n">{c.text}</a> : <span class="chip-n">{c.text}</span>}</li>)}</ul>
          </section>
        )}
      </div>
    </div>
  </div>

  {ytId && (
    <section class="container-n mt-20 lg:mt-28">
      <h2 class="display h-section-n mb-6">{d.complex.video}</h2>
      <div class="relative aspect-video overflow-hidden rounded-[20px] bg-ink" data-yt={ytId}>
        <button type="button" class="group absolute inset-0 grid place-items-center" aria-label={d.complex.video}>
          <img src={`https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" class="absolute inset-0 size-full object-cover opacity-80" />
          <span class="relative grid size-14 place-items-center rounded-[16px] bg-white text-ink shadow-lg"><Icon name="play" class="size-6" /></span>
        </button>
      </div>
    </section>
  )}

  {mapPoint && (
    <section class="container-n mt-20 lg:mt-28">
      <div class="panel p-5 lg:p-10">
        <h2 class="display h-section-n mb-2">{ti.map}</h2>
        <p class="mb-6 text-[14px] text-soft">{ti.mapNote}</p>
        <div data-map data-zoom="12" data-points={JSON.stringify([{ t: place, u: '', lat: mapPoint.lat, lng: mapPoint.lng, a: place }])} class="h-[380px] overflow-hidden rounded-[20px] bg-page-n lg:h-[480px]"></div>
      </div>
    </section>
  )}

  {x.deal === 'rent'
    ? <LeadSection n context={`rental-${x.id}`} booking title={ti.book} submitLabel={ti.book} />
    : <LeadSection n context={`listing-${x.id}`} />}

  {similar.length > 0 && (
    <section id="similar" class="container-n mt-20 scroll-mt-28 lg:mt-28">
      <h2 class="display h-section-n mb-6 lg:mb-8">{ti.similar}</h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{similar.map((s) => <li><SaleCard x={s} /></li>)}</ul>
      <a href={catUrl(lang, { country: x.country, city: x.city, district: x.district ?? undefined, deal: x.deal, type: x.type })} class="btn-n btn-n-white mt-8">{d.catalog.allIn(district?.in[lang] ?? city.in[lang])}<Icon name="arrowRight" class="size-4" /></a>
    </section>
  )}
</Base>
<style>
  .cur-chip { height: 28px; padding: 0 10px; border-radius: 1000px; border: .67px solid #d0d1d7; font-size: 12px; font-weight: 500; color: var(--color-soft); transition: color .2s, border-color .2s; }
  .cur-chip:hover, .cur-chip.is-on { color: var(--color-ink); border-color: var(--color-ink); }
  .about-text { font-size: 16px; line-height: 22px; letter-spacing: .2px; color: var(--color-ink-n); }
  .about-text[data-clamped] { max-height: 176px; overflow: hidden; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
</style>
<script>
  import { T } from '../scripts/client';
  import { initCurrency } from '../scripts/currency';
  import { mountMap } from '../scripts/map';
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else { await navigator.clipboard.writeText(location.href); b.title = T().linkCopied; }
    } catch { /* отмена */ }
  }));
  initCurrency();
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((v) => v.querySelector('button')?.addEventListener('click', () => {
    v.innerHTML = `<iframe class="absolute inset-0 size-full" src="https://www.youtube-nocookie.com/embed/${v.dataset.yt}?autoplay=1&rel=0" title="Video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
  }));
  // «Показать ещё» у длинного описания
  const txt = document.querySelector<HTMLElement>('[data-clamp]');
  const more = document.querySelector<HTMLButtonElement>('[data-clamp-btn]');
  if (txt && more && txt.scrollHeight > 240) {
    txt.dataset.clamped = '';
    more.hidden = false;
    more.addEventListener('click', () => {
      const open = 'clamped' in txt.dataset;
      if (open) delete txt.dataset.clamped; else txt.dataset.clamped = '';
      more.setAttribute('aria-expanded', String(open));
      more.querySelector('span')!.textContent = (open ? more.dataset.less : more.dataset.more) ?? '';
      more.querySelector('svg')?.classList.toggle('rotate-180', open);
      if (!open) txt.closest('section')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  }
  const mapEl = document.querySelector<HTMLElement>('[data-map]');
  if (mapEl) {
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); mountMap(mapEl); } }, { rootMargin: '200px' });
    io.observe(mapEl);
  }
</script>
