---
interface Props { steps?: string[]; title?: string }
const {
  title = 'Как это работает',
  steps = [
    'Выбираете объект в каталоге STAY Property',
    'Оставляете заявку',
    'Получаете консультацию по покупке',
    'Согласовываете условия бронирования',
    'Переходите к оформлению сделки',
  ],
} = Astro.props;
---
<div>
  <h3 class="display mb-6 text-[clamp(24px,2.4vw,32px)]">{title}</h3>
  <ol class="relative space-y-5">
    {steps.map((s, i) => (
      <li class="relative flex items-center gap-4">
        {i < steps.length - 1 && <span class="absolute left-[15px] top-8 h-5 w-px bg-lavender" aria-hidden="true"></span>}
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-lavender-2 text-sm font-medium text-accent">{i + 1}</span>
        <span>{s}</span>
      </li>
    ))}
  </ol>
</div>
