---
import { t } from '../i18n/ui';
interface Props { steps?: string[]; title?: string; dark?: boolean }
const f = t(Astro.locals.lang ?? 'ru').form;
const { title = f.how, steps = f.steps, dark = false } = Astro.props;
---
<div>
  <p class:list={['display mb-6', dark ? 'text-[20px] leading-[26px] lg:text-[22px] lg:leading-[28px]' : 'text-[clamp(24px,2.4vw,32px)]']}>{title}</p>
  <ol class="relative space-y-5">
    {steps.map((s, i) => (
      <li class="relative flex items-center gap-4">
        {i < steps.length - 1 && <span class:list={['absolute left-[15px] top-8 h-5 w-px', dark ? 'bg-white/20' : 'bg-lavender']} aria-hidden="true"></span>}
        <span class:list={['grid size-8 shrink-0 place-items-center rounded-full text-sm font-medium', dark ? 'bg-white/15 text-white' : 'bg-lavender-2 text-accent']}>{i + 1}</span>
        <span class:list={[dark && 'text-white/80']}>{s}</span>
      </li>
    ))}
  </ol>
</div>
