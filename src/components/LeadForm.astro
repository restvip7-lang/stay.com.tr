---
// Форма заявки. По решению Anuar заявки пока никуда не отправляются:
// после нажатия посетитель видит «Спасибо», данные остаются только в браузере.
// booking — форма бронирования аренды: даты заезда и выезда в календаре + комментарий.
import { t } from '../i18n/ui';
interface Props { title?: string; subtitle?: string; context?: string; compact?: boolean; submitLabel?: string; booking?: boolean; headingLevel?: 'h2' | 'h3' | 'p' }
const lang = Astro.locals.lang ?? 'ru';
const f = t(lang).form;
const {
  title = f.title,
  subtitle = f.subtitle,
  context = '',
  compact = false,
  submitLabel = f.send,
  booking = false,
  headingLevel = 'h2',
} = Astro.props;
const H = headingLevel;
---
<form data-lead-form class="lead-form" novalidate>
  {!compact && <H class="display mb-2 text-[clamp(26px,2.4vw,32px)]">{title}</H>}
  {!compact && <p class="mb-6 max-w-md text-muted">{subtitle}</p>}
  <input type="hidden" name="context" value={context} />
  <div class="grid gap-3">
    <label class="sr-only" for={`n-${context}`}>{f.name}</label>
    <input id={`n-${context}`} class="field" name="name" autocomplete="name" placeholder={f.name} required />
    <label class="sr-only" for={`p-${context}`}>{f.phone}</label>
    <input id={`p-${context}`} class="field" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={f.phone} required />
    {booking && (
      <div data-range-picker class="relative">
        <div class="grid grid-cols-2 gap-3">
          <button type="button" data-rp-open="in" class="field flex items-center text-left text-muted"><span data-rp-label="in">{f.checkIn}</span></button>
          <button type="button" data-rp-open="out" class="field flex items-center text-left text-muted"><span data-rp-label="out">{f.checkOut}</span></button>
        </div>
        <input type="hidden" name="check_in" data-rp-value="in" />
        <input type="hidden" name="check_out" data-rp-value="out" />
        <div data-rp-pop hidden class="absolute left-0 top-[56px] z-20 w-[min(340px,100%)] rounded-2xl border border-line bg-white p-4 shadow-[var(--shadow-card)]"></div>
      </div>
    )}
    {booking && (
      <>
        <label class="sr-only" for={`c-${context}`}>{f.comment}</label>
        <textarea id={`c-${context}`} name="comment" rows="3" class="field h-auto rounded-[24px] py-3" placeholder={f.comment}></textarea>
      </>
    )}
    <p data-error class="hidden text-sm text-red-600" role="alert"></p>
    <button class="btn btn-accent mt-2 w-full" type="submit">{submitLabel}</button>
    <p class="text-xs text-muted">{f.consent} <a href={`/${lang}/privacy-policy/`} class="underline underline-offset-2">{f.consentLink}</a></p>
  </div>
  <div data-done class="hidden py-6 text-center" role="status">
    <p class="display text-2xl">{f.thanks}</p>
    <p class="mt-2 text-muted">{f.accepted}</p>
  </div>
</form>
