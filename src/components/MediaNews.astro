---
import NewsCard from './NewsCard.astro';
import { getNews } from '../lib/api';
const news = await getNews(3).catch(() => []);
---
<section class="container-x mt-24 md:mt-32">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h2 class="display h-section">Медиа</h2>
    <a href="/ru/news/" class="btn btn-ghost">Подписаться на новости</a>
  </div>
  <div class="mb-6 flex gap-2" role="tablist">
    <span class="chip chip-accent !bg-ink-2 px-4 py-2" role="tab" aria-selected="true">Новости</span>
    <a href="/ru/news/?tab=actions" class="chip px-4 py-2" role="tab" aria-selected="false">Акции</a>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {news.map((n) => <NewsCard n={n} />)}
    <a href="/ru/news/" class="card relative flex min-h-[240px] flex-col justify-between overflow-hidden p-5">
      <span class="text-lg">Больше новостей</span>
      <svg class="absolute inset-0 size-full text-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0L100 100M100 0L0 100" stroke="currentColor" stroke-width=".3" /></svg>
      <span class="btn btn-ghost relative self-start">Все новости</span>
    </a>
  </div>
</section>
