---
/**
 * Живой чат с ИИ-помощником Доми. Кнопка появляется, только если чат
 * включён в админке и задан ключ (проверяем запросом, т.к. страницы кэшируются).
 */
import Domi from './Domi.astro';
import { site } from '../lib/site';
import { CHAT_UI } from '../lib/chatI18n';
const lang = Astro.locals.lang ?? 'ru';
const u = CHAT_UI[lang];
const wa = site.phones[0].href + '?text=' + encodeURIComponent(u.waText);
const clientText = { lang, typing: u.typing, unavailable: u.unavailable, hint: u.hint('{name}') };
---
<div data-chat hidden class="chat-root" data-chat-t={JSON.stringify(clientText)}>
  <div data-chat-hint class="chat-hint" hidden>
    <button type="button" data-chat-hint-close class="chat-hint-x" aria-label={u.hintClose}>×</button>
    <span data-chat-hint-text>{u.hint('Доми')}</span>
  </div>
  <button type="button" data-chat-open class="chat-fab" aria-haspopup="dialog" aria-controls="chat-panel" aria-expanded="false" aria-label={u.open}>
    <Domi size={104} animated />
  </button>

  <section id="chat-panel" data-chat-panel class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <header class="chat-head">
      <span class="chat-avatar"><Domi size={44} /></span>
      <span class="min-w-0 flex-1">
        <span id="chat-title" data-chat-name class="display block text-lg leading-tight">Доми</span>
        <span class="block text-xs text-white/70">{u.subtitle}</span>
      </span>
      <button type="button" data-chat-reset class="chat-icon" title={u.reset} aria-label={u.reset}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4" /></svg>
      </button>
      <button type="button" data-chat-close class="chat-icon" aria-label={u.close}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div data-chat-log class="chat-log" aria-live="polite"></div>

    <div data-chat-suggest class="chat-suggest">
      {u.suggest.map((q) => <button type="button" class="chip">{q}</button>)}
    </div>

    <form data-chat-form class="chat-form">
      <label for="chat-input" class="sr-only">{u.message}</label>
      <textarea id="chat-input" data-chat-input rows="1" maxlength="2000" placeholder={u.placeholder} class="chat-input"></textarea>
      <button type="submit" data-chat-send class="chat-send" aria-label={u.send}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z" /></svg>
      </button>
    </form>
    <div class="chat-foot">
      <a href={wa} target="_blank" rel="noopener" class="chat-manager">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-.9.2-3-.6-2.6-1-4.2-3.7-4.3-3.9-.1-.2-1-1.4-1-2.6s.6-1.9.9-2.1c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.1.1.7-.1 1.3z" /></svg>
        {u.manager}
      </a>
      <span class="text-[11px] text-muted">{u.disclaimer}</span>
    </div>
  </section>
</div>

<style is:global>
  .chat-root { position: fixed; right: 20px; bottom: 20px; z-index: 60; font-family: var(--font-sans); }
  /* Доми без подложки: стоит над страницей, под ним мягкая тень. */
  .chat-fab { position: relative; display: block; width: 104px; height: 112px; padding: 0; background: none; border: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .chat-fab .domi { filter: drop-shadow(0 6px 10px #2a1d6b33); }
  .chat-fab:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; border-radius: 24px; }
  .chat-fab::before { content: ''; position: absolute; left: 50%; bottom: 4px; width: 56px; height: 9px; margin-left: -28px; border-radius: 50%; background: #2a1d6b; opacity: .18; filter: blur(3px); }
    .chat-root.is-open .chat-fab, .chat-root.is-open .chat-hint { display: none; }

  .chat-hint { position: absolute; right: 14px; bottom: 118px; width: max-content; max-width: 240px; padding: 12px 30px 12px 14px; border-radius: 18px 18px 4px 18px; background: #fff; box-shadow: var(--shadow-card); font-size: 14px; line-height: 1.35; color: var(--color-ink); animation: chat-pop .35s cubic-bezier(.2,.9,.3,1.3); cursor: pointer; }
  .chat-hint-x { position: absolute; right: 6px; top: 4px; width: 22px; height: 22px; border-radius: 999px; color: var(--color-muted); font-size: 18px; line-height: 1; }
  @keyframes chat-pop { from { opacity: 0; transform: translateY(8px) scale(.9); } }

  .chat-panel { position: fixed; right: 20px; bottom: 20px; width: min(400px, calc(100vw - 40px)); height: min(640px, calc(100dvh - 40px)); display: flex; flex-direction: column; overflow: hidden; border-radius: 24px; background: var(--color-page); box-shadow: 0 30px 80px #0907143d; animation: chat-pop .25s ease-out; }
  .chat-panel[hidden] { display: none; }
  @media (max-width: 560px) { .chat-panel { inset: 0; width: 100%; height: 100dvh; border-radius: 0; } .chat-root { right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); } .chat-fab { width: 76px; height: 82px; } .chat-fab .domi { --domi: 76px; } .chat-hint { bottom: 88px; } }

  .chat-head { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 16px; color: #fff; background: linear-gradient(120deg, #090714, #2a1d6b 60%, #754be9); }
  .chat-avatar { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 999px; background: #ffffff; }
  .chat-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: #fff; }
  .chat-icon:hover { background: #ffffff1f; }

  .chat-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; overscroll-behavior: contain; }
  .chat-msg { flex-shrink: 0; max-width: 88%; padding: 10px 14px; border-radius: 18px; font-size: 14.5px; line-height: 1.45; overflow-wrap: anywhere; }
  .chat-msg p { margin: 0 0 6px; } .chat-msg p:last-child { margin: 0; }
  .chat-msg ul { margin: 4px 0 6px 18px; list-style: disc; }
  .chat-msg a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
  .chat-bot { align-self: flex-start; background: #fff; border-bottom-left-radius: 6px; box-shadow: 0 2px 10px #0907140a; }
  .chat-user { align-self: flex-end; background: var(--color-accent); color: #fff; border-bottom-right-radius: 6px; white-space: pre-wrap; }
  .chat-err { align-self: center; font-size: 13px; color: #b42318; text-align: center; }
  .chat-typing { display: inline-flex; gap: 4px; } .chat-typing i { width: 7px; height: 7px; border-radius: 99px; background: var(--color-muted); animation: chat-dot 1s infinite; } .chat-typing i:nth-child(2) { animation-delay: .15s; } .chat-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes chat-dot { 0%, 100% { opacity: .3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }

  .chat-cards { flex-shrink: 0; display: flex; gap: 10px; overflow-x: auto; margin: 2px -16px; padding: 2px 16px 6px; scrollbar-width: thin; }
  .chat-card { flex: 0 0 200px; display: flex; flex-direction: column; overflow: hidden; border-radius: 16px; background: #fff; border: 1px solid var(--color-line); transition: transform .2s; }
  .chat-card:hover { transform: translateY(-2px); }
  .chat-card img, .chat-card .ph { display: block; width: 100%; aspect-ratio: 4/3; object-fit: cover; background: linear-gradient(135deg, #e8e6f7, #d9dde4); }
  .chat-card b { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; padding: 8px 10px 0; font-family: var(--font-display); font-weight: 500; font-size: 14px; line-height: 1.15; }
  .chat-card small { display: block; padding: 3px 10px 0; font-size: 12px; color: var(--color-muted); }
  .chat-card span { display: block; padding: 6px 10px 10px; font-weight: 600; font-size: 14px; }
  .chat-card.prive b, .chat-card.prive span { color: #a78062; }

  .chat-suggest { display: flex; gap: 8px; overflow-x: auto; padding: 0 16px 10px; scrollbar-width: none; }
  .chat-suggest .chip { cursor: pointer; } .chat-suggest .chip:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .chat-suggest[hidden] { display: none; }
  .chat-form { display: flex; align-items: flex-end; gap: 8px; margin: 0 12px; padding: 6px 6px 6px 16px; border-radius: 24px; background: #fff; border: 1px solid var(--color-line); }
  .chat-form:focus-within { border-color: var(--color-accent); }
  .chat-input { flex: 1; resize: none; max-height: 120px; padding: 8px 0; font-size: 15px; background: transparent; outline: none; }
  .chat-send { display: grid; place-items: center; flex: 0 0 40px; height: 40px; border-radius: 999px; color: #fff; background: linear-gradient(90deg, #8a5cff, var(--color-accent-2)); }
  .chat-send:disabled { opacity: .4; }
  .chat-foot { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 10px 12px 12px; }
  .chat-note { display: block; margin-top: 6px; font-size: 12px; color: var(--color-muted); }
  .chat-manager { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; color: #128c4b; }
  .chat-manager:hover { text-decoration: underline; }
</style>

<script>
  import { initChat } from '../scripts/chat';
  initChat();
</script>
