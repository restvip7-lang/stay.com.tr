---
interface Props { class?: string; withText?: boolean }
const { class: cls = 'h-7 w-auto', withText = false } = Astro.props;
---
<span class="inline-flex items-center gap-2.5">
  <svg class={cls} viewBox="0 0 30 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M12.717 12.722l2.54-2.54c3.662 3.639 6.52 6.537 10.181 10.176v7.207h-7.957l5.037-5.037-9.805-9.806h.004zM5.086 27.561v-7.208l7.212 7.208H5.086z" fill="currentColor"/>
    <path fill-rule="evenodd" clip-rule="evenodd" d="M14.887 25.063l-9.801-9.8H0L15.262 0 30.53 15.262h-5.09L15.257 5.082l-7.631 7.63 9.805 9.81-2.545 2.541z" fill="currentColor"/>
  </svg>
  {withText && <span class="font-display text-[15px] font-medium tracking-[-0.02em]">STAY PROPERTY</span>}
</span>
