---
/**
 * Каркас страницы: метатеги (title, description, canonical, robots, hreflang, OG/Twitter),
 * разметка организации и общий JSON-LD — всё в серверном HTML (ТЗ 2.2, 4.2, 9).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { HREFLANG, HTML_LANG, LANGS, OG_LOCALE, SITE, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
import { orgLd } from '../lib/ld';
import { overrideFor } from '../lib/seoConfig';

interface Props {
  title: string;
  description?: string;
  /** Путь или абсолютный адрес канонической страницы. По умолчанию — текущий путь без параметров. */
  canonical?: string;
  /** index — по умолчанию; noindex,follow — для служебных и тонких страниц. */
  robots?: 'index,follow' | 'noindex,follow' | 'noindex,nofollow';
  /** Адреса этой же страницы на других языках (только существующие переводы). */
  alternates?: Partial<Record<Lang, string>> | null;
  image?: string | null;
  ogType?: string;
  overlayHeader?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const lang = Astro.locals.lang ?? 'ru';
const d = t(lang);
const props = Astro.props;
const {
  canonical,
  alternates,
  image,
  ogType = 'website',
  overlayHeader = false,
  jsonLd,
} = Astro.props;
// Переопределения из админки (ТЗ 14) — для страницы без параметров.
const ov = Astro.url.search ? null : await overrideFor(Astro.url.pathname).catch(() => null);
const title = ov?.title ?? props.title;
const description = ov?.description ?? props.description ?? d.footer.company;
const robots = ov?.robots ?? props.robots ?? 'index,follow';
const abs = (p: string) => (p.startsWith('http') ? p : SITE + p);
const canonicalUrl = abs(canonical ?? Astro.url.pathname);
const fullTitle = title;
const alts = alternates ?? null;
// hreflang — только у индексируемых страниц и только между существующими переводами (ТЗ 4.2).
const hreflang = robots.startsWith('index') && alts && Object.keys(alts).length > 1 ? alts : null;
const xDefault = hreflang ? hreflang.en ?? hreflang.ru ?? Object.values(hreflang)[0] : null;
const ogImage = image ? abs(image) : `${SITE}/og-default.jpg`;
const lds = [orgLd(lang), ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
// Строки для клиентских скриптов (формы, календарь, избранное).
const clientDict = { form: d.form, loading: d.loading, showMore: d.showMore, filter: d.filter, linkCopied: lang === 'ru' ? 'Ссылка скопирована' : 'Link copied' };
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    {hreflang && LANGS.filter((l) => hreflang[l]).map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={abs(hreflang[l]!)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stay Property" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {hreflang && LANGS.filter((l) => l !== lang && hreflang[l]).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#090714" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(lds.length === 1 ? lds[0] : lds)} />
    <script type="application/json" id="i18n" set:html={JSON.stringify(clientDict)} />
  </head>
  <body id="top" class="min-h-dvh">
    <Header overlay={overlayHeader} alternates={alts} />
    <main class:list={[!overlayHeader && 'pt-16 xl:pt-[100px]']}>
      <slot />
    </main>
    <Footer />
    <ChatWidget />

    <dialog data-lead-dialog class="m-auto w-[min(520px,calc(100%-32px))] rounded-[var(--radius-big)] p-0 backdrop:bg-ink/60">
      <div class="relative p-6 md:p-10">
        <button type="button" data-lead-close class="absolute right-4 top-4 grid size-10 place-items-center rounded-full hover:bg-page" aria-label={d.close}><Icon name="close" /></button>
        <LeadForm context="modal" title={d.getOffer} subtitle={d.getOfferText} />
      </div>
    </dialog>

    <script>
      import { initLeadForms, initFavorites } from '../scripts/client';
      initLeadForms();
      initFavorites();
    </script>
  </body>
</html>
