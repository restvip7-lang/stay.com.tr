---
/** PRIVE — закрытые проекты Stay: слайдер, фильтр (режим PRIVE), проекты, о компании. Состав — из админки. */
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import CatalogFilter from '../../components/CatalogFilter.astro';
import ProjectsBlock from '../../components/ProjectsBlock.astro';
import CompanySpotlight from '../../components/CompanySpotlight.astro';
import SaleCard from '../../components/SaleCard.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { isLang } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { getHomeSections } from '../../lib/api';
import { getHomeConfig } from '../../lib/homeConfig';
import { getComplexes, filtered, parseFilters, noFilters, rangesOf } from '../../lib/catalog';
import { numL } from '../../lib/format';
import { allLangs } from '../../lib/page';

const lang = Astro.params.lang;
if (!isLang(lang)) return Astro.rewrite('/404');
const d = t(lang);
const [home, complexes, sections] = await Promise.all([getHomeConfig(), getComplexes(), getHomeSections()]);
const byCode = (c: string) => complexes.find((p) => p.code === c);
const cfg = home.prive;
const hero = cfg.hero.map(byCode).filter(Boolean) as typeof complexes;
const ordered = cfg.projects.map(byCode).filter((p) => p?.isPrivate) as typeof complexes;
const list = [...ordered, ...complexes.filter((p) => p.isPrivate && !ordered.includes(p))];
const turkeySale = { country: 'turkey', deal: 'sale' as const };
// Фильтр страницы: стоимость, комнаты, площадь (из адреса), всегда только PRIVE-лоты.
const sp = new URLSearchParams();
for (const k of ['price_from', 'price_to', 'rooms', 'area_from', 'area_to']) for (const v of Astro.url.searchParams.getAll(k)) sp.append(k, v);
const query = sp.toString();
sp.set('prive', '1');
const f = parseFilters(sp);
const all = await filtered(turkeySale, { ...noFilters(), prive: true });
const lots = query ? await filtered(turkeySale, f) : all;
const total = lots.length;
const SHOW = 12;
const ranges = rangesOf(all);
const catalogHref = `/${lang}/turkey/sale/?${sp}`;
const T = {
  ru: { title: 'PRIVE — закрытые проекты Stay Property', h1: 'PRIVE: закрытые проекты Stay Property', lead: 'Специальные условия и лоты, которых нет в открытой продаже.', choose: ['Выбрать', 'квартиру'], lots: 'Лоты PRIVE', all: 'Все лоты PRIVE в каталоге', none: 'По этим параметрам лотов нет — измените фильтр.' },
  en: { title: 'PRIVE — Stay Property private projects', h1: 'PRIVE: Stay Property private projects', lead: 'Special terms and units that are not on open sale.', choose: ['Choose', 'an apartment'], lots: 'PRIVE units', all: 'All PRIVE units in the catalogue', none: 'No units match these filters — try changing them.' },
  tr: { title: 'PRIVE — Stay Property özel projeleri', h1: 'PRIVE: Stay Property özel projeleri', lead: 'Stay Property PRIVE: açık satışta olmayan özel koşullar ve daireler.', choose: ['Daire', 'seçin'], lots: 'PRIVE daireler', all: 'Katalogdaki tüm PRIVE daireler', none: 'Bu kriterlere uygun daire yok — filtreyi değiştirin.' },
  de: { title: 'PRIVE — exklusive Projekte von Stay Property', h1: 'PRIVE: exklusive Projekte von Stay Property', lead: 'Sonderkonditionen und Einheiten, die nicht im offenen Verkauf sind.', choose: ['Wohnung', 'wählen'], lots: 'PRIVE-Einheiten', all: 'Alle PRIVE-Einheiten im Katalog', none: 'Keine Einheiten mit diesen Kriterien — ändern Sie den Filter.' },
  sr: { title: 'PRIVE — zatvoreni projekti Stay Property', h1: 'PRIVE: zatvoreni projekti Stay Property', lead: 'Posebni uslovi i jedinice kojih nema u otvorenoj prodaji.', choose: ['Izaberite', 'stan'], lots: 'PRIVE jedinice', all: 'Sve PRIVE jedinice u katalogu', none: 'Nema jedinica po ovim kriterijumima — promenite filter.' },
}[lang];
---
<Base title={T.title} description={T.lead} alternates={allLangs(`/${lang}/prive/`)} robots={query ? 'noindex,follow' : 'index,follow'} overlayHeader bodyClass="theme-prive mode-prive">
  <div class="prive-page">
    <HomeHero slides={hero} h1={T.h1} lead={T.lead} />
    <section class="container-x mt-10">
      <Breadcrumbs items={[{ label: d.home, href: `/${lang}/` }, { label: 'PRIVE' }]} />
    </section>
    <section class="container-x mt-10 md:mt-16">
      <!-- Заголовок в два тона, как «Выбрать квартиру» у образца. -->
      <h2 class="display h-section mb-8"><span class="text-muted">{T.choose[0]}</span> {T.choose[1]}</h2>
      <CatalogFilter cat={turkeySale} f={f} total={total} mode="prive" ranges={ranges} />
    </section>
    <ProjectsBlock title={d.hp.priveProjects} projects={list} visible={cfg.projectsVisible} prive />
    <section id="lots" class="container-x mt-20 scroll-mt-28 md:mt-28">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="display h-section">{T.lots} <span class="text-accent">{numL(lang, total)}</span></h2>
        {query && <a href={`/${lang}/prive/#lots`} class="text-sm text-muted underline-offset-4 hover:text-accent hover:underline">{d.filter.reset} ✕</a>}
      </div>
      {total > 0 ? (
        <>
          <ul class="results-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{lots.slice(0, SHOW).map((x) => <li><SaleCard x={x} /></li>)}</ul>
          {total > SHOW && <div class="mt-10 flex justify-center"><a href={catalogHref} class="btn btn-accent h-[52px] px-8">{T.all}: {numL(lang, total)}<Icon name="chevronRight" class="size-3.5" /></a></div>}
        </>
      ) : <div class="card p-10 text-center"><p class="text-[17px]">{T.none}</p></div>}
    </section>
    <CompanySpotlight company={sections.company} />
  </div>
</Base>
