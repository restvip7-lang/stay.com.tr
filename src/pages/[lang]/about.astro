---
/** О компании (ТЗ 3.5): кто мы, почему мы, отзывы, команда, заявка. */
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadSection from '../../components/LeadSection.astro';
import { isLang } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { ABOUT, ABOUT_RU_HTML, ABOUT_IMAGE, ABOUT_VIDEO, whyBlocks, TEAM, REVIEWS } from '../../content/company';
import { allLangs } from '../../lib/page';
import { sanitize } from '../../lib/sanitize';

const lang = Astro.params.lang;
if (!isLang(lang)) return Astro.rewrite('/404');
const d = t(lang);
const a = ABOUT[lang];
const why = whyBlocks(lang);
const url = `/${lang}/about/`;
---
<Base title={`${a.title} — ${d.footer.company}`} description={a.description} alternates={allLangs(url)} image={ABOUT_IMAGE}>
  <section class="container-x pt-6 md:pt-10">
    <Breadcrumbs items={[{ label: d.home, href: `/${lang}/` }, { label: d.pages.about }]} />
    <h1 class="display h-page mt-6 max-w-5xl">{a.title}</h1>
    <p class="mt-4 font-display text-xl tracking-[-0.01em] text-ink/70 md:text-2xl">{a.subtitle}</p>
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      {lang === 'ru'
        ? <div class="prose-stay text-[17px]" set:html={sanitize(ABOUT_RU_HTML)} />
        : <div class="prose-stay text-[17px]">{a.paragraphs.map((p) => <p>{p}</p>)}</div>}
      <div class="relative overflow-hidden rounded-[var(--radius-big)]">
        <Img src={ABOUT_IMAGE} alt="Stay Property" class="aspect-[4/3] w-full" priority />
        {ABOUT_VIDEO && <a href={ABOUT_VIDEO} target="_blank" rel="noopener" class="btn btn-ghost absolute bottom-4 left-4"><Icon name="play" class="size-4" />{a.video}</a>}
      </div>
    </div>
  </section>

  <section class="container-x mt-20 md:mt-28">
    <h2 class="display h-section mb-8">{a.why}</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {why.map((w, i) => (
        <article class="card overflow-hidden p-1">
          <div class="relative aspect-[16/10] overflow-hidden rounded-[16px]"><Img src={w.image} alt="" class="size-full" /><span class="chip absolute left-3 top-3">{i + 1}</span></div>
          <div class="p-5"><h3 class="text-xl font-medium tracking-[-0.01em]">{w.title}</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/80">{w.text}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="container-x mt-20 md:mt-28">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <h2 class="display h-section">{d.pages.reviews}</h2>
      <a href={`/${lang}/reviews/`} class="inline-flex items-center gap-1 font-medium text-accent hover:underline">{d.hp.allReviews}<Icon name="arrowRight" class="size-4" /></a>
    </div>
    <div class="grid gap-3 md:grid-cols-3">
      {REVIEWS.slice(0, 3).map((r) => (
        <figure class="card flex flex-col p-6">
          <figcaption class="text-sm text-muted"><span class="block text-lg font-medium text-ink">{r.name}</span>{r.country} · {r.year}</figcaption>
          <blockquote class="mt-4 line-clamp-[8] whitespace-pre-line text-[15px] leading-relaxed text-ink/80">{r.text}</blockquote>
        </figure>
      ))}
    </div>
  </section>

  <section class="container-x mt-20 md:mt-28">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <h2 class="display h-section">{d.pages.team}</h2>
      <a href={`/${lang}/team/`} class="inline-flex items-center gap-1 font-medium text-accent hover:underline">{d.pages.team}<Icon name="arrowRight" class="size-4" /></a>
    </div>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {TEAM.slice(0, 5).map((m) => (
        <li class="card relative p-2">
          <div class="aspect-square overflow-hidden rounded-[16px] bg-lavender-2"><Img src={m.photo} alt={m.name[lang]} class="size-full object-top" /></div>
          <a href={`/${lang}/team/${m.slug}/`} class="mt-3 block px-2 pb-2 font-medium after:absolute after:inset-0 hover:text-accent">{m.name[lang]}</a>
        </li>
      ))}
    </ul>
  </section>
  <LeadSection context="about" />
</Base>
