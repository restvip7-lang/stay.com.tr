---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadSection from '../../components/LeadSection.astro';
import services from '../../content/data/services.json';
import { sanitize } from '../../lib/sanitize';

const s = services.find((x) => x.slug === Astro.params.slug);
if (!s) return Astro.rewrite('/404');
const others = services.filter((x) => x.slug !== s.slug);
---
<Base title={s.seoTitle || s.title} description={s.seoDescription || s.title}>
  <section class="container-x pt-6 md:pt-10">
    <Breadcrumbs items={[{ label: 'Stay Property', href: '/' }, { label: 'Услуги', href: '/uslugi/' }, { label: s.title }]} />
    <h1 class="display h-page mt-8 max-w-5xl">{s.title}</h1>
  </section>
  {s.image && <div class="container-x mt-10"><div class="overflow-hidden rounded-[var(--radius-big)]"><Img src={s.image} alt={s.title} class="aspect-[21/8] w-full" loading="eager" /></div></div>}
  <section class="container-x mt-12 grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      {s.html && <div class="prose-stay text-[17px]" set:html={sanitize(s.html)} />}
      {s.sections.map((sec) => (
        <div class="mt-12">
          {sec.title && <h2 class="display mb-6 text-[clamp(24px,2.6vw,34px)]">{sec.title}</h2>}
          {sec.steps.length > 0 && (
            <ol class="grid gap-3 sm:grid-cols-2">
              {sec.steps.map((st, i) => (
                <li class="card flex gap-4 p-5"><span class="grid size-9 shrink-0 place-items-center rounded-full bg-lavender-2 font-medium text-accent">{i + 1}</span><span class="text-[15px] leading-relaxed">{st}</span></li>
              ))}
            </ol>
          )}
          {sec.html && <div class="prose-stay" set:html={sanitize(sec.html)} />}
        </div>
      ))}
    </div>
    <aside class="space-y-3 lg:sticky lg:top-28 lg:self-start">
      <div class="card p-6">
        <p class="font-display text-xl font-medium tracking-[-0.02em]">Нужна консультация?</p>
        <p class="mt-2 text-sm text-muted">Расскажем об условиях и подберём объект под вашу задачу.</p>
        <a href="#lead" class="btn btn-accent mt-5 w-full">Оставить заявку</a>
      </div>
      <nav class="card p-6" aria-label="Другие услуги">
        <p class="mb-3 text-sm text-muted">Другие услуги</p>
        <ul class="space-y-2">{others.map((o) => <li><a href={`/uslugi/${o.slug}/`} class="hover:text-accent">{o.title}</a></li>)}</ul>
      </nav>
    </aside>
  </section>
  <LeadSection context={`service-${s.slug}`} />
</Base>
