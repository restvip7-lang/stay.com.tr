---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import services from '../../content/data/services.json';
---
<Base title="Услуги" description="Услуги Stay Property: гражданство и ВНЖ Турции, информационные туры, онлайн-просмотр и покупка, эксклюзивная продажа, Trade-in.">
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page">Услуги</h1>
    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a href={`/uslugi/${s.slug}/`} class="group card overflow-hidden p-1">
          <span class="block aspect-[16/10] overflow-hidden rounded-[16px]"><Img src={s.image} alt="" class="size-full transition-transform duration-700 group-hover:scale-[1.03]" /></span>
          <span class="block p-4 text-lg font-medium tracking-[-0.02em] group-hover:text-accent">{s.title}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
