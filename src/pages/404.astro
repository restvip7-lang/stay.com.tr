---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="Страница не найдена">
  <section class="container-x pt-16 text-center md:pt-24">
    <p class="display text-[120px] leading-none text-accent">404</p>
    <h1 class="display mt-4 text-3xl">Такой страницы нет</h1>
    <p class="mt-3 text-muted">Возможно, объект уже продан или ссылка устарела.</p>
    <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn btn-ghost">На главную</a><a href="/sale/" class="btn btn-accent">В каталог</a></div>
  </section>
</Base>
