---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import LeadSection from '../components/LeadSection.astro';
import about from '../content/data/about.json';
import { getHomeSections } from '../lib/api';
import { sanitize } from '../lib/sanitize';

const sections = await getHomeSections().catch(() => null);
const metrics = sections?.company.metrics ?? [];
const team = about.team.map((t: Record<string, string>) => ({
  name: t.name,
  photo: t.photo,
  phone: t['Телефон'] && !t['Телефон'].startsWith('http') ? t['Телефон'] : '',
  whatsapp: t.whatsapp,
  email: t['E-mail'],
  langs: t['Языки'],
}));
---
<Base title="О компании" description="Stay Property — агентство недвижимости полного цикла и застройщик в Аланье. С 2017 года, 24 собственных проекта.">
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page max-w-5xl">{about.title.split('\n')[0]}</h1>
    {about.title.split('\n')[1] && <p class="mt-4 font-display text-xl tracking-[-0.02em] text-ink/70 md:text-2xl">{about.title.split('\n')[1]}</p>}
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div class="prose-stay text-[17px]" set:html={sanitize(about.html)} />
      <div class="relative overflow-hidden rounded-[var(--radius-big)]">
        <Img src={about.image} alt="Stay Property" class="aspect-[4/3] w-full" />
        {about.video && <a href={about.video} target="_blank" rel="noopener" class="btn btn-ghost absolute bottom-4 left-4"><Icon name="play" class="size-4" />Видео о компании</a>}
      </div>
    </div>
    {metrics.length > 0 && (
      <dl class="mt-16 grid gap-6 sm:grid-cols-3">
        {metrics.map((m) => <div class="card p-6"><dd class="display text-[64px]">{m.value}</dd><dt class="mt-2 text-muted">{m.label}</dt></div>)}
      </dl>
    )}
  </section>

  <section class="container-x mt-20 md:mt-28">
    <h2 class="display h-section mb-8">{about.whyTitle.replace(/:$/, '')}</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {about.why.map((w, i) => (
        <article class="card overflow-hidden p-1">
          <div class="relative aspect-[16/10] overflow-hidden rounded-[16px]"><Img src={w.image} alt="" class="size-full" /><span class="chip absolute left-3 top-3">{i + 1}</span></div>
          <div class="p-5"><h3 class="text-xl font-medium tracking-[-0.02em]">{w.title}</h3><div class="prose-stay mt-2 text-[15px]" set:html={sanitize(w.html)} /></div>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-20 md:mt-28" data-carousel>
    <div class="container-x mb-8 flex items-end justify-between gap-4">
      <h2 class="display h-section">Отзывы о нас</h2>
      <div class="flex gap-2">
        <button type="button" data-cprev class="grid size-12 place-items-center rounded-full bg-white shadow-sm hover:bg-lavender" aria-label="Назад"><Icon name="arrowLeft" /></button>
        <button type="button" data-cnext class="grid size-12 place-items-center rounded-full bg-white shadow-sm hover:bg-lavender" aria-label="Вперёд"><Icon name="arrowRight" /></button>
      </div>
    </div>
    <div class="scroll-x flex snap-x snap-mandatory gap-3 px-4 md:px-[max(40px,calc((100vw-1280px)/2))]" data-track>
      {about.reviews.map((r) => (
        <article class="card flex w-[86vw] shrink-0 snap-start flex-col p-6 sm:w-[420px]">
          <p class="text-sm text-muted">{r.country} · {r.year}</p>
          <p class="mt-1 text-lg font-medium">{r.name}</p>
          <p class="mt-4 line-clamp-[10] whitespace-pre-line text-[15px] leading-relaxed text-ink/80">{r.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-x mt-20 md:mt-28">
    <h2 class="display h-section mb-8">Наши менеджеры</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((t) => (
        <article class="card flex gap-4 p-4">
          <div class="size-24 shrink-0 overflow-hidden rounded-2xl bg-lavender-2"><Img src={t.photo} alt={t.name} class="size-full object-top" /></div>
          <div class="min-w-0 text-[14px]">
            <p class="text-base font-medium">{t.name}</p>
            {t.langs && <p class="mt-1 text-muted">{t.langs}</p>}
            <div class="mt-2 space-y-1">
              {t.phone && <a class="block hover:text-accent" href={`tel:${t.phone.replace(/[^\d+]/g, '')}`}>{t.phone}</a>}
              {t.email && <a class="block truncate hover:text-accent" href={`mailto:${t.email}`}>{t.email}</a>}
              {t.whatsapp && <a class="inline-flex items-center gap-1 text-accent" href={t.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" class="size-4" />WhatsApp</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <LeadSection context="about" />
</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
    const t = c.querySelector<HTMLElement>('[data-track]')!;
    const step = () => (t.firstElementChild as HTMLElement)?.offsetWidth + 12;
    c.querySelector('[data-cnext]')?.addEventListener('click', () => t.scrollBy({ left: step(), behavior: 'smooth' }));
    c.querySelector('[data-cprev]')?.addEventListener('click', () => t.scrollBy({ left: -step(), behavior: 'smooth' }));
  });
</script>
