---
import Base from '../../layouts/Base.astro';
import ProjectsBlock from '../../components/ProjectsBlock.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/api';
import home from '../../content/data/home.json';

const all = await getProjects();
const own = home.projects.map((c) => all.find((p) => p.code === c)).filter(Boolean) as typeof all;
const ownCodes = new Set(own.map((p) => p.code));
const partners = all.filter((p) => !ownCodes.has(p.code)).sort((a, b) => (a.priceFrom ?? Infinity) - (b.priceFrom ?? Infinity));
---
<Base title="Жилые комплексы и новостройки" description="Собственные проекты Stay Property и новостройки партнёров в Аланье: цены, планировки, расположение на карте.">
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page">Проекты</h1>
    <p class="mt-6 max-w-2xl text-lg text-ink/70">Собственные жилые комплексы Stay Property и новостройки партнёров. Выберите проект — покажем планировки, цены и условия рассрочки.</p>
  </section>
  <ProjectsBlock title="STAY Projects" projects={own} visible={own.length} />
  {partners.length > 0 && (
    <section class="container-x mt-20 md:mt-28">
      <h2 class="display h-section mb-8">Новостройки партнёров</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{partners.map((p) => <ProjectCard p={p} />)}</div>
    </section>
  )}
</Base>
