---
import Base from '../../../layouts/Base.astro';
import NewsCard from '../../../components/NewsCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getNews } from '../../../lib/api';

const all = await getNews();
const per = 12;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const pages = Math.max(1, Math.ceil(all.length / per));
const items = all.slice((page - 1) * per, page * per);
---
<Base title="Новости" description="Новости рынка недвижимости Турции, Северного Кипра и ОАЭ: ВНЖ, гражданство, законы, цены — от Stay Property.">
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page">Новости</h1>
    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{items.map((n) => <NewsCard n={n} />)}</div>
    <Pagination page={page} pages={pages} url={Astro.url} />
  </section>
</Base>
