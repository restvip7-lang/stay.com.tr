---
import '../../styles/global.css';
import { adminEnabled, isAdmin } from '../../lib/adminAuth';
import { getHomeConfig, storageReady } from '../../lib/homeConfig';
import { getProjects } from '../../lib/api';
import { ANTHROPIC_MODELS, DEFAULT_MODELS, chatAdminView, getChatSettings } from '../../lib/chatConfig';
import { getSeoConfig } from '../../lib/seoConfig';
import { categoryCounts } from '../../lib/sitemap';
import { catUrl, INDEX_MIN } from '../../lib/catalog';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
const enabled = adminEnabled();
const authed = isAdmin(Astro.cookies);
const error = Astro.url.searchParams.has('error');

let data: any = null;
let thin: { url: string; n: number }[] = [];
let seoText = { redirects: '', overrides: '{}' };
if (authed) {
  const [seo, counts] = await Promise.all([getSeoConfig(), categoryCounts()]);
  // Отчёт «категории вне индекса» (ТЗ 14): 1–2 объекта — noindex по порогу.
  thin = counts.filter((c) => c.n < INDEX_MIN).map((c) => ({ url: catUrl('ru', c.cat), n: c.n })).sort((a, b) => a.url.localeCompare(b.url));
  seoText = {
    redirects: seo.redirects.map((r) => (r.status === 410 ? `${r.from} 410` : `${r.from} ${r.to}`)).join('\n'),
    overrides: JSON.stringify(seo.overrides, null, 2),
  };
  const [home, projects, chat] = await Promise.all([getHomeConfig(), getProjects(), getChatSettings()]);
  data = {
    home,
    chat: chatAdminView(chat),
    storage: storageReady(),
    projects: projects.map((p) => ({ code: p.code, title: p.title, place: [p.city, p.area].filter(Boolean).join(', '), image: p.image, price: p.priceFromLabel ?? '' })),
  };
}
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Админка — Stay Property</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line bg-white">
      <div class="container-x flex h-16 items-center justify-between">
        <a href="/" class="font-medium">Stay Property · <span class="text-muted">админка</span></a>
        {authed && (
          <form method="post" action="/api/admin/login"><button name="logout" value="1" class="text-sm text-muted hover:text-ink">Выйти</button></form>
        )}
      </div>
    </header>

    {!enabled && (
      <main class="container-x py-16">
        <div class="card max-w-xl p-8">
          <h1 class="display text-3xl">Админка выключена</h1>
          <p class="mt-4 text-ink-2">Чтобы включить, задайте пароль (не короче 8 символов) в переменной <code>ADMIN_PASSWORD</code> в настройках проекта на Vercel и пересоберите сайт.</p>
        </div>
      </main>
    )}

    {enabled && !authed && (
      <main class="container-x grid place-items-center py-24">
        <form method="post" action="/api/admin/login" class="card w-full max-w-sm p-8">
          <h1 class="display text-3xl">Вход</h1>
          <label class="label mt-6" for="pw">Пароль</label>
          <input id="pw" name="password" type="password" required autocomplete="current-password" class="field" autofocus />
          {error && <p class="mt-3 text-sm text-red-600">Неверный пароль</p>}
          <button class="btn btn-dark mt-6 w-full">Войти</button>
        </form>
      </main>
    )}

    {authed && (
      <main class="container-x py-10" id="app">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h1 class="display text-4xl">Главная страница</h1>
            <p class="mt-2 text-muted">Какие проекты Stay показывать на главной, в каком порядке и какие крутить в первом экране.</p>
          </div>
          <div class="flex items-center gap-3">
            <span data-status class="text-sm text-muted"></span>
            <a href="/" target="_blank" class="btn btn-ghost">Открыть сайт</a>
            <button data-save class="btn btn-accent">Сохранить</button>
          </div>
        </div>
        {!data.storage && <p class="mt-4 rounded-2xl bg-peach px-4 py-3 text-sm">Хранилище не подключено: изменения сохранить нельзя (так бывает при локальном запуске).</p>}

        <section class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
          <div class="card p-6">
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-xl font-medium">На главной</h2>
              <label class="flex items-center gap-2 text-sm text-muted">Сразу видно <input data-visible type="number" min="1" max="50" class="field h-10 w-20 px-3" /></label>
            </div>
            <label class="label mt-4">Заголовок блока</label>
            <input data-title class="field" />
            <p class="mt-4 text-sm text-muted">★ — проект в слайдере первого экрана. Стрелками меняется порядок.</p>
            <ol data-selected class="mt-3 grid gap-2"></ol>
          </div>
          <div class="card p-6">
            <h2 class="text-xl font-medium">Все проекты</h2>
            <input data-search class="field mt-4" placeholder="Поиск по названию или району" />
            <ul data-all class="mt-3 grid max-h-[70vh] gap-2 overflow-auto pr-1"></ul>
          </div>
        </section>

        <section class="card mt-6 p-6">
          <h2 class="text-xl font-medium">Способы покупки</h2>
          <div data-variants class="mt-4 grid gap-4 md:grid-cols-3"></div>
          <h3 class="mt-6 font-medium">Купить онлайн</h3>
          <div class="mt-3 grid gap-4 md:grid-cols-2">
            <div><label class="label">Заголовок</label><input data-online="title" class="field" /></div>
            <div><label class="label">Текст</label><input data-online="text" class="field" /></div>
          </div>
        </section>

        <section class="card mt-6 p-6" id="objects">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-medium">Объекты</h2>
              <p class="mt-1 max-w-3xl text-sm text-muted">Отметки поверх базы, сама база не меняется. Ярлык видно на карточке и странице объекта; «Продано» — плашка, объект остаётся на сайте и уходит в конец выдачи. «Закрепить» — первым в каталоге и в блоке новинок на главной. «Скрыть» — объект пропадает с сайта, его страница отдаёт 410. Сохраняется сразу, на сайте — в течение минуты.</p>
            </div>
            <span data-o-count class="text-sm text-muted"></span>
          </div>
          <input data-o-search class="field mt-5" placeholder="Поиск: код объекта, id, название, район. Пусто — объекты с отметками" />
          <ul data-o-list class="mt-3 grid max-h-[75vh] gap-2 overflow-auto pr-1"></ul>
        </section>

        <section class="card mt-6 p-6" id="chat">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-medium">ИИ-помощник в чате</h2>
              <p class="mt-1 text-sm text-muted">Черепаха-каретта в углу сайта. Подбирает объекты из нашей базы и отвечает на вопросы. Нужен ключ Claude или GPT.</p>
            </div>
            <label class="flex items-center gap-2 font-medium"><input type="checkbox" data-c="enabled" class="size-5 accent-[#754be9]" /> Показывать на сайте</label>
          </div>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            <div>
              <label class="label" for="c-provider">Провайдер</label>
              <select id="c-provider" data-c="provider" class="field"><option value="anthropic">Claude (Anthropic)</option><option value="openai">GPT (OpenAI)</option></select>
            </div>
            <div>
              <label class="label" for="c-model">Модель</label>
              <select id="c-model" data-model-a class="field">{ANTHROPIC_MODELS.map((m) => <option value={m.id}>{m.label}</option>)}</select>
              <input id="c-model-o" data-model-o class="field hidden" placeholder={DEFAULT_MODELS.openai} />
            </div>
            <div>
              <label class="label" for="c-key">API-ключ</label>
              <input id="c-key" data-key type="password" autocomplete="off" class="field" />
              <p data-key-state class="mt-2 text-xs text-muted"></p>
            </div>
            <div><label class="label" for="c-name">Имя талисмана</label><input id="c-name" data-c="name" class="field" /></div>
            <div class="md:col-span-2"><label class="label" for="c-greet">Приветствие</label><input id="c-greet" data-c="greeting" class="field" /></div>
            <div class="md:col-span-3">
              <label class="label" for="c-notes">Что ещё знать помощнику (акции, условия, на чём делать акцент)</label>
              <textarea id="c-notes" data-c="notes" rows="4" class="field h-auto rounded-2xl py-3"></textarea>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button data-chat-save class="btn btn-accent">Сохранить помощника</button>
            <button data-chat-test class="btn btn-ghost">Проверить</button>
            <button data-chat-delkey class="btn btn-ghost">Удалить ключ</button>
            <span data-chat-status class="text-sm text-muted"></span>
          </div>
          <pre data-chat-out class="mt-4 hidden whitespace-pre-wrap rounded-2xl bg-page p-4 text-sm"></pre>
        </section>

        <section class="card mt-6 p-6" id="seo">
          <h2 class="text-xl font-medium">SEO</h2>
          <p class="mt-1 text-sm text-muted">Переопределения мета-тегов и текстов для любой страницы на любом языке, редиректы 301 и снятые страницы (410). Сохранение сбрасывает кэш сайта.</p>
          <div class="mt-5 grid gap-6 lg:grid-cols-2">
            <div>
              <label class="label" for="seo-redirects">Редиректы — по одному в строке: «откуда куда» или «откуда 410»</label>
              <textarea id="seo-redirects" data-seo-redirects rows="12" class="field h-auto py-3 font-mono text-[13px]" placeholder="/ru/old-page/ /ru/turkey/alanya/sale/&#10;/ru/removed-page/ 410" set:text={seoText.redirects}></textarea>
              <p class="mt-2 text-xs text-muted">Цепочки и циклы не сохранятся — укажите сразу конечный адрес.</p>
            </div>
            <div>
              <label class="label" for="seo-overrides">Переопределения страниц (JSON): адрес → title, description, h1, text (HTML), robots</label>
              <textarea id="seo-overrides" data-seo-overrides rows="12" class="field h-auto py-3 font-mono text-[13px]" set:text={seoText.overrides}></textarea>
              <p class="mt-2 text-xs text-muted">Пример: {'{"/ru/turkey/alanya/sale/": {"title": "…", "h1": "…", "robots": "noindex,follow"}}'}. H1 и текст применяются на посадочных каталога, title, description и robots — на любой странице.</p>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button data-seo-save class="btn btn-accent">Сохранить SEO</button>
            <span data-seo-status class="text-sm text-muted"></span>
          </div>
          <details class="mt-8">
            <summary class="cursor-pointer font-medium">Категории вне индекса по порогу: {thin.length} (1–2 объекта, порог — {INDEX_MIN})</summary>
            <ul class="mt-3 max-h-96 overflow-auto text-sm">{thin.map((x) => <li class="flex justify-between gap-4 border-t border-line py-1.5"><a href={x.url} target="_blank" class="truncate hover:text-accent">{x.url}</a><span class="text-muted">{x.n}</span></li>)}</ul>
          </details>
        </section>
      </main>
    )}

    <script>
      const seoBtn = document.querySelector<HTMLButtonElement>('[data-seo-save]');
      seoBtn?.addEventListener('click', async () => {
        const st = document.querySelector<HTMLElement>('[data-seo-status]')!;
        const lines = (document.querySelector<HTMLTextAreaElement>('[data-seo-redirects]')!.value || '').split('\n').map((l) => l.trim()).filter(Boolean);
        const redirects = lines.map((l) => { const [from, to] = l.split(/\s+/); return to === '410' ? { from, to: '', status: 410 } : { from, to, status: 301 }; });
        let overrides = {};
        try { overrides = JSON.parse(document.querySelector<HTMLTextAreaElement>('[data-seo-overrides]')!.value || '{}'); } catch { st.textContent = 'Ошибка: переопределения — не JSON'; return; }
        st.textContent = 'Сохраняю…';
        const res = await fetch('/api/admin/seo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ redirects, overrides }) });
        const r = await res.json().catch(() => ({ ok: false, error: res.statusText }));
        st.textContent = r.ok ? `Сохранено: ${r.saved.redirects.length} редиректов, ${Object.keys(r.saved.overrides).length} переопределений.` : 'Ошибка: ' + (r.error || res.status);
      });
    </script>
    {authed && <script type="application/json" id="admin-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />}
    <script>
      const el = document.getElementById('admin-data');
      if (el) {
        const { home, projects } = JSON.parse(el.textContent || '{}');
        const byCode = new Map(projects.map((p: any) => [p.code, p]));
        let selected: string[] = home.projects.filter((c: string) => byCode.has(c));
        const hero = new Set<string>(home.hero.map((h: any) => h.project));
        const $ = (s: string) => document.querySelector(s) as HTMLElement;
        const status = $('[data-status]');
        let dirty = false;
        const touch = () => { dirty = true; status.textContent = 'Есть несохранённые изменения'; };
        const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
        const thumb = (p: any) => p.image ? `<img src="${esc(p.image)}" alt="" class="size-12 shrink-0 rounded-xl object-cover bg-lavender-2" loading="lazy">` : '<span class="size-12 shrink-0 rounded-xl bg-lavender-2"></span>';
        const btn = 'grid size-9 place-items-center rounded-full border border-line hover:border-ink disabled:opacity-30';

        function render() {
          $('[data-selected]').innerHTML = selected.map((c, i) => {
            const p: any = byCode.get(c);
            return `<li class="flex items-center gap-3 rounded-2xl border border-line p-2">
              <span class="w-5 text-center text-sm text-muted">${i + 1}</span>${thumb(p)}
              <span class="min-w-0 flex-1"><span class="block truncate font-medium">${esc(p.title)}</span><span class="block truncate text-sm text-muted">${esc(p.place)}</span></span>
              <button data-hero="${c}" title="В слайдере" class="${btn} ${hero.has(c) ? 'bg-accent text-white border-accent' : ''}">★</button>
              <button data-up="${i}" title="Выше" class="${btn}" ${i === 0 ? 'disabled' : ''}>↑</button>
              <button data-down="${i}" title="Ниже" class="${btn}" ${i === selected.length - 1 ? 'disabled' : ''}>↓</button>
              <button data-remove="${c}" title="Убрать" class="${btn}">✕</button></li>`;
          }).join('') || '<li class="text-muted">Пока пусто — добавьте проекты справа.</li>';
          const q = ($('[data-search]') as HTMLInputElement).value.trim().toLowerCase();
          $('[data-all]').innerHTML = projects
            .filter((p: any) => !selected.includes(p.code) && (!q || (p.title + ' ' + p.place).toLowerCase().includes(q)))
            .map((p: any) => `<li class="flex items-center gap-3 rounded-2xl border border-line p-2">${thumb(p)}
              <span class="min-w-0 flex-1"><span class="block truncate font-medium">${esc(p.title)}</span><span class="block truncate text-sm text-muted">${esc(p.place)}${p.price ? ' · ' + esc(p.price) : ''}</span></span>
              <button data-add="${p.code}" class="${btn}" title="Добавить на главную">+</button></li>`).join('');
        }

        document.addEventListener('click', (e) => {
          const t = (e.target as HTMLElement).closest('button');
          if (!t) return;
          const d = t.dataset;
          if (d.add) selected.push(d.add);
          else if (d.remove) { selected = selected.filter((c) => c !== d.remove); hero.delete(d.remove); }
          else if (d.hero) hero.has(d.hero) ? hero.delete(d.hero) : hero.add(d.hero);
          else if (d.up) { const i = +d.up; [selected[i - 1], selected[i]] = [selected[i], selected[i - 1]]; }
          else if (d.down) { const i = +d.down; [selected[i + 1], selected[i]] = [selected[i], selected[i + 1]]; }
          else return;
          touch();
          render();
        });
        $('[data-search]').addEventListener('input', render);

        const title = $('[data-title]') as HTMLInputElement;
        const visible = $('[data-visible]') as HTMLInputElement;
        title.value = home.projectsTitle ?? '';
        visible.value = String(home.projectsVisible ?? 5);
        [title, visible].forEach((i) => i.addEventListener('input', touch));

        const variants = home.buyVariants.map((v: any) => ({ ...v }));
        $('[data-variants]').innerHTML = variants.map((v: any, i: number) => `<div class="rounded-2xl border border-line p-4">
          <label class="label">Заголовок</label><input data-v="${i}" data-k="title" class="field" value="${esc(v.title)}">
          <label class="label mt-3">Текст</label><textarea data-v="${i}" data-k="text" rows="3" class="field h-auto rounded-2xl py-3">${esc(v.text)}</textarea></div>`).join('');
        $('[data-variants]').addEventListener('input', (e) => {
          const t = e.target as HTMLInputElement;
          variants[+t.dataset.v!][t.dataset.k!] = t.value;
          touch();
        });
        const online = { ...home.buyOnline };
        document.querySelectorAll<HTMLInputElement>('[data-online]').forEach((i) => {
          i.value = online[i.dataset.online!] ?? '';
          i.addEventListener('input', () => { online[i.dataset.online!] = i.value; touch(); });
        });

        $('[data-save]').addEventListener('click', async () => {
          status.textContent = 'Сохраняю…';
          const body = {
            ...home,
            projectsTitle: title.value.trim() || 'STAY Projects',
            projectsVisible: Number(visible.value) || 5,
            projects: selected,
            hero: selected.filter((c) => hero.has(c)).map((project) => ({ project })),
            buyVariants: variants,
            buyOnline: online,
          };
          const res = await fetch('/api/admin/home', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          const r = await res.json().catch(() => ({ ok: false, error: res.statusText }));
          dirty = !r.ok;
          status.textContent = r.ok ? 'Сохранено. Главная обновится в течение минуты.' : 'Ошибка: ' + (r.error || res.status);
        });
        window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });
        render();
      }
    </script>
    <script>
      const el2 = document.getElementById('admin-data');
      if (el2) {
        const { chat } = JSON.parse(el2.textContent || '{}');
        const q = (s: string) => document.querySelector(s) as HTMLInputElement;
        const st = q('[data-chat-status]');
        const out = q('[data-chat-out]') as unknown as HTMLElement;
        const prov = q('[data-c="provider"]');
        const ma = q('[data-model-a]'), mo = q('[data-model-o]');
        let state = chat;
        function fill(c: any) {
          state = c;
          (q('[data-c="enabled"]') as HTMLInputElement).checked = !!c.enabled;
          prov.value = c.provider;
          for (const k of ['name', 'greeting', 'notes']) q(`[data-c="${k}"]`).value = c[k] ?? '';
          syncModel(c.model);
          q('[data-key]').value = '';
          q('[data-key]').placeholder = c.apiKeyHint ? `сохранён ${c.apiKeyHint} — введите новый, чтобы заменить` : c.keyFromEnv ? 'задан в настройках Vercel' : 'вставьте ключ';
          q('[data-key-state]').textContent = c.hasKey ? 'Ключ есть. Хранится в зашифрованном виде, в браузер не отдаётся.' : 'Ключа нет — Каретта работает в демо-режиме: простой поиск по базе без ИИ.';
        }
        function syncModel(model?: string) {
          const o = prov.value === 'openai';
          ma.classList.toggle('hidden', o);
          mo.classList.toggle('hidden', !o);
          if (model) (o ? mo : ma).value = model;
          if (!o && !ma.value) (ma as unknown as HTMLSelectElement).selectedIndex = 0;
        }
        prov.addEventListener('change', () => syncModel(prov.value === state.provider ? state.model : prov.value === 'openai' ? 'gpt-4.1-mini' : 'claude-opus-5-5'));
        async function send(body: any) {
          const res = await fetch('/api/admin/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          return res.json().catch(() => ({ ok: false, error: res.statusText }));
        }
        q('[data-chat-save]').addEventListener('click', async () => {
          st.textContent = 'Сохраняю…';
          const o = prov.value === 'openai';
          const r = await send({
            enabled: (q('[data-c="enabled"]') as HTMLInputElement).checked,
            provider: prov.value,
            model: (o ? mo.value.trim() || 'gpt-4.1-mini' : ma.value),
            name: q('[data-c="name"]').value,
            greeting: q('[data-c="greeting"]').value,
            notes: q('[data-c="notes"]').value,
            apiKey: q('[data-key]').value.trim(),
          });
          if (r.ok) fill(r.saved);
          st.textContent = r.ok ? 'Сохранено. На сайте обновится в течение минуты.' : 'Ошибка: ' + r.error;
        });
        q('[data-chat-delkey]').addEventListener('click', async () => {
          if (!confirm('Удалить сохранённый ключ?')) return;
          const r = await send({ deleteKey: true });
          if (r.ok) fill(r.saved);
          st.textContent = r.ok ? 'Ключ удалён.' : 'Ошибка: ' + r.error;
        });
        q('[data-chat-test]').addEventListener('click', async () => {
          st.textContent = 'Спрашиваю помощника (сохранённые настройки)…';
          out.classList.add('hidden');
          const r = await send({ action: 'test' });
          st.textContent = r.ok ? `Работает, ответ за ${(r.ms / 1000).toFixed(1)} с, карточек: ${r.cards}` : 'Не работает: ' + r.error;
          if (r.ok) { out.textContent = r.text; out.classList.remove('hidden'); }
        });
        fill(chat);
      }
    </script>
    <script>
      const list = document.querySelector<HTMLElement>('[data-o-list]');
      if (list) {
        const LABELS: [string, string][] = [['', 'Без ярлыка'], ['sold', 'Продано'], ['reserved', 'Забронировано'], ['urgent', 'Срочно'], ['discount', 'Скидка'], ['new', 'Новинка']];
        const input = document.querySelector<HTMLInputElement>('[data-o-search]')!;
        const count = document.querySelector<HTMLElement>('[data-o-count]')!;
        const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
        const money = (n: number | null, deal: string) => (n ? '€' + n.toLocaleString('ru-RU') + (deal === 'rent' ? '/мес' : '') : 'по запросу');
        const btn = 'h-9 rounded-full border border-line px-3 text-sm hover:border-ink';
        const rows = new Map<string, any>();
        function rowHtml(x: any) {
          const m = x.mark || {};
          return `<li data-o-row="${esc(x.id)}" class="flex flex-wrap items-center gap-3 rounded-2xl border border-line p-2 ${m.hidden ? 'opacity-50' : ''}">
            ${x.image ? `<img src="${esc(x.image)}" alt="" class="size-12 shrink-0 rounded-xl object-cover bg-lavender-2" loading="lazy">` : '<span class="size-12 shrink-0 rounded-xl bg-lavender-2"></span>'}
            <span class="min-w-0 flex-1 basis-60"><a href="${esc(x.url)}" target="_blank" class="block truncate font-medium hover:text-accent">${esc(x.title)}</a>
              <span class="block truncate text-sm text-muted">${x.ref ? esc(x.ref) + ' · ' : ''}id ${esc(x.id)} · ${x.deal === 'rent' ? 'аренда' : 'продажа'} · ${esc(x.place)} · ${money(x.price, x.deal)}</span></span>
            <select data-o-label class="field h-9 w-auto py-0 text-sm">${LABELS.map(([v, t]) => `<option value="${v}" ${(m.label || '') === v ? 'selected' : ''}>${t}</option>`).join('')}</select>
            <button data-o-pin class="${btn} ${m.pinned ? 'bg-accent text-white border-accent' : ''}">${m.pinned ? 'Закреплён' : 'Закрепить'}</button>
            <button data-o-hide class="${btn} ${m.hidden ? 'bg-ink text-white border-ink' : ''}">${m.hidden ? 'Скрыт — показать' : 'Скрыть'}</button>
            <span data-o-st class="w-24 text-xs text-muted"></span></li>`;
        }
        let seq = 0;
        async function load() {
          const my = ++seq;
          const q = input.value.trim();
          count.textContent = 'Ищу…';
          const r = await fetch('/api/admin/objects?q=' + encodeURIComponent(q)).then((res) => res.json()).catch(() => null);
          if (my !== seq) return;
          if (!r) { count.textContent = 'Ошибка загрузки'; return; }
          rows.clear();
          r.items.forEach((x: any) => rows.set(String(x.id), x));
          count.textContent = q ? `Найдено: ${r.total}${r.total > r.items.length ? `, показаны первые ${r.items.length}` : ''}` : `С отметками: ${r.marked}`;
          list!.innerHTML = r.items.map(rowHtml).join('') || `<li class="text-muted">${q ? 'Ничего не нашлось.' : 'Отметок пока нет — найдите объект поиском.'}</li>`;
        }
        async function save(li: HTMLElement, mark: any) {
          const id = li.dataset.oRow!;
          const st = li.querySelector<HTMLElement>('[data-o-st]')!;
          st.textContent = 'Сохраняю…';
          const res = await fetch('/api/admin/objects', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, mark }) });
          const r = await res.json().catch(() => ({ ok: false, error: res.statusText }));
          if (!r.ok) { st.textContent = 'Ошибка: ' + (r.error || res.status); return; }
          const x = { ...rows.get(id), mark: r.mark };
          rows.set(id, x);
          const tmp = document.createElement('ul');
          tmp.innerHTML = rowHtml(x);
          const fresh = tmp.firstElementChild as HTMLElement;
          li.replaceWith(fresh);
          fresh.querySelector<HTMLElement>('[data-o-st]')!.textContent = 'Сохранено';
        }
        list.addEventListener('change', (e) => {
          const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-o-label]');
          if (!sel) return;
          const li = sel.closest<HTMLElement>('[data-o-row]')!;
          save(li, { ...rows.get(li.dataset.oRow!)?.mark, label: sel.value || undefined });
        });
        list.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('button');
          if (!b) return;
          const li = b.closest<HTMLElement>('[data-o-row]')!;
          const m = { ...rows.get(li.dataset.oRow!)?.mark };
          if (b.hasAttribute('data-o-pin')) m.pinned = !m.pinned;
          else if (b.hasAttribute('data-o-hide')) m.hidden = !m.hidden;
          else return;
          save(li, m);
        });
        let timer: number | undefined;
        input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(load, 300); });
        load();
      }
    </script>
  </body>
</html>
