---
import Base from '../layouts/Base.astro';
---
<Base title="Избранное" description="Объекты, которые вы отметили сердечком.">
  <section class="container-x pt-10 md:pt-16">
    <h1 class="display h-page">Избранное</h1>
    <div data-fav-list class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div data-fav-empty class="card mt-10 hidden p-10 text-center">
      <p class="display text-2xl">Пока пусто</p>
      <p class="mt-2 text-muted">Нажмите на сердечко у объекта в каталоге — он появится здесь. Список хранится в этом браузере.</p>
      <a href="/sale/" class="btn btn-accent mt-6">Перейти в каталог</a>
    </div>
  </section>
</Base>
<script>
  import { readFavs } from '../scripts/client';
  const list = document.querySelector<HTMLElement>('[data-fav-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-fav-empty]')!;
  const esc = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const render = () => {
    const favs = readFavs();
    empty.classList.toggle('hidden', favs.length > 0);
    list.innerHTML = favs.map((f) => `
      <article class="card relative flex flex-col p-2 shadow-[var(--shadow-card)]">
        <a href="${esc(f.url)}" class="block aspect-[4/3] overflow-hidden rounded-[16px] img-fallback">${f.image ? `<img src="${esc(f.image)}" alt="" class="size-full object-cover" loading="lazy">` : ''}</a>
        <button type="button" data-fav="${esc(f.id)}" data-fav-item='${esc(JSON.stringify(f))}' class="absolute right-4 top-4 grid size-10 place-items-center rounded-full bg-white/90 text-accent shadow" aria-label="Убрать из избранного"><svg class="size-5" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.7"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 1 1 12 6a5 5 0 1 1 7.5 6.6"/></svg></button>
        <div class="p-3"><a href="${esc(f.url)}" class="line-clamp-2 hover:text-accent">${esc(f.title)}</a><p class="mt-1 text-sm text-muted">${esc(f.meta)}</p><p class="mt-3 text-xl font-medium">${esc(f.price)}</p></div>
      </article>`).join('');
  };
  render();
  document.addEventListener('favorites:change', render);
</script>
