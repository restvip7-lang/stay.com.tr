# Настройки сайта на сервере. Скопируйте в /home/stay/stay.env и заполните (файл НЕ коммитить).
# Пароль админки /admin.
ADMIN_PASSWORD=
# Секрет для шифрования ключа ИИ-помощника в настройках (любая длинная случайная строка, не менять после запуска).
STAY_SECRET=
# Секреты вебхука сброса кэша (/api/revalidate) и ночного cron.
REVALIDATE_SECRET=
CRON_SECRET=
# Где сайт хранит настройки из админки и кэш картинок.
STAY_STORAGE=fs
STAY_DATA_DIR=/home/stay/data
# Источники данных.
STAY_API_BASE=https://dev.stayproperty.com
STAY_CONTENT_API=https://admin.stayproperty.com
# 1 — сайт закрыт от индексации, 0 — открыт.
STAY_NOINDEX=1
# Домены сайта через запятую (нужны при сборке).
STAY_DOMAINS=stay.com.tr,www.stay.com.tr
# Порт, на котором сайт слушает внутри сервера (снаружи — nginx).
HOST=127.0.0.1
PORT=4321
# Почта для кодов входа в админку (второй шаг после пароля). Без неё вход только по паролю.
# 465 — SSL, 587 — STARTTLS. Подойдёт ящик на Яндекс/Google/своём домене (пароль приложения).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Stay Admin <noreply@stay.com.tr>
